{%- assign _block = block.settings -%}

{%- render 'card-review',
  stars: _block.stars,
  content: _block.content,
  image: _block.image,
  author: _block.author,
  position: _block.position
-%}

{% schema %}
  {
    "name": "Review",
    "class": "swiper-slide",
    "settings": [
      {
        "type": "range",
        "id": "stars",
        "min": 1,
        "max": 5,
        "step": 1,
        "unit": "cnt",
        "label": "Stars count",
        "default": 5
      },
      {
        "type": "textarea",
        "id": "content",
        "label": "Review content",
        "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare."
      },
      {
        "type": "header",
        "content": "Author"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "author",
        "label": "Author name",
        "default": "Emily Johnson"
      },
      {
        "type": "text",
        "id": "position",
        "label": "Author position",
        "default": "Music Producer, Freelance"
      }
    ],
    "presets": [
      {
        "name": "Review",
        "settings": {}
      }
    ]
  }
{% endschema %}
