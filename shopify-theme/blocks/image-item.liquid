{%- liquid
  assign _block = block.settings
-%}

<div class="image-item">
  <div
    class="media media--transparent{% if _block.keep_aspect_ratio %} media--aspect-ratio{% endif %}"
    {%- unless _block.keep_aspect_ratio -%}
      style="padding-bottom: {{ _block.aspect_ratio }}%;"
    {%- endunless -%}
  >
    {%- liquid
      if _block.image != blank
        render 'image', image: _block.image
      else
        echo 'image' | placeholder_svg_tag: 'placeholder-svg'
      endif
    -%}
  </div><!-- /.media -->
</div><!-- /.image-item -->

{% schema %}
  {
    "name": "Image item",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "checkbox",
        "id": "keep_aspect_ratio",
        "label": "Keep original aspect ratio",
        "default": true
      },
      {
        "type": "range",
        "id": "aspect_ratio",
        "min": 20,
        "max": 200,
        "step": 2,
        "unit": "%",
        "label": "Aspect ratio",
        "info": "150% = 3:2; 100% = 1:1; 66% = 16:9",
        "default": 100
      },
    ],
    "presets": [
      {
        "name": "Image item",
        "settings": {}
      }
    ]
  }
{% endschema %}
