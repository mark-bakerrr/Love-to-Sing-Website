{%- assign _block = block.settings -%}

{%- style -%}
  #shopify-section-{{ section.id }} > section {
    padding-top: {{ _block.spacing_top }}px;
    padding-bottom: {{ _block.spacing_bottom }}px;
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} > section {
      padding-top: {{ _block.spacing_top_mobile }}px;
      padding-bottom: {{ _block.spacing_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

{% schema %}
  {
    "name": "Spacing",
    "settings": [
      {
        "type": "number",
        "id": "spacing_top",
        "label": "Top",
        "default": 80
      },
      {
        "type": "number",
        "id": "spacing_bottom",
        "label": "Bottom",
        "default": 80
      },
      {
        "type": "number",
        "id": "spacing_top_mobile",
        "label": "Top mobile",
        "default": 20
      },
      {
        "type": "number",
        "id": "spacing_bottom_mobile",
        "label": "Bottom mobile",
        "default": 20
      },
    ],
    "presets": [
      {
        "name": "Spacing",
        "settings": {
          "spacing_top": 0,
          "spacing_top_mobile": 0,
          "spacing_bottom": 0,
          "spacing_bottom_mobile": 0,
        }
      }
    ]
  }
{% endschema %}
