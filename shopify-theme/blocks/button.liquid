{%- assign _block = block.settings -%}

{%- if _block.heading != blank and _block.link != blank -%}
  {%- render 'button',
    type: 'link',
    style: _block.type,
    value: _block.heading,
    href: _block.link,
    icon_position: _block.icon_position
  -%}
{%- endif -%}

{% schema %}
  {
    "name": "Button",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Label"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "select",
        "id": "type",
        "label": "Type",
        "options": [
          {
            "value": "primary",
            "label": "Solid"
          },
          {
            "value": "secondary",
            "label": "Solid Alt"
          },
          {
            "value": "outlined",
            "label": "Outlined"
          },
          {
            "value": "text",
            "label": "link"
          }
        ],
        "default": "primary"
      },
      {
        "type": "select",
        "id": "icon_position",
        "label": "Icon position",
        "options": [
          {
            "value": "right",
            "label": "Right"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "",
            "label": "No icon"
          },
        ],
        "default": "right"
      },
    ],
    "presets": [
      {
        "name": "Button",
        "settings": {
          "heading": "Label",
          "link": "#",
          "type": "primary",
          "icon_position": "",
        }
      }
    ]
  }
{% endschema %}
