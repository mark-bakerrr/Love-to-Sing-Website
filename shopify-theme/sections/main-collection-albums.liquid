{%- comment -%}
  Digital Albums collection grid — "The Record Shelf".

  A bespoke album grid that extends the album product page's design language
  (sections/main-album.liquid): same brand-red palette, Nunito weights, and the
  vinyl-disc motif. Renders card-product-album for each product. Pair with the
  hero-banner above it in templates/collection.albums.json.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign per_page = s.products_per_page | default: 48
-%}

<section class="albums-collection" data-section-id="{{ section.id }}">
  <div class="albums-collection__container">
    {%- if s.heading != blank or s.intro != blank -%}
      <header class="albums-collection__head">
        {%- if s.heading != blank -%}
          {%- liquid
            assign tag = 'h2'
            if section.index == 1
              assign tag = 'h1'
            endif
          -%}
          <{{ tag }} class="albums-collection__heading">{{ s.heading | escape }}</{{ tag }}>
        {%- endif -%}
        <div class="albums-collection__head-row">
          {%- if s.intro != blank -%}
            <p class="albums-collection__intro">{{ s.intro | escape }}</p>
          {%- endif -%}
          {%- if collection.products_count > 0 -%}
            <p class="albums-collection__count">{{ collection.products_count }} album{% if collection.products_count != 1 %}s{% endif %}</p>
          {%- endif -%}
        </div>
      </header>
    {%- endif -%}

    {%- paginate collection.products by per_page -%}
      {%- if collection.products_count == 0 -%}
        <div class="albums-collection__empty">
          <span class="albums-collection__empty-disc" aria-hidden="true"></span>
          <p class="albums-collection__empty-title">{{ s.empty_text | default: 'New albums are on their way.' | escape }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="albums-collection__empty-link">Browse all music</a>
        </div>
      {%- else -%}
        <ul class="albums-collection__grid" role="list">
          {%- for product_ref in collection.products -%}
            <li class="albums-collection__cell" style="--i: {{ forloop.index0 }};">
              {%- render 'card-product-album', product_ref: product_ref -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          {%- render 'pagination', paginate: paginate, anchor: '' -%}
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{%- style -%}
  .albums-collection {
    /* Local tokens, anchored to the global brand palette + the album page. */
    --ac-ink: var(--color-paragraphs, #2d1b12);
    --ac-accent: var(--c-main-500, #b91f1c);
    --ac-accent-deep: var(--c-main-600, #8b1d18);
    --ac-surface: #ffffff;
    --ac-warm: var(--c-main-50, #fbeceb);
    --ac-border: rgba(52, 35, 24, 0.12);
    --ac-muted: color-mix(in srgb, var(--color-paragraphs, #2d1b12), transparent 38%);
    --ac-shadow: 0 1rem 2.8rem rgba(45, 11, 10, 0.10);
    --ac-shadow-hover: 0 2.2rem 4rem rgba(45, 11, 10, 0.18);
    --ac-ease: cubic-bezier(0.22, 1, 0.36, 1);
    padding: clamp(3.2rem, 6vw, 7.2rem) 0 clamp(4.8rem, 7vw, 8rem);
    background: var(--ac-surface);
    color: var(--ac-ink);
  }
  .albums-collection__container {
    width: min(120rem, 100% - 4rem);
    margin-inline: auto;
  }

  /* ── Header ─────────────────────────────────────────────────────────── */
  .albums-collection__head { margin-bottom: clamp(2.4rem, 4vw, 4rem); }
  .albums-collection__heading {
    margin: 0;
    font-size: clamp(2.8rem, 4.5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .albums-collection__head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    margin-top: 1rem;
  }
  .albums-collection__intro {
    margin: 0;
    max-width: 60ch;
    font-size: var(--fz-r, 1.6rem);
    line-height: 1.6;
    color: var(--ac-muted);
  }
  .albums-collection__count {
    margin: 0;
    flex: none;
    font-size: var(--fz-xs, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ac-accent);
  }

  /* ── Grid ───────────────────────────────────────────────────────────── */
  .albums-collection__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: clamp(2rem, 3.2vw, 3.6rem) clamp(1.6rem, 2.4vw, 2.8rem);
  }
  .albums-collection__cell { min-width: 0; }

  /* ── Card ───────────────────────────────────────────────────────────── */
  .album-card { display: flex; flex-direction: column; height: 100%; position: relative; }
  /* Lift the hovered card above its neighbours so the vinyl disc slides out
     IN FRONT of the album beside it, not behind it. */
  .album-card:hover,
  .album-card:focus-within { z-index: 5; }
  .album-card__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .album-card__art {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    margin-bottom: 1.4rem;
    /* let the vinyl disc peek beyond the sleeve on hover */
    overflow: visible;
  }
  .album-card__disc {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle,
        #f4ede6 0 16%,
        var(--ac-accent) 16% 26%,
        rgba(43, 28, 22, 0.92) 26% 27%,
        #211a18 27% 100%);
    box-shadow: 0 1.2rem 2.4rem rgba(33, 26, 24, 0.34);
    transform: translateX(0) rotate(0deg);
    transition: transform 0.55s var(--ac-ease);
  }
  /* groove rings + centre spindle */
  .album-card__disc::before {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, transparent 0 0.3rem, rgba(255, 255, 255, 0.05) 0.3rem 0.42rem);
  }
  .album-card__disc::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #f4ede6;
    transform: translate(-50%, -50%);
  }
  .album-card__sleeve {
    position: relative;
    z-index: 1;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 1.2rem;
    overflow: hidden;
    background: var(--ac-warm);
    box-shadow: var(--ac-shadow);
    transition: transform 0.55s var(--ac-ease), box-shadow 0.55s var(--ac-ease);
  }
  .album-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .album-card__cover--empty {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 4.8rem;
    color: var(--ac-accent);
  }

  .album-card:hover .album-card__disc,
  .album-card:focus-within .album-card__disc {
    transform: translateX(30%) rotate(10deg);
  }
  .album-card:hover .album-card__sleeve,
  .album-card:focus-within .album-card__sleeve {
    transform: translateY(-0.4rem);
    box-shadow: var(--ac-shadow-hover);
  }

  /* ── Card text ──────────────────────────────────────────────────────── */
  .album-card__body { display: flex; flex-direction: column; gap: 0.4rem; }
  .album-card__eyebrow {
    font-size: var(--fz-xs, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ac-accent);
  }
  .album-card__title {
    font-size: var(--fz-m, 1.8rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ac-ink);
  }
  .album-card:hover .album-card__title { color: var(--ac-accent-deep); }
  .album-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.2rem;
    font-size: var(--fz-xs, 1.2rem);
    color: var(--ac-muted);
  }
  .album-card__meta span:not(:first-child)::before {
    content: '·';
    margin-right: 0.6rem;
    color: var(--ac-border);
  }

  /* ── Foot: price + quick add ────────────────────────────────────────── */
  .album-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .album-card__price {
    font-size: var(--fz-r, 1.6rem);
    font-weight: 800;
    color: var(--ac-ink);
  }
  .album-card__price-was {
    margin-left: 0.6rem;
    font-size: var(--fz-xs, 1.2rem);
    font-weight: 600;
    color: var(--ac-muted);
  }
  .album-card__add {
    flex: none;
    width: 3.6rem;
    height: 3.6rem;
    display: inline-grid;
    place-items: center;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    background: var(--ac-accent);
    color: #fff;
    box-shadow: 0 0.4rem 1rem rgba(185, 31, 28, 0.32);
    transition: transform 0.18s var(--ac-ease), background 0.18s ease;
  }
  .album-card__add svg { width: 1.7rem; height: 1.7rem; fill: #fff; }
  .album-card__add:hover { transform: translateY(-0.2rem); background: var(--ac-accent-deep); }
  .album-card__add-check { display: none; font-size: 1.7rem; line-height: 1; }
  .album-card__add.is-added { background: #2e7d32; }
  .album-card__add.is-added svg { display: none; }
  .album-card__add.is-added .album-card__add-check { display: inline; }
  .album-card__add.is-loading { opacity: 0.6; pointer-events: none; }
  .album-card__add[disabled] { opacity: 0.4; pointer-events: none; box-shadow: none; }

  /* ── Empty state ────────────────────────────────────────────────────── */
  .albums-collection__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    padding: clamp(4rem, 8vw, 8rem) 2rem;
    text-align: center;
  }
  .albums-collection__empty-disc {
    width: 7rem; height: 7rem; border-radius: 50%;
    background:
      radial-gradient(circle, #f4ede6 0 16%, var(--ac-accent) 16% 26%, rgba(43,28,22,0.92) 26% 27%, #211a18 27% 100%);
    box-shadow: 0 1rem 2rem rgba(33,26,24,0.3);
  }
  .albums-collection__empty-title { margin: 0; font-size: var(--fz-m, 1.8rem); font-weight: 700; }
  .albums-collection__empty-link {
    font-weight: 700; color: var(--ac-accent); text-decoration-thickness: 0.15rem; text-underline-offset: 0.3rem;
  }

  /* ── Motion: entrance + reduced-motion ──────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .albums-collection__cell {
      opacity: 0;
      transform: translateY(1.2rem);
      animation: album-card-in 0.6s var(--ac-ease) forwards;
      animation-delay: calc(min(var(--i), 12) * 45ms);
    }
    @keyframes album-card-in {
      to { opacity: 1; transform: none; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .album-card__disc { transition: none; }
    .album-card__sleeve { transition: none; }
    .album-card:hover .album-card__disc,
    .album-card:focus-within .album-card__disc { transform: none; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Albums grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy Love to Sing Albums" },
    { "type": "text", "id": "intro", "label": "Intro line", "default": "Take our music offline — every album as instant MP3 downloads." },
    {
      "type": "range", "id": "products_per_page", "label": "Albums per page",
      "min": 12, "max": 48, "step": 4, "default": 48
    },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "New albums are on their way." }
  ],
  "presets": [{ "name": "Albums grid" }]
}
{% endschema %}
