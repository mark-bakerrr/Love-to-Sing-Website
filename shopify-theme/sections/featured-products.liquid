{%- liquid
  assign _section = section.settings
  content_for "block", type: "spacing", id: "featured-products-spacing"

  assign resources = _section.collection.products | default: _section.product_list | default: nil

  assign has_resources = false

  if resources
    assign has_resources = true
  endif

  capture classes
    echo 'featured-products'

    if _section.large_tiles
      echo ' large-tiles'
    endif

    if _section.border_bottom
      echo ' border-bottom'
    endif

    if _section.border_top
      echo ' border-top'
    endif

    if has_resources == false and _section.show_placeholder_cards == false
      echo ' hidden'
    endif
  endcapture
-%}

<section
  class="{{ classes }}"
  {%- if _section.alt_background -%}
    style="background-color: var(--neutral-100, #F4F4F4);"
  {%- endif -%}
>
  {%- render 'products-feed',
    title: _section.title,
    subtitle: _section.subtitle,
    button_text: _section.button_label,
    button_url: _section.button_link,
    autoplay: _section.autoplay,
    autoplay_speed: _section.autoplay_speed,
    resources: resources,
    aspect_ratio: _section.product_aspect_ratio,
    heading_size: 'h2',
    products_count: _section.products_count,
    show_placeholder_cards: _section.show_placeholder_cards,
  -%}
</section><!-- /.featured-products -->

{% schema %}
{
  "name": "t:sections.featured-products.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_placeholder_cards",
      "label": "Show placeholder cards",
      "default": true,
      "info": "Set to false if the products come from a dynamic source"
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "Alternative background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Add border to top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Add border to bottom",
      "default": false
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured-products.settings.title.label",
      "default": "Heading goes here"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.featured-products.settings.subtitle.label",
      "default": "Subtitle goes here"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "large_tiles",
      "label": "Large cards",
      "default": false
    },
    {
      "type": "select",
      "id": "product_aspect_ratio",
      "label": "Product media aspect ratio",
      "options": [
        {
          "value": "1-1",
          "label": "Square"
        },
        {
          "value": "16-9",
          "label": "Landscape"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ],
      "default": "1-1"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-products.settings.collection.label"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:sections.featured-products.settings.product_list.label",
      "info": "t:sections.featured-products.settings.product_list.info"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "t:sections.featured-products.settings.products_count.label",
      "min": 5,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.featured-products.settings.autoplay.label",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.featured-products.settings.autoplay_speed.label",
      "unit": "s",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:sections.featured-products.name"
    }
  ]
}
{% endschema %}
