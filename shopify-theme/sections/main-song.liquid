{%- liquid
  assign background_image = section.settings.background_image
  assign ad_left = section.settings.ad_left
  assign ad_right = section.settings.ad_right
  assign form_title = section.settings.form_title
  assign form_text = section.settings.form_text
  assign enable_share = section.settings.enable_share
  assign share_title = section.settings.share_title

  assign video = product.metafields.custom.youtube_main_video
  assign thumbnail = product.images[0] | image_url: width: 1080
  assign description = product.description

  # WS3: `album` / `video_purchase_url` assigns removed — the shop drawer
  # replaced the buttons that used them. To revert, restore these assigns:
  #   album = product.metafields.custom.album_product.value
  #   video_purchase_url = product.metafields.my_fields.video_purchase_url
  assign pdf_file = product.metafields.custom.pdf_lyric_sheet_download | file_url
  assign pdf = pdf_file | default: product.metafields.global.pdf
  assign lyrics = product.metafields.my_fields.song_lyrics

  assign icon_buttons = section.blocks | where: 'type', 'icon_button'

  assign class = ''

  if product.metafields.custom.main_color != blank
    assign class = class | append: 'main-color-' | append: product.metafields.custom.main_color | downcase
  endif
-%}
{% render 'song-schema' %}
<script>console.log({{ product.images[0] | json }});</script>
{{- 'main-song.css' | asset_url | stylesheet_tag -}}
<script src="{{- 'save-email.js' | asset_url -}}" defer></script>

<section class="main-song {{ class }}">
  <div class="main-song__head relative">
    {%- if background_image != blank -%}
      <div class="main-song__background" style="--background: {{ background }}; --opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};">
        {{- background_image | image_url: width: 1920 | image_tag -}}
      </div><!-- /.main-song__background -->
    {%- endif -%}

    <div class="container">
      <div class="main-song__breadcrumbs relative">
        {%- liquid
          assign breadcrumbs_menu = settings.breadcrumbs_map
          assign meta_collection = product.metafields.custom.breadcrumbs_collection.value
          assign current_collection = meta_collection

          unless current_collection
            for collection_ref in product.collections
              if collection_ref.handle != 'all' and collection_ref.handle != 'all-1'
                assign current_collection = collection_ref
                break
              endif
            endfor
          endunless
        -%}

        <nav role="navigation" aria-label="{{- 'general.breadcrumbs.label' | t -}}">
          {% render 'breadcrumbs-from-nav', breadcrumbs_menu: breadcrumbs_menu, current_collection: current_collection %}
        </nav>
      </div><!-- /.main-song__breadcrumbs -->

      <div class="main-song__grid relative">
        {%- if video -%}
          <div class="main-song__media">
            {%- liquid
              assign video_id = video | split: '?v=' | last

              assign thumbnail = thumbnail | default: 'https://img.youtube.com/vi/' | append: video_id | append: '/maxresdefault.jpg'
            -%}

            {{- 'youtube-player.css' | asset_url | stylesheet_tag -}}
            <script src="{{- 'youtube-player.js' | asset_url -}}" defer></script>

            {% render 'youtube-player', video_id: video_id, thumbnail: thumbnail %}
          </div><!-- /.main-song__media -->
        {%- elsif thumbnail -%}
          <div class="main-song__media">
            <img class="main-song__image" src="{{ thumbnail }}" alt="" loading="lazy">
          </div><!-- /.main-song__media -->
        {%- endif -%}

        <div class="main-song__info">
          <h1 class="main-song__title h2">
            {{- product.title | escape -}}
          </h1><!-- /.main-song__title -->

          {%- if description != blank -%}
            <p class="main-song__description">
              {{ description | strip_html | escape | truncatewords: 28, '...' }} <a href="#SongDescription">{{- 'blog.read_more' | t | downcase -}}</a>
            </p><!-- /.main-song__description -->
          {%- endif -%}

          {%- comment -%}
            WS3 shop drawer (epic #158): the album / buy-video buttons are
            replaced by a single "Get the music" trigger that opens the shop
            drawer (Shop Drawer app embed must be enabled for this theme).
            Original buttons preserved below for instant revert.

            {%- if album != blank or video_purchase_url != blank -%}
              <div class="main-song__actions">
                {%- if album != blank -%}
                  <a href="{{- album.url -}}" class="button button--full">
                    <span>{% render 'icon-cart' %}{{- 'song.buy_album' | t -}}</span>
                  </a>
                {%- endif -%}
                {%- if video_purchase_url != blank -%}
                  <a href="{{- video_purchase_url -}}" class="button button--secondary button--full">
                    <span>{{- 'song.buy_video_song' | t -}}</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endcomment -%}

          <div class="main-song__actions main-song__actions--shop">
            <button
              type="button"
              class="button button--full main-song__cta"
              data-lts-shop-trigger
              aria-haspopup="dialog"
              aria-expanded="false"
            >
              <span><span class="main-song__cta-label">{% render 'icon-cart' %}{{ 'song.get_the_music' | t }}</span><span class="main-song__cta-price">&nbsp;&mdash; {{ 'song.from_price' | t }}</span></span>
            </button>
            <p class="main-song__actions-note">{{ 'song.get_the_music_note' | t }}</p>
          </div><!-- /.main-song__actions -->
          {%- comment -%} Styles for the shop-drawer CTA above — remove together with it. {%- endcomment -%}
          {%- style -%}
            .main-song__actions--shop .main-song__cta,
            .main-song__actions--shop .main-song__actions-note {
              grid-column: 1 / -1;
            }
            .main-song__actions--shop .main-song__cta,
            .main-song__actions--shop .main-song__cta span {
              font-size: 1.6rem;
            }
            /* Label and price are atomic units: when the column is too narrow
               for one line, the price wraps below as a whole, centered —
               never mid-word. */
            .main-song__actions--shop .main-song__cta span {
              flex-wrap: wrap;
              justify-content: center;
              row-gap: 0;
              line-height: 1.4;
            }
            .main-song__cta-label {
              display: inline-flex;
              align-items: center;
              gap: 1.2rem;
              white-space: nowrap;
            }
            .main-song__cta-price {
              font-weight: 400;
              opacity: 0.85;
              white-space: nowrap;
            }
            /* Balance the video against a taller info column on tablet widths
               (it otherwise top-aligns and the CTA lands well below it). */
            .main-song__media {
              align-self: center;
            }
            .main-song__actions-note {
              font-size: 1.3rem;
              letter-spacing: 0.02em;
              opacity: 0.75;
              text-align: center;
            }
            @media (max-width: 767px) {
              .main-song__actions--shop .main-song__cta span {
                font-size: 1.6rem;
              }
            }
          {%- endstyle -%}
        </div><!-- /.main-song__info -->
      </div><!-- /.main-song__grid -->
    </div><!-- /.container -->
  </div><!-- /.main-song__head -->

  <div class="container">
    <div class="main-song__body">
      {%- if ad_left != blank -%}
        <div class="main-song__banner">
          {{- ad_left -}}
        </div><!-- /.main-song__banner -->
      {%- endif -%}

      <div class="main-song__body-inner">
        <div class="main-song__body-lyrics">
          <h2 class="main-song__body-title h3">
            {{- product.title | escape }} Lyrics
          </h2><!-- /.main-song__body-title -->

          <p>
            {{- lyrics | escape | newline_to_br -}}
          </p>
        </div><!-- /.main-song__body-lyrics -->

        <div class="main-song__body-main">
          {%- if product.images[1] != blank -%}
            <div class="main-song__body-image">
              {{- product.images[1] | image_url: width: 560 | image_tag -}}
            </div><!-- /.main-song__body-image -->
          {%- endif -%}

          <div class="main-song__form relative overflow-hidden">
            {%- if background_image != blank -%}
              <div class="main-song__background" style="--background: {{ background }}; --opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};">
                {{- background_image | image_url: width: 1920 | image_tag -}}
              </div><!-- /.main-song__background -->
            {%- endif -%}

            {%- if pdf != blank -%}
              <save-email style="display: contents;">
                {%- form 'customer', class: 'relative' -%}
                  {%- if form.posted_successfully? -%}
                    <script>window.location.href = '{{ pdf }}';</script>
                  {%- endif -%}

                  <input type="hidden" name="contact[tags]" value="download-pdf">

                  {%- if form_title != blank -%}
                    <h3 class="main-song__form-title h6">
                      {{- form_title | escape | newline_to_br -}}
                    </h3><!-- /.main-song__form-title -->
                  {%- endif -%}

                  {% comment %} Hidden with CSS if there is a subscribed email in localStorage {% endcomment %}
                  {%- unless customer -%}
                    {%- if form_text != blank -%}
                      <p class="main-song__form-text" css-hide-submitted>
                        {{- form_text | escape | newline_to_br -}}
                      </p><!-- /.main-song__form-text -->
                    {%- endif -%}

                    <div class="form-row" css-hide-submitted>
                      {%-
                        liquid
                        assign label = 'newsletter-form.email.label' | t
                        assign placeholder = 'newsletter-form.email.placeholder' | t
                        capture attr
                          echo 'aria-required="true" '
                          echo 'autocapitalize="off" '
                          echo 'autocomplete="email" '
                          if form.errors
                            echo 'autofocus '
                          endif
                        endcapture
                        if form.errors
                          assign message = form.errors.translated_fields['email'] | capitalize | append: ' ' | append: form.errors.messages['email']
                          assign has_error = true
                        elsif form.posted_successfully?
                          assign message = 'newsletter-form.success' | t
                        endif
                        assign id = 'PDFForm--' | append: section.id
                        render 'text-input', id: id, label: label, hide_label: true, type: 'email', name: 'contact[email]', placeholder: placeholder, attr: attr, message: message, has_error: has_error, required: true, value: form.email
                      -%}
                    </div><!-- /.form-row -->
                  {%- endunless -%}

                  <div class="form-row">
                      <a href="{{- pdf -}}" class="button button--full" target="_blank" css-show-submitted>
                        <span>
                          {% render 'icon-download' %}

                          {{- 'song.download' | t -}}
                        </span>
                      </a>

                      <button type="submit" class="button button--full" css-hide-submitted>
                        <span>
                          {% render 'icon-download' %}

                          {{- 'song.download' | t -}}
                        </span>
                      </button><!-- /.button -->
                  </div><!-- /.form-row -->
                {%- endform -%}
              </save-email>
            {%- endif -%}
          </div><!-- /.main-song__form -->

          {%- if icon_buttons.size > 0 -%}
            <div class="main-song__stream">
              <h3 class="main-song__stream-title h6">
                {{- 'song.stream_anywhere' | t -}}
              </h3><!-- /.main-song__stream-title -->

              {%- for block in icon_buttons -%}
                {%- liquid
                  assign block_image = block.settings.image
                  assign block_title = block.settings.title
                  assign block_link = block.settings.link
                -%}

                {%- if block_link != blank and block_title != blank or block_image != blank -%}
                  {%- if block_title != blank or block_image != blank -%}
                    <a href="{{- block_link -}}" class="button button--white button--full" target="_blank">
                      <span>
                        {%- if block_image != blank -%}
                          {{- block_image | image_url: width: 100 | image_tag -}}
                        {%- endif -%}

                        {%- if block_title != blank -%}
                          {{- block_title | escape -}}
                        {%- endif -%}
                      </span>
                    </a><!-- /.button button--white -->
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div><!-- /.main-song__stream -->
          {%- endif -%}

          {%- if enable_share -%}
            <div class="main-song__share center">
              {%- if share_title != blank -%}
                <h3 class="main-song__share-title h6">
                  {{- share_title | escape | newline_to_br -}}
                </h3><!-- /.main-song__share-title -->
              {%- endif -%}

              {% render 'share', object: product %}
            </div><!-- /.main-song__share -->
          {%- endif -%}

          {%- assign countdown_blocks = section.blocks | where: 'type', 'countdown' -%}
          {%- for block in countdown_blocks -%}
            <div class="main-song__countdown" {{ block.shopify_attributes }}>
              {% render 'countdown-card',
                design: block.settings.design,
                heading: block.settings.heading,
                target_month: block.settings.target_month,
                target_day: block.settings.target_day,
                reference_tz: block.settings.reference_tz,
                recurring: block.settings.recurring,
                end_behavior: block.settings.end_behavior,
                end_message: block.settings.end_message,
                grace_days: block.settings.grace_days,
                cta_label: block.settings.cta_label,
                cta_link: block.settings.cta_link,
                transparent_bg: block.settings.transparent_bg
              %}
            </div><!-- /.main-song__countdown -->
          {%- endfor -%}
        </div><!-- /.main-song__body-main -->
      </div><!-- /.main-song__body-inner -->

      {%- if ad_right != blank -%}
        <div class="main-song__banner">
          {{- ad_right -}}
        </div><!-- /.main-song__banner -->
      {%- endif -%}
    </div><!-- /.main-song__body -->
  </div><!-- /.container -->
</section><!-- /.main-song -->

{% schema %}
{
  "name": "Main Song Product",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "label": "Background opacity",
      "unit": "%",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 5
    },
    {
      "type": "textarea",
      "id": "ad_left",
      "label": "Ad (Left)"
    },
    {
      "type": "textarea",
      "id": "ad_right",
      "label": "Ad (Right)"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "textarea",
      "id": "form_title",
      "label": "Title",
      "default": "Get Free Lyric Sheet PDF"
    },
    {
      "type": "textarea",
      "id": "form_text",
      "label": "Text",
      "default": "Login to download any lyric sheet without having to re-enter your email."
    },
    {
      "type": "header",
      "content": "Share"
    },
    {
      "type": "checkbox",
      "id": "enable_share",
      "label": "Enable share",
      "default": false
    },
    {
      "type": "text",
      "id": "share_title",
      "label": "Title",
      "default": "Share this song"
    }
  ],
  "blocks": [
    {
      "type": "icon_button",
      "name": "Icon Button",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/"
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "design", "label": "Design", "default": "xmas-globe", "options": [
          { "group": "Christmas", "value": "xmas-advent", "label": "Christmas — Advent Cards" },
          { "group": "Christmas", "value": "xmas-globe", "label": "Christmas — Snow Globe" },
          { "group": "Christmas", "value": "xmas-sleigh", "label": "Christmas — Sleigh" },
          { "group": "Halloween", "value": "hall-jack", "label": "Halloween — Jack-o'-Lantern" },
          { "group": "Halloween", "value": "hall-neon", "label": "Halloween — Spooky Neon" },
          { "group": "Halloween", "value": "hall-cauldron", "label": "Halloween — Cauldron" }
        ] },
        { "type": "text", "id": "heading", "label": "Heading (optional)" },
        { "type": "header", "content": "Countdown target" },
        { "type": "number", "id": "target_month", "label": "Target month", "default": 12, "info": "Month the countdown ends (1–12). E.g. 12 for December." },
        { "type": "number", "id": "target_day", "label": "Target day", "default": 25, "info": "Day of that month the countdown reaches zero. The timer hits 00:00:00 at the start of this day in the reference timezone below." },
        { "type": "select", "id": "reference_tz", "label": "Reference timezone", "default": "America/New_York", "info": "Every visitor sees the same numbers regardless of their own timezone.", "options": [
          { "value": "America/New_York", "label": "New York (Eastern)" },
          { "value": "America/Chicago", "label": "Chicago (Central)" },
          { "value": "America/Denver", "label": "Denver (Mountain)" },
          { "value": "America/Los_Angeles", "label": "Los Angeles (Pacific)" },
          { "value": "UTC", "label": "UTC / London (GMT)" },
          { "value": "Europe/London", "label": "London (UK)" },
          { "value": "Pacific/Auckland", "label": "Auckland (New Zealand)" },
          { "value": "Australia/Sydney", "label": "Sydney (Australia)" }
        ] },
        { "type": "checkbox", "id": "recurring", "label": "Repeat every year", "default": true },
        { "type": "header", "content": "When the countdown reaches zero" },
        { "type": "select", "id": "end_behavior", "label": "At zero", "default": "message", "options": [
          { "value": "hide", "label": "Hide" },
          { "value": "message", "label": "Show message" },
          { "value": "message-then-hide", "label": "Show message then hide" }
        ] },
        { "type": "inline_richtext", "id": "end_message", "label": "End message", "default": "It's here!" },
        { "type": "number", "id": "grace_days", "label": "Grace days", "default": 6, "info": "For \"Show message then hide\": days the message stays up after zero before hiding." },
        { "type": "header", "content": "Call to action" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "See the countdown" },
        { "type": "url", "id": "cta_link", "label": "Button link", "info": "The button only appears when a link is set." },
        { "type": "header", "content": "Appearance" },
        { "type": "checkbox", "id": "transparent_bg", "label": "Transparent background", "default": false, "info": "Removes the skin's coloured background panel." }
      ]
    }
  ]

}
{% endschema %}
