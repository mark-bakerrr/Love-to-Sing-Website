{%- comment -%}
  lts-licence-scenarios
  Standalone, theme-editor-editable version of the "Which licence do I need?"
  scenarios list extracted from the old lts-licence-comparison monolith.

  Self-contained: carries its own copy of the shared brand tokens (--lc-*) and
  is fully root-scoped to .lts-lscen so it never collides with the theme or with
  the choices section.

  Each row is an editable "scenario" block: a situation on the left and a badge
  link on the right. The badge is soft-pink by default, or solid red when the
  "solid" checkbox is on (used for All-in-One rows).
{%- endcomment -%}

<div class="lts-lscen lts-lscen-tint" id="lts-lscen-{{ section.id }}">
  <div class="lts-lscen-wrap">

    {%- if section.settings.heading != blank -%}
      <div class="lts-lscen-headc">
        <h2 class="lts-lscen-rise">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="lts-lscen-list lts-lscen-rise" style="animation-delay:.06s">
      {%- for block in section.blocks -%}
        {%- if block.type == 'scenario' -%}
          <div class="lts-lscen-row" {{ block.shopify_attributes }}>
            {%- if block.settings.situation != blank -%}
              <span class="lts-lscen-sit">{{ block.settings.situation | escape }}</span>
            {%- endif -%}
            {%- if block.settings.badge_label != blank -%}
              <a
                class="lts-lscen-badge{% if block.settings.solid %} lts-lscen-badgesolid{% endif %}"
                href="{{ block.settings.badge_url | default: '#' }}"
              >{{ block.settings.badge_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% stylesheet %}
.lts-lscen{
  --lc-red:#c8102e; --lc-red-strong:#b0102a; --lc-red-deep:#8f0f24; --lc-red-ink:#5e0a18;
  --lc-red-50:#fdeef0; --lc-red-100:#fbdbe0;
  --lc-ink:#241a17; --lc-body:#4a423e; --lc-muted:#736a65; --lc-line:#efe7e3; --lc-hair:#f4eeeb;
  --lc-bg:#fffefe; --lc-surface:#fff;
  --lc-r:14px; --lc-r-lg:18px;
  --lc-shadow-sm:0 1px 2px rgba(60,20,25,.06);
  --lc-shadow:0 10px 24px -14px rgba(90,20,30,.30);
  --lc-ok:0 8px 30px -12px rgba(200,16,46,.35);
  --lc-e:cubic-bezier(.2,.7,.2,1);
  font-family:'Nunito',system-ui,'Segoe UI',Roboto,sans-serif;color:var(--lc-body);line-height:1.55;-webkit-font-smoothing:antialiased;
  padding:clamp(44px,7vw,72px) 0;
}
.lts-lscen *{box-sizing:border-box}
.lts-lscen.lts-lscen-tint{background:#fdfafa;border-top:1px solid var(--lc-hair);border-bottom:1px solid var(--lc-hair)}
.lts-lscen .lts-lscen-wrap{max-width:1000px;margin:0 auto;padding:0 22px}
.lts-lscen h2{color:var(--lc-ink);text-wrap:balance;margin:0;font-size:clamp(22px,3.6vw,30px);font-weight:900;letter-spacing:-.02em}
.lts-lscen a{color:inherit}

/* reveal */
.lts-lscen .lts-lscen-rise{opacity:0;transform:translateY(14px);animation:lts-lscen-rise .7s var(--lc-e) forwards}
@keyframes lts-lscen-rise{to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.lts-lscen .lts-lscen-rise{animation:none;opacity:1;transform:none}}

.lts-lscen .lts-lscen-headc{text-align:center;max-width:62ch;margin:0 auto 6px}

/* ===== scenarios ===== */
.lts-lscen .lts-lscen-list{margin-top:24px;background:var(--lc-surface);border:1px solid var(--lc-line);border-radius:var(--lc-r-lg);overflow:hidden}
.lts-lscen .lts-lscen-row{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 22px;border-bottom:1px solid var(--lc-hair);transition:background .2s}
.lts-lscen .lts-lscen-row:last-child{border-bottom:0}
.lts-lscen .lts-lscen-row:hover{background:#fdfafa}
.lts-lscen .lts-lscen-sit{font-weight:600;font-size:15.5px;color:var(--lc-body)}
.lts-lscen .lts-lscen-badge{flex:0 0 auto;font-size:12.5px;font-weight:900;padding:6px 14px;border-radius:999px;white-space:nowrap;background:var(--lc-red-50);color:var(--lc-red-ink);text-decoration:none;transition:transform .2s var(--lc-e)}
.lts-lscen .lts-lscen-badge:hover{transform:translateY(-1px)}
.lts-lscen .lts-lscen-badge.lts-lscen-badgesolid{background:var(--lc-red);color:#fff}

@media(max-width:640px){
  .lts-lscen .lts-lscen-row{flex-direction:column;align-items:flex-start;gap:8px}
}
{% endstylesheet %}

