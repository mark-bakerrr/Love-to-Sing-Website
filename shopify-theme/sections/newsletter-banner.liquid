{{- 'section-newsletter.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign _section = section.settings

  capture styles
    echo '--background-top: ' | append: _section.background_top | append: ';'
    echo '--background-bottom: ' | append: _section.background_bottom | append: ';'
    echo '--background-content: ' | append: _section.background_content | append: ';'
    echo '--text-color: ' | append: _section.text_color | append: ';'
  endcapture

  # Render spacing block
  content_for "block", type: "spacing", id: "newsletter-spacing"
-%}

<section
  class="newsletter"
  style="{{ styles }}"
>
  <div class="container">
    <div
      class="newsletter__wrapper"
      style="background: {{ _section.background_content }};"
    >
      {%- render 'background-media',
        image: _section.image,
        mobile_image: _section.image_mobile,
        media_opacity: _section.media_opacity,
        class: 'newsletter',
      -%}

      {%- if _section.title != blank or _section.subtitle != blank -%}
        <div class="newsletter__content">
          {%- if _section.title -%}
            <h2 class="newsletter__title center">
              {{ _section.title }}
            </h2><!-- /.newsletter__title center -->
          {%- endif -%}

          {%- if _section.subtitle -%}
            <p class="newsletter__subtitle center">
              {{ _section.subtitle }}
            </p><!-- /.newsletter__subtitle center -->
          {%- endif -%}
        </div><!-- /.newsletter__content -->
      {%- endif -%}

      <div class="newsletter__form">
        {%- capture button_value -%}
          {%- render 'icon', icon: 'send' -%}
        {%- endcapture -%}

        {% render 'newsletter-form',
          namespace: section.id,
          button_icon: button_value,
          button_style: 'secondary',
          icon_position: 'right'
        %}
      </div><!-- /.newsletter__form -->
    </div><!-- /.newsletter__wrapper -->
  </div><!-- /.container -->
</section><!-- /.newsletter -->

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    {
      "type": "header",
      "content": "Backgrounds"
    },
    {
      "type": "color",
      "id": "background_top",
      "label": "Background top",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "background_bottom",
      "label": "Background bottom",
      "default": "#521B1A"
    },
    {
      "type": "color_background",
      "id": "background_content",
      "label": "Content background",
      "default": "radial-gradient(50% 50% at 50% 50%, #B91F1C 0%, #781D1B 100%)"
    },
    {
      "type": "range",
      "id": "media_opacity",
      "label": "Media opacity",
      "unit": "%",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 5
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Content image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Content mobile image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.newsletter.settings.title.label",
      "default": "Join Our Newsletter"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.newsletter.settings.subtitle.label",
      "default": "Sign up to our newsletter and we will send you a free song!"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:sections.newsletter.name"
    }
  ]
}
{% endschema %}
