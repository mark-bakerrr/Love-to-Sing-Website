{%- comment -%}
  Album collection hero — red hearts banner with a fanned spread of the
  collection's OWN real album covers (pulled live from collection.products).
  Used by templates/collection.albums.json. Works for any album collection:
  Digital Albums, Christmas Albums, Kids Music Albums — each fans its own covers.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign max = s.cover_count | default: 5
  # collect album products that actually have artwork
  assign covers = collection.products | where: 'featured_image'
-%}

<section class="album-hero" data-section-id="{{ section.id }}">
  <span class="album-hero__bg" aria-hidden="true" style="background-image: url({{ 'hearts-background.png' | asset_url }});"></span>

  <div class="album-hero__inner">
    <div class="album-hero__copy">
      {%- if s.eyebrow != blank -%}<p class="album-hero__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.title != blank -%}
        {%- liquid
          assign tag = 'h2'
          if section.index == 1
            assign tag = 'h1'
          endif
        -%}
        <{{ tag }} class="album-hero__title">{{ s.title | escape }}</{{ tag }}>
      {%- endif -%}
      {%- if s.content != blank -%}<p class="album-hero__text">{{ s.content }}</p>{%- endif -%}
    </div>

    {%- if covers.size > 0 -%}
      <div class="album-hero__stage" aria-hidden="true">
        <ul class="album-hero__fan" style="--count: {{ covers.size | at_most: max }};">
          {%- for product in covers limit: max -%}
            <li class="album-hero__cover" style="--n: {{ forloop.index0 }};">
              <img
                src="{{ product.featured_image | image_url: width: 440 }}"
                srcset="{{ product.featured_image | image_url: width: 220 }} 220w, {{ product.featured_image | image_url: width: 440 }} 440w"
                sizes="14rem"
                width="220" height="220"
                alt="" loading="eager">
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{%- style -%}
  .album-hero {
    --ah-red: var(--c-main-500, #b91f1c);
    --ah-red-deep: var(--c-main-600, #781d1b);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: radial-gradient(120% 120% at 70% 20%, var(--ah-red) 0%, var(--ah-red-deep) 100%);
    color: #fff;
  }
  .album-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* one covering instance — repeating tiled it into a visible grid */
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    opacity: 0.16;
    mix-blend-mode: screen;
  }
  .album-hero__inner {
    width: min(120rem, 100% - 4rem);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 6rem);
    padding: clamp(3.6rem, 6vw, 7rem) 0;
    min-height: clamp(32rem, 42vw, 46rem);
  }

  /* ── Copy ───────────────────────────────────────────────────────────── */
  .album-hero__copy { max-width: 46rem; }
  .album-hero__eyebrow {
    margin: 0 0 1.2rem;
    font-size: var(--fz-xs, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
  }
  .album-hero__title {
    margin: 0;
    color: #fff; /* theme sets a dark heading colour on h1/h2 — force white on red */
    font-size: clamp(3.2rem, 5vw, 5.4rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .album-hero__text {
    margin: 1.6rem 0 0;
    font-size: var(--fz-r, 1.6rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    max-width: 42ch;
  }

  /* ── Fanned real covers ─────────────────────────────────────────────── */
  .album-hero__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 30rem;
  }
  .album-hero__fan {
    list-style: none;
    margin: 0; padding: 0;
    position: relative;
    z-index: 2;
    width: 16rem; height: 16rem;
  }
  .album-hero__cover {
    position: absolute;
    inset: 0;
    /* fan around the centre card: index 0..count-1, centred on (count-1)/2 */
    --mid: calc((var(--count) - 1) / 2);
    --offset: calc(var(--n) - var(--mid));
    transform: rotate(calc(var(--offset) * 9deg)) translateX(calc(var(--offset) * 2.6rem));
    transform-origin: bottom center;
    border-radius: 0.8rem;
    overflow: hidden;
    box-shadow: 0 1.2rem 2.6rem rgba(0,0,0,0.32);
    transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
  }
  .album-hero__cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* gentle spread on hover of the whole stage */
  .album-hero__stage:hover .album-hero__cover {
    transform: rotate(calc(var(--offset) * 11deg)) translateX(calc(var(--offset) * 3.1rem)) translateY(-0.4rem);
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 749px) {
    .album-hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3.2rem;
    }
    .album-hero__copy { max-width: none; margin-inline: auto; }
    .album-hero__text { margin-inline: auto; }
    .album-hero__stage { order: 2; min-height: 24rem; }
    .album-hero__fan { width: 13rem; height: 13rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .album-hero__cover { transition: none; }
    .album-hero__stage:hover .album-hero__cover {
      transform: rotate(calc(var(--offset) * 9deg)) translateX(calc(var(--offset) * 2.6rem));
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Album hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Buy Music Albums" },
    { "type": "text", "id": "title", "label": "Title", "default": "Share the joy of Love to Sing Music" },
    { "type": "richtext", "id": "content", "label": "Text", "default": "<p>Take our music offline — every album as instant MP3 downloads.</p>" },
    { "type": "range", "id": "cover_count", "label": "Album covers in the fan", "min": 3, "max": 7, "step": 1, "default": 5 }
  ],
  "presets": [{ "name": "Album hero" }]
}
{% endschema %}
