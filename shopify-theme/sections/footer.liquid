{%- liquid
  assign _section = section.settings
  assign _blocks = section.blocks

  comment
    Find if custom color scheme is set for current template.
  endcomment
  assign custom_color_scheme = ''
  assign color_scheme = section.settings.main_colors
  assign color_scheme_blocks = _blocks | where: "type", "custom_color_scheme"
  assign current_template = template.name | append: '.' | append: template.suffix
  assign logo_blocks = _blocks | where: "type", "custom_template_logo"

  for block in logo_blocks
    assign _block = block.settings
    assign template_list = _block.title | newline_to_br | split: '<br />'

    # Go through all templates
    for block_template in template_list
      assign _block_template = block_template | strip_newlines

      unless _block_template contains '.'
        assign _block_template = _block_template | append: '.'
      endunless

      if current_template == _block_template
        assign custom_logo = _block.logo

        break
      endif
    endfor

    if custom_logo != ''
      break
    endif
  endfor

  comment
    Custom color scheme
  endcomment
  for block in color_scheme_blocks
    assign _block = block.settings
    assign template_list = _block.title | newline_to_br | split: '<br />'

    # Go through all templates
    for block_template in template_list
      assign _block_template = block_template | strip_newlines

      unless _block_template contains '.'
        assign _block_template = _block_template | append: '.'
      endunless

      if current_template == _block_template
        assign custom_color_scheme = _block.color_scheme

        break
      endif
    endfor

    if custom_color_scheme != ''
      break
    endif
  endfor

  if custom_color_scheme != ''
    assign color_scheme = custom_color_scheme
  endif
-%}
<script src="{{- 'accordion-item.js' | asset_url -}}" defer="defer"></script>
{{- 'component-accordion-item.css' | asset_url | stylesheet_tag -}}
{{- 'section-footer.css' | asset_url | stylesheet_tag -}}

<footer class="footer color-{{ color_scheme }}">
  <div class="container">
    <div class="footer__inner">
      {%- if _section.logo != blank or _section.content != blank -%}
        <div class="footer__brand footer__col">
          {%- if _section.logo != blank or custom_logo != blank -%}
            <div
              class="footer__logo"
              style="--width: {{ _section.Logo_width }}px; --width-mobile: {{ _section.Logo_width_mobile }}px;"
            >
              <div class="media media--transparent media--1-1">
                {%- liquid
                  if custom_logo != blank
                    render 'image', image: custom_logo
                  else
                    render 'image', image: _section.logo
                  endif
                -%}
              </div><!-- /.media -->
            </div><!-- /.footer__logo -->
          {%- endif -%}

          {%- if _section.content != blank -%}
            <p class="footer__brand-content">
              {{- _section.content -}}
            </p><!-- /.footer__brand-content -->
          {%- endif -%}
        </div><!-- /.footer__brand -->
      {%- endif -%}

      {%- assign menu_blocks = _blocks | where: "type", "menu_col" -%}
      {%- assign mobile_accordions = '' -%}

      {%- if menu_blocks.size > 0 -%}
        {%- for block in menu_blocks -%}
          {%- liquid
            assign _block = block.settings
            assign menu = linklists[_block.menu]
            assign title = _block.heading
          -%}

          {%- capture menu_items -%}
            {%- for link in menu.links -%}
              <li class="footer__links-item">
                <a
                  href="{{- link.url -}}"
                  class="inline-unstyled-link focus-inset link-hover-fade"
                >
                  {{- link.title | escape -}}
                </a>
              </li><!-- /.footer__links-item -->
            {%- endfor -%}
          {%- endcapture -%}

          {%- capture mobile_accordions -%}
            {{ mobile_accordions }}

            {%- capture content -%}
              <ul class="footer__links list-unstyled">
                {{ menu_items }}
              </ul><!-- /.footer__links list-unstyled -->
            {%- endcapture -%}

            {%- render 'accordion-item',
              title: title,
              content: content,
              class: 'footer__accordion',
              title_class: 'h6',
              is_open: forloop.first,
            -%}
          {%- endcapture -%}

          <nav class="footer__nav footer__col small-hide medium-hide">
            {%- if title != blank -%}
              <h6 class="footer__nav-heading">
                {{- title -}}
              </h6><!-- /.footer__nav-heading -->
            {%- endif -%}

            <ul class="footer__links list-unstyled">
              {{ menu_items }}
            </ul><!-- /.footer__links list-unstyled -->
          </nav><!-- /.footer__nav -->
        {%- endfor -%}
      {%- endif -%}

      <div class="footer__nav-mobile large-up-hide">
        {{ mobile_accordions }}
      </div><!-- /.footer__nav-mobile -->
    </div><!-- /.footer__inner -->

    <div class="footer__bar">
      {%- if _section.copyright != blank  -%}
        <p class="footer__copyright">
          {{ _section.copyright }}
        </p><!-- /.footer__copyright -->
      {%- endif -%}

      {%- if _section.menu_bar != blank -%}
        <div class="footer__bar-menu">
          <ul class="list-unstyled">
            {%- for item in linklists[_section.menu_bar].links -%}
              <li>
                <a
                  href="{{- item.url -}}"
                  class="inline-unstyled-link focus-inset link-underline"
                >
                  {{ item.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div><!-- /.footer__bar-menu -->
      {%- endif -%}

      <div class="footer__socials">
        {%- render 'social-icons' -%}
      </div><!-- /.footer__socials -->
    </div><!-- /.footer__bar -->
  </div><!-- /.container -->
</footer><!-- /.footer -->

{% schema %}
  {
    "name": "t:sections.footer.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "number",
        "id": "Logo_width",
        "label": "Logo width",
        "default": 95
      },
      {
        "type": "number",
        "id": "Logo_width_mobile",
        "label": "Logo mobile width",
        "default": 95
      },
      {
        "type": "textarea",
        "id": "content",
        "label": "Content below logo"
      },
      {
        "type": "header",
        "content": "Footer bar"
      },
      {
        "type": "textarea",
        "id": "copyright",
        "label": "Copyright text"
      },
      {
        "type": "link_list",
        "id": "menu_bar",
        "label": "Menu"
      }
    ],
    "blocks": [
      {
        "name": "Menu column",
        "type": "menu_col",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Title"
          },
          {
            "type": "link_list",
            "id": "menu",
            "label": "Menu"
          }
        ]
      },
      {
        "name": "Custom color scheme",
        "type": "custom_color_scheme",
        "settings": [
          {
            "type": "textarea",
            "id": "title",
            "label": "Template name",
            "info": "Enter a list of templates(each on a new line) with type and name in the following format: '[type].[name]', eg. 'product.christmas', 'collection.special-offers'. Default templates have no name, so use just the type, for example 'product' or 'collection'.",
          },
          {
            "type": "color_scheme",
            "id": "color_scheme",
            "default": "scheme_1",
            "label": "Color scheme"
          }
        ]
      },
      {
        "name": "Custom template Logo",
        "type": "custom_template_logo",
        "settings": [
          {
            "type": "textarea",
            "id": "title",
            "label": "Template name",
            "info": "Enter a list of templates(each on a new line) with type and name in the following format: '[type].[name]', eg. 'product.christmas', 'collection.special-offers'. Default templates have no name, so use just the type, for example 'product' or 'collection'.",
          },
          {
            "type": "image_picker",
            "id": "logo",
            "label": "Logo"
          },
        ]
      },
    ]
  }
{% endschema %}
