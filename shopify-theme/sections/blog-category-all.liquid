{{- 'section-blog-category.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign _section = section.settings
  assign heading = _section.heading | default: 'All Articles'
  assign blog_ref = blog
  assign topics = blog_ref.metafields.custom.topics.value

  comment
    Build comma-separated list of topic tags from this blog
  endcomment
  assign all_topic_tags = ''
  if topics != blank
    for topic in topics
      if topic.tag != blank
        assign all_topic_tags = all_topic_tags | append: topic.tag | append: ','
      endif
    endfor
  endif
-%}

<section class="blog-category-all" id="all-articles">
  <div class="container">
    <div class="blog-category-all__header">
      <div class="shelf__header-left">
        <span class="shelf__accent"></span>
        <h2 class="blog-category-all__title h3">{{ heading }}</h2>
      </div>
    </div>

    {%- assign all_shown_count = 0 -%}
    {%- assign all_shown_ids = '' -%}

    {%- if all_topic_tags != blank -%}
      <div class="blog-category-all__grid grid grid--3" data-blog-all-grid>
        {%- comment -%} First: current blog articles {%- endcomment -%}
        {%- for article_ref in blog_ref.articles -%}
          {%- if article_ref.template_suffix == 'pillar' or article_ref.tags contains 'pillar' -%}{%- continue -%}{%- endif -%}
          {%- assign all_id_check = article_ref.id | append: ',' -%}
          {%- if all_shown_ids contains all_id_check -%}{%- continue -%}{%- endif -%}

          {%- assign all_tag_matched = false -%}
          {%- for tag in article_ref.tags -%}
            {%- assign all_tag_check = tag | append: ',' -%}
            {%- if all_topic_tags contains all_tag_check -%}
              {%- assign all_tag_matched = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if all_tag_matched -%}
            {%- assign all_shown_ids = all_shown_ids | append: all_id_check -%}
            {%- assign all_shown_count = all_shown_count | plus: 1 -%}
            {%- render 'card-article', article_ref: article_ref -%}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Second: other blogs' articles {%- endcomment -%}
        {%- for b in blogs -%}
          {%- if b.handle == blog_ref.handle -%}{%- continue -%}{%- endif -%}
          {%- for article_ref in b.articles -%}
            {%- if article_ref.template_suffix == 'pillar' or article_ref.tags contains 'pillar' -%}{%- continue -%}{%- endif -%}
            {%- assign all_id_check = article_ref.id | append: ',' -%}
            {%- if all_shown_ids contains all_id_check -%}{%- continue -%}{%- endif -%}

            {%- assign all_tag_matched = false -%}
            {%- for tag in article_ref.tags -%}
              {%- assign all_tag_check = tag | append: ',' -%}
              {%- if all_topic_tags contains all_tag_check -%}
                {%- assign all_tag_matched = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if all_tag_matched -%}
              {%- assign all_shown_ids = all_shown_ids | append: all_id_check -%}
              {%- assign all_shown_count = all_shown_count | plus: 1 -%}
              {%- render 'card-article', article_ref: article_ref -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- if all_shown_count == 0 -%}
        <p class="center">No articles found.</p>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} No topics configured - show all articles from all blogs {%- endcomment -%}
      <div class="blog-category-all__grid grid grid--3" data-blog-all-grid>
        {%- for b in blogs -%}
          {%- for article_ref in b.articles -%}
            {%- if article_ref.template_suffix == 'pillar' or article_ref.tags contains 'pillar' -%}{%- continue -%}{%- endif -%}
            {%- assign all_id_check = article_ref.id | append: ',' -%}
            {%- if all_shown_ids contains all_id_check -%}{%- continue -%}{%- endif -%}
            {%- assign all_shown_ids = all_shown_ids | append: all_id_check -%}
            {%- assign all_shown_count = all_shown_count | plus: 1 -%}
            {%- render 'card-article', article_ref: article_ref -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- if all_shown_count == 0 -%}
        <p class="center">No articles found.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "All Articles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Articles"
    }
  ]
}
{% endschema %}
