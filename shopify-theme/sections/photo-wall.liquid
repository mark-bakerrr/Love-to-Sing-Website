<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer="defer"></script>
<script src="{{ 'photo-wall.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Photo Wall",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (top-left)",
      "info": "Links to the homepage. Falls back to the shop name if empty."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Heart of Love to Sing"
    },
    {
      "type": "text",
      "id": "watermark",
      "label": "Background watermark",
      "default": "LOVE TO\nSING",
      "info": "Faint text in the middle of the board. Use a line break for two lines."
    },
    {
      "type": "header",
      "content": "Music player"
    },
    {
      "type": "checkbox",
      "id": "show_music_player",
      "label": "Show music player",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "track",
      "name": "Track",
      "settings": [
        { "type": "text", "id": "title", "label": "Song title" },
        { "type": "text", "id": "artist", "label": "Artist", "default": "Love to Sing" },
        { "type": "image_picker", "id": "artwork", "label": "Artwork" },
        { "type": "url", "id": "audio_url", "label": "Audio URL", "info": "Full/lo-fi track (Shopify Files URL is fine)." }
      ]
    }
  ],
  "presets": [
    { "name": "Photo Wall" }
  ]
}
{% endschema %}
