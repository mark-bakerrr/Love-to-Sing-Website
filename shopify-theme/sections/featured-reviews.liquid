{%- liquid
  assign _section = section.settings
  content_for "block", type: "spacing", id: "featured-products-spacing"

  capture blocks
    content_for 'blocks'
  endcapture

  capture classes
    echo 'featured-reviews'

    if _section.border_bottom
      echo ' section-border-bottom'
    endif

    if _section.border_top
      echo ' section-border-top'
    endif
  endcapture

  assign meta_reviews = product.metafields.custom.reviews.value
-%}

{{- 'card-review.css' | asset_url | stylesheet_tag -}}
{{- 'swiper-bundle.min.css' | asset_url | stylesheet_tag -}}
{{- 'featured-reviews.css' | asset_url | stylesheet_tag -}}

<script src="{{- 'swiper-bundle.min.js' | asset_url -}}" defer="defer" data-theme-script></script>
<script src="{{- 'reviews-carousel.js' | asset_url -}}" defer="defer" data-theme-script></script>

<section
  class="{{- classes -}}"
  {%- if _section.alt_background -%}
    style="background-color: var(--neutral-100, #F4F4F4);"
  {%- endif -%}
>
  <reviews-carousel
    class="reviews-carousel"
    {% if _section.autoplay %}
      data-autoplay
      data-autoplay-speed="{{ _section.autoplay_speed | times: 1000 }}"
    {% endif %}
  >
    <div class="container">
      <div class="reviews-carousel__wrapper">
        <div class="reviews-carousel__head">
          <div class="reviews-carousel__content center">
            {%- if _section.title != blank -%}
              <h3 class="reviews-carousel__title h2">
                {{- _section.title -}}
              </h3><!-- /.reviews-carousel__title -->
            {%- endif -%}

            {%- if _section.subtitle != blank -%}
              <p class="reviews-carousel__subtitle">
                {{ _section.subtitle }}
              </p>
            {%- endif -%}
          </div><!-- /.reviews-carousel__content -->
        </div><!-- /.reviews-carousel__head -->

        <div class="reviews-carousel__body relative" data-container-products>
          <div class="reviews-carousel__list swiper" data-slider>
            <div class="swiper-wrapper">
              {%- if meta_reviews != blank -%}
                {%- for review in meta_reviews -%}
                  <div class="swiper-slide">
                    {%- render 'card-review',
                      stars: review.stars,
                      content: review.content,
                      image: review.image,
                      author: review.author,
                      position: review.position
                    -%}
                  </div><!-- /.swiper-slide -->
                {%- endfor -%}
              {%- else -%}
                {{ blocks }}
              {%- endif -%}
            </div><!-- /.swiper-wrapper -->

            <div class="reviews-carousel__actions">
              <div class="swiper-pagination"></div>

              <div class="swiper-arrows">
                <button class="swiper-arrow swiper-arrow--prev">
                  {%- render 'icon', icon: 'chevron-left' -%}
                </button><!-- /.swiper-arrow -->

                <button class="swiper-arrow swiper-arrow--next">
                  {%- render 'icon', icon: 'chevron-right' -%}
                </button><!-- /.swiper-arrow -->
              </div><!-- /.swiper-arrows -->
            </div><!-- /.swiper__actions -->
          </div><!-- /.reviews-carousel__list -->
        </div><!-- /.reviews-carousel__body -->
      </div><!-- /.reviews-carousel__wrapper -->
    </div><!-- /.container -->
  </reviews-carousel>
</section><!-- /.featured-reviews -->

{% schema %}
{
  "name": "Featured reviews",
  "settings": [
    {
      "type": "header",
      "content": "Product Page",
      "info": "If your product has reviews saved in its metafields, those will automatically appear on the product page instead of the default review block."
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "Alternative background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Add border to top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Add border to bottom",
      "default": false
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured-products.settings.title.label",
      "default": "Heading goes here"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.featured-products.settings.subtitle.label",
      "default": "Subtitle goes here"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.featured-products.settings.autoplay.label",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.featured-products.settings.autoplay_speed.label",
      "unit": "s",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
  ],
  "blocks": [
    {
      "type": "review",
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Featured reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
