{{- 'section-blog-category.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign blog_ref = blog
  assign pillar_title = blank

  if article != blank and article.template_suffix == 'pillar'
    assign topics = blog_ref.metafields.custom.topics.value
    assign pillar_tag = blank
    for tag in article.tags
      if tag contains 'Category_'
        assign pillar_tag = tag
        break
      endif
    endfor
    if topics != blank and pillar_tag != blank
      for topic in topics
        if topic.tag == pillar_tag or topic.tag contains pillar_tag or pillar_tag contains topic.tag
          assign pillar_title = topic.title
          break
        endif
      endfor
    endif
    if pillar_title == blank
      assign pillar_title = article.title
    endif
  endif
-%}

<div class="blog-breadcrumbs-wrapper" style="color: #fff;">
  <nav class="blog-breadcrumbs container" aria-label="{{- 'general.breadcrumbs.label' | t -}}">
    <ol class="blog-breadcrumbs__list list-unstyled list-flex" role="list">
      <li>
        <a href="{{- routes.root_url -}}" class="inline-unstyled-link link-hover-fade">
          {{- 'general.breadcrumbs.home' | t -}}
        </a>
      </li>

      <li>
        {%- render 'icon', icon: 'chevron-right' -%}
      </li>

      {%- if pillar_title != blank -%}
        <li>
          <a href="{{- blog_ref.url -}}" class="inline-unstyled-link link-hover-fade">
            {{- blog_ref.title -}}
          </a>
        </li>

        <li>
          {%- render 'icon', icon: 'chevron-right' -%}
        </li>

        <li>
          <span>{{- pillar_title -}}</span>
        </li>
      {%- else -%}
        <li>
          <span>{{- blog_ref.title -}}</span>
        </li>
      {%- endif -%}
    </ol>
  </nav>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.breadcrumbs.home' | t | json }},
      "item": "{{ shop.url }}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog_ref.title | json }},
      "item": "{{ shop.url }}{{ blog_ref.url }}"
    }
    {%- if pillar_title != blank -%}
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": {{ pillar_title | json }},
      "item": "{{ shop.url }}{{ article.url }}"
    }
    {%- endif -%}
  ]
}
</script>

{% schema %}
{
  "name": "Blog Breadcrumbs",
  "settings": []
}
{% endschema %}
