{%- liquid
  assign _section = section.settings
  content_for "block", type: "spacing", id: "image-text-spacing"

  echo 'section-image-and-text.css' | asset_url | stylesheet_tag
-%}
{%- if section.settings.title != blank
    or section.settings.content != blank
    or section.settings.button_url != blank and section.settings.button_text != blank -%}
  <section
    class="image-text {% if _section.push_content_up %} content-pad{% endif %}"
    style="background: {{ section.settings.background }}; color: {{ section.settings.content_color }};"
  >
    <div class="container">
      <div class="image-text__inner grid grid--2 grid--no-column-gap {% if section.settings.flip_content %}grid--reverse{% endif %}" >
        <div class="image-text__media">
          <div class="media media--1-1 media--2-4-mobile">
            {%-
              liquid
              if section.settings.image != blank
                render 'image', image: section.settings.image
              else
                echo 'image' | placeholder_svg_tag: 'placeholder-svg'
              endif
            -%}
          </div><!-- /.media -->
        </div><!-- /.image-text__media -->

        <div class="flex flex--justify-center flex--direction-column">
          <div class="image-text__content">
            {%- if section.settings.eyebrow != blank -%}
              <p
                class="image-text__eyebrow"
                style="color: {{ section.settings.eyebrow_color }};"
              >
                {{- section.settings.eyebrow | escape -}}
              </p><!-- /.h3 -->
            {%- endif -%}

            {%- if section.settings.title != blank -%}
              <h2 class="h2 image-text__title">
                {{- section.settings.title | escape -}}
              </h2><!-- /.h3 -->
            {%- endif -%}

            {%- if section.settings.content != blank -%}
              <div class="image-text__entry rte">
                {{- section.settings.content -}}
              </div><!-- /.image-text__entry -->
            {%- endif -%}

            {%- if section.settings.button_text != blank
              and section.settings.button_url != blank -%}
              {%- render 'button',
                type: 'link',
                style: 'outlined',
                value: section.settings.button_text,
                href: section.settings.button_url -%}
            {%- endif -%}
          </div><!-- /.container -->
        </div><!-- /.flex -->
      </div><!-- /.grid -->
    </div><!-- /.container -->
  </section><!-- /.section -->
{%- endif -%}

{% schema %}
{
  "name": "t:sections.image-and-text.name",
  "settings": [
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "flip_content",
      "label": "t:sections.image-and-text.settings.flip_content.label",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-and-text.settings.image.label"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "push_content_up",
      "label": "Align content higher",
      "default": false
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#B91F1C",
      "visible_if": "{{ section.settings.eyebrow != blank }}"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.image-and-text.settings.title.label",
      "default": "Heading goes here"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:sections.image-and-text.settings.content.label",
      "default": "<p>Content text goes here</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.image-and-text.settings.button_text.label",
      "default": "Link text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:sections.image-and-text.settings.button_url.label",
      "default": "/"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:sections.image-and-text.name"
    }
  ]
}
{% endschema %}
