{{- 'section-blog-category.css' | asset_url | stylesheet_tag -}}
{{- 'card-featured-article.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign _section = section.settings
  assign blog_ref = blog
  assign topics = blog_ref.metafields.custom.topics.value
  assign blog_tag_color = blog_ref.metafields.custom.tag_color

  comment
    Background: section setting > blog tag_color metafield > default
  endcomment
  assign bg_color = _section.background
  if bg_color == blank and blog_tag_color != blank
    assign bg_color = blog_tag_color
  endif
  if bg_color == blank
    assign bg_color = '#790200'
  endif
  assign bg_image = _section.background_image
  assign img_opacity = _section.image_opacity | default: 10 | divided_by: 100.0

  comment
    Get topic: first try article metafield, then fallback to tag matching
    Note: metafield may return a list, so get first item
  endcomment
  assign topic = blank
  assign pillar_title = blank
  assign filter_tag = blank

  if article != blank
    assign topic = article.metafields.custom.blog_topic.value | first

    comment
      Fallback: match article tags against blog topics
    endcomment
    if topic == blank and topics != blank
      for article_tag in article.tags
        for t in topics
          if t.tag == article_tag
            assign topic = t
            break
          endif
        endfor
        if topic != blank
          break
        endif
      endfor
    endif

    if topic != blank
      if topic.color != blank
        assign bg_color = topic.color
      endif
      assign pillar_title = topic.label
      assign filter_tag = topic.tag
    endif
  endif

  comment
    Breadcrumb: resolve pillar display title
  endcomment
  if article != blank and article.template_suffix == 'pillar'
    if pillar_title == blank
      assign pillar_title = article.title
    endif
  endif

  comment
    Featured article: section setting > most recent with matching topic tag (cross-blog) > blog metafield > first article
  endcomment
  assign featured = _section.featured_article
  if featured == blank and topics != blank
    for b in blogs
      for art in b.articles
        if article != blank and art.id == article.id
          continue
        endif
        if art.template_suffix == 'pillar' or art.tags contains 'pillar'
          continue
        endif
        for art_tag in art.tags
          assign tag_check = art_tag | append: ','
          assign found_match = false
          for topic in topics
            assign topic_tag_check = topic.tag | append: ','
            if tag_check == topic_tag_check
              assign found_match = true
              break
            endif
          endfor
          if found_match
            assign featured = art
            break
          endif
        endfor
        if featured != blank
          break
        endif
      endfor
      if featured != blank
        break
      endif
    endfor
  elsif featured == blank
    comment
      No topics configured - get most recent article from any blog
    endcomment
    for b in blogs
      for art in b.articles
        if article != blank and art.id == article.id
          continue
        endif
        if art.template_suffix == 'pillar' or art.tags contains 'pillar'
          continue
        endif
        assign featured = art
        break
      endfor
      if featured != blank
        break
      endif
    endfor
  endif
  if featured == blank
    assign featured = blog_ref.metafields.custom.featured_article.value
  endif
  if featured == blank
    assign featured = blog_ref.articles.first
  endif
-%}

{%- render 'blog-color-override', override_color: bg_color -%}

{%- capture hero_styles -%}
  {%- if bg_color != blank -%}--featured-color: {{ bg_color }};{%- endif -%}
  {%- if bg_color != blank -%}background: {{ bg_color }};{%- endif -%}
{%- endcapture -%}

<section
  class="blog-category-hero"
  {%- if hero_styles != blank -%}
    style="{{ hero_styles | strip }}"
  {%- endif -%}
>
  {%- if bg_image != blank -%}
    <div class="blog-category-hero__bg-media" style="opacity: {{ img_opacity }};">
      <img
        srcset="{%- render 'srcset', image: bg_image -%}"
        sizes="100vw"
        src="{{ bg_image | image_url: width: 1920 }}"
        loading="eager"
        alt=""
        width="{{ bg_image.width }}"
        height="{{ bg_image.height }}"
      >
    </div>
  {%- endif -%}

  <nav class="blog-breadcrumbs container" aria-label="{{- 'general.breadcrumbs.label' | t -}}" style="position: relative; z-index: 2; color: #fff;">
    <ol class="blog-breadcrumbs__list list-unstyled list-flex" role="list">
      <li>
        <a href="{{- routes.root_url -}}" class="inline-unstyled-link link-hover-fade">
          {{- 'general.breadcrumbs.home' | t -}}
        </a>
      </li>
      <li>
        {%- render 'icon', icon: 'chevron-right' -%}
      </li>
      {%- if pillar_title != blank -%}
        <li>
          <a href="{{- blog_ref.url -}}" class="inline-unstyled-link link-hover-fade">
            {{- blog_ref.title -}}
          </a>
        </li>
        <li>
          {%- render 'icon', icon: 'chevron-right' -%}
        </li>
        <li>
          <span>{{- pillar_title -}}</span>
        </li>
      {%- else -%}
        <li>
          <span>{{- blog_ref.title -}}</span>
        </li>
      {%- endif -%}
    </ol>
  </nav>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumbs.home' | t | json }},
        "item": "{{ shop.url }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog_ref.title | json }},
        "item": "{{ shop.url }}{{ blog_ref.url }}"
      }
      {%- if pillar_title != blank -%}
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ pillar_title | json }},
        "item": "{{ shop.url }}{{ article.url }}"
      }
      {%- endif -%}
    ]
  }
  </script>

  <div class="container" style="position: relative; z-index: 2;">
    <div class="blog-category-hero__grid">
      <!-- Featured Article Card -->
      <div class="blog-category-hero__featured">
        {%- liquid
          assign featured_tag = featured.tags | first
          if featured_tag != blank
            assign featured_tag = featured_tag | remove: 'Category_' | remove: 'category_' | replace: '_', ' ' | replace: '-', ' ' | upcase
          endif
        -%}
        {%- render 'card-featured-article',
          article_ref: featured,
          custom_tag: featured_tag
        -%}
      </div>

      <!-- Latest Articles List -->
      <div class="blog-category-hero__latest">
        <h3 class="blog-category-hero__latest-title caption uppercase">
          Latest Activities
        </h3>
        {%- assign latest_shown = 0 -%}
        {%- assign latest_shown_ids = '' -%}
        {%- if featured != blank -%}
          {%- assign latest_shown_ids = featured.id | append: ',' -%}
        {%- endif -%}
        {%- if article != blank -%}
          {%- assign latest_shown_ids = latest_shown_ids | append: article.id | append: ',' -%}
        {%- endif -%}

        {%- comment -%} Build topic tags list {%- endcomment -%}
        {%- assign hero_topic_tags = '' -%}
        {%- if topics != blank -%}
          {%- for topic in topics -%}
            {%- if topic.tag != blank -%}
              {%- assign hero_topic_tags = hero_topic_tags | append: topic.tag | append: ',' -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} First: current blog articles {%- endcomment -%}
        {%- for article_ref in blog_ref.articles -%}
          {%- if latest_shown >= _section.latest_count -%}{%- break -%}{%- endif -%}
          {%- if article_ref.template_suffix == 'pillar' or article_ref.tags contains 'pillar' -%}{%- continue -%}{%- endif -%}
          {%- assign id_check = article_ref.id | append: ',' -%}
          {%- if latest_shown_ids contains id_check -%}{%- continue -%}{%- endif -%}

          {%- assign tag_matched = false -%}
          {%- if hero_topic_tags != blank -%}
            {%- for tag in article_ref.tags -%}
              {%- assign tag_check = tag | append: ',' -%}
              {%- if hero_topic_tags contains tag_check -%}
                {%- assign tag_matched = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- unless tag_matched -%}{%- continue -%}{%- endunless -%}
          {%- endif -%}

          {%- if latest_shown > 0 -%}
            <div class="blog-category-hero__latest-separator"></div>
          {%- endif -%}
          <a href="{{ article_ref.url }}" class="blog-category-hero__latest-item">
            {%- assign latest_shown = latest_shown | plus: 1 -%}
            {%- assign latest_shown_ids = latest_shown_ids | append: id_check -%}
            <span class="blog-category-hero__latest-number">{{ latest_shown }}</span>
            <div class="blog-category-hero__latest-content">
              <span class="blog-category-hero__latest-name">{{ article_ref.title }}</span>
              <span class="blog-category-hero__latest-meta caption">
                {%- assign article_tag = article_ref.tags | first -%}
                {%- if article_tag != blank -%}
                  {{ article_tag | remove: 'Category_' | remove: 'category_' | replace: '_', ' ' | replace: '-', ' ' | upcase }} · {{ article_ref.metafields.custom.reading_time }}
                {%- else -%}
                  {{ article_ref.metafields.custom.reading_time }}
                {%- endif -%}
              </span>
            </div>
          </a>
        {%- endfor -%}

        {%- comment -%} Second: other blogs' articles {%- endcomment -%}
        {%- for b in blogs -%}
          {%- if latest_shown >= _section.latest_count -%}{%- break -%}{%- endif -%}
          {%- if b.handle == blog_ref.handle -%}{%- continue -%}{%- endif -%}
          {%- for article_ref in b.articles -%}
            {%- if latest_shown >= _section.latest_count -%}{%- break -%}{%- endif -%}
            {%- if article_ref.template_suffix == 'pillar' or article_ref.tags contains 'pillar' -%}{%- continue -%}{%- endif -%}
            {%- assign id_check = article_ref.id | append: ',' -%}
            {%- if latest_shown_ids contains id_check -%}{%- continue -%}{%- endif -%}

            {%- assign tag_matched = false -%}
            {%- if hero_topic_tags != blank -%}
              {%- for tag in article_ref.tags -%}
                {%- assign tag_check = tag | append: ',' -%}
                {%- if hero_topic_tags contains tag_check -%}
                  {%- assign tag_matched = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- unless tag_matched -%}{%- continue -%}{%- endunless -%}
            {%- endif -%}

            {%- if latest_shown > 0 -%}
              <div class="blog-category-hero__latest-separator"></div>
            {%- endif -%}
            <a href="{{ article_ref.url }}" class="blog-category-hero__latest-item">
              {%- assign latest_shown = latest_shown | plus: 1 -%}
              {%- assign latest_shown_ids = latest_shown_ids | append: id_check -%}
              <span class="blog-category-hero__latest-number">{{ latest_shown }}</span>
              <div class="blog-category-hero__latest-content">
                <span class="blog-category-hero__latest-name">{{ article_ref.title }}</span>
                <span class="blog-category-hero__latest-meta caption">
                  {%- assign article_tag = article_ref.tags | first -%}
                  {%- if article_tag != blank -%}
                    {{ article_tag | remove: 'Category_' | remove: 'category_' | replace: '_', ' ' | replace: '-', ' ' | upcase }} · {{ article_ref.metafields.custom.reading_time }}
                  {%- else -%}
                    {{ article_ref.metafields.custom.reading_time }}
                  {%- endif -%}
                </span>
              </div>
            </a>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Hero",
  "settings": [
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured article",
      "info": "Choose the featured article for this category page. Falls back to the blog's metafield, then to the newest article."
    },
    {
      "type": "range",
      "id": "latest_count",
      "min": 3,
      "max": 8,
      "default": 5,
      "label": "Latest articles count"
    },
    {
      "type": "text",
      "id": "filter_tag",
      "label": "Filter by tag",
      "info": "Only show articles with this tag (e.g. 'Category_arts-and-crafts'). Leave empty to show all."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background color / gradient",
      "info": "Defaults to the blog's tag colour metafield if left empty"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 10,
      "unit": "%",
      "label": "Background image opacity"
    }
  ]
}
{% endschema %}
