{%- liquid
  assign _section = section.settings
  assign _blocks = section.blocks
  assign video = _section.video | default: nil
  assign video_mobile = _section.video_mobile | default: video
-%}
{%- if section.settings.enable_filters or section.settings.enable_sorting -%}
  {{- 'component-facets.css' | asset_url | stylesheet_tag -}}
  <script src="{{- 'facets.js' | asset_url -}}" defer="defer"></script>
  <script src="{{- 'dropdown-input.js' | asset_url -}}" defer="defer"></script>
{%- endif -%}

{{- 'section-hero-banner-search.css' | asset_url | stylesheet_tag -}}
{{- 'main-collection-songs.css' | asset_url | stylesheet_tag -}}

<section class="hero-banner-search main-collection-songs">
  <div
    class="hero-banner-search__main"
    style="background: {{ _section.background }};"
  >
    <div class="container">
      <div
        class="hero__background"
        style="opacity: {{ _section.media_opacity | divided_by: 100.0 }};"
      >
        {%- if video != blank -%}
          {%- assign video_title = video.alt | default: _section.title -%}

          <div class="media media--16-9 hero__media media--transparent small-hide">
            {% render 'external-video', video: video, title: video_title %}
          </div><!-- /.media -->

          <div class="media media--16-9 hero__media media--transparent large-up-hide medium-hide">
            {% render 'external-video', video: video_mobile, title: video_title %}
          </div><!-- /.media -->

        {%- else -%}
          <div class="media media--16-9 hero__media media--transparent">
            {%-
              liquid
              if _section.image != blank
                assign image_mobile = _section.image_mobile | default: _section.image
                render 'image', image: _section.image, class: 'small-hide'
                render 'image', image: image_mobile, class: 'medium-hide large-up-hide'
              endif
            -%}
          </div><!-- /.media -->
        {%- endif -%}
      </div><!-- /.hero__background -->

      {%- if _section.overlay_color != blank and _section.overlay_opacity > 0 -%}
        {%- assign overlay_opacity = _section.overlay_opacity | divided_by: 100.0 -%}

        <div class="hero__overlay" style="background: {{ _section.overlay_color }}; opacity: {{ overlay_opacity }};"></div><!-- /.hero__overlay -->
      {%- endif -%}

      <div class="hero__inner">
        {%- if _section.title != blank -%}
          {%- liquid
            assign heading_tag = 'h2'
            if section.index == 1
              assign heading_tag = 'h1'
            endif
          -%}

          <{{ heading_tag }}
            class="hero__title h1"
            style="color: {{ _section.title_color }};"
          >
            <span>
              {{- _section.title | newline_to_br -}}
            </span>

            {%- if _section.enable_decoration -%}
              <i class="hero__title-decoration small-hide">
                {%- render 'icon', icon: 'heart-with-note' -%}
              </i>

              <i class="hero__title-decoration small small-hide">
                {%- render 'icon', icon: 'heart-with-note' -%}
              </i>
            {%- endif -%}
          </{{ heading_tag }}><!-- /.hero__title -->
        {%- endif -%}
      </div><!-- /.hero__inner -->
    </div><!-- /.container -->
  </div><!-- /.hero-banner-search__main -->

  <div class="hero-banner-search__charts">
    <div class="collection">
      <div class="container">
        <div class="collection__inner">
          {% comment %} {%- if section.settings.enable_filters -%}
            {%- render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filters,
              enable_sorting: section.settings.enable_sorting,
              section_id: section.id
            -%}
          {%- endif -%} {% endcomment %}

          {%- if section.settings.enable_filters or section.settings.enable_sorting -%}
            {%- render 'facets-bar',
              results: collection,
              enable_filtering: section.settings.enable_filters,
              enable_sorting: section.settings.enable_sorting,
              section_id: section.id,
              always_visible: true
            -%}
          {%- endif -%}

          {%- paginate collection.products by 5000 -%}
            <div class="collection-grid-container" id="ProductGridContainer">
              {%- if collection.products_count == 0 -%}
                <div class="center">
                  <h2 class="h3 regular">
                    {{- 'collection.empty' | t -}}<br>
                    {{- 'collection.use_fewer_filters_html' | t: link: collection.url, class: "link" -}}
                  </h2><!-- /.h3 regular -->
                </div><!-- /.center -->
              {%- else -%}
                <div class="collection__grid list-unstyled grid grid--3" role="list" id="product-grid" data-id="{{- section.id -}}">
                  {%- for product_ref in collection.products -%}
                    {%- render 'card-product-song', product_ref: product_ref, class: 'grid__item', collection_ref: collection, append_text: _section.append_title_text -%}
                  {%- endfor -%}
                </div><!-- /#product-grid.collection__grid list-unstyled grid grid--4 -->

                {%- if paginate.pages > 1 -%}
                  {%- render 'pagination', paginate: paginate, anchor: '' -%}
                {%- endif -%}
              {%- endif -%}
            </div><!-- /.collection-grid-container -->
          {%- endpaginate -%}
        </div>
      </div><!-- /.container -->
    </div><!-- /.collection -->
  </div><!-- /.hero-banner-search__charts -->
</section>

{% schema %}
  {
    "name": "t:sections.main-collection.name",
    "settings": [
      {
        "type": "text",
        "id": "append_title_text",
        "label": "Append custom text to title"
      },
      {
        "type": "color_background",
        "id": "background",
        "label": "Background",
        "default": "radial-gradient(50% 50% at 50% 50%, #B91F1C 0%, #781D1B 100%)"
      },
      {
        "type": "paragraph",
        "content": "t:sections.hero-banner.settings.background_paragraph.content"
      },
      {
        "type": "range",
        "id": "media_opacity",
        "label": "Media opacity",
        "unit": "%",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 5
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "t:sections.hero-banner.settings.image.desktop.label"
      },
      {
        "type": "image_picker",
        "id": "image_mobile",
        "label": "t:sections.hero-banner.settings.image.mobile.label",
        "info": "t:sections.hero-banner.settings.image.mobile.info"
      },
      {
        "type": "video_url",
        "id": "video",
        "accept": [
          "youtube",
          "vimeo"
        ],
        "info": "t:sections.hero-banner.settings.video.desktop.info",
        "label": "t:sections.hero-banner.settings.video.desktop.label"
      },
      {
        "type": "video_url",
        "id": "video_mobile",
        "accept": [
          "youtube",
          "vimeo"
        ],
        "label": "t:sections.hero-banner.settings.video.mobile.label",
        "info": "t:sections.hero-banner.settings.video.mobile.info"
      },
      {
        "type": "color_background",
        "id": "overlay_color",
        "label": "t:sections.hero-banner.settings.background_overlay.color.label",
        "default": "radial-gradient(50% 50% at 50% 50%, #B91F1C 0%, #781D1B 100%)"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "t:sections.hero-banner.settings.background_overlay.opacity.label",
        "unit": "%",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 20
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "checkbox",
        "id": "enable_decoration",
        "label": "Enable decoration",
        "default": true
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Heading color",
        "default": "#fff"
      },
      {
        "type": "textarea",
        "id": "title",
        "label": "t:sections.hero-banner.settings.title.label",
        "default": "Connecting the World \nThrough Music"
      },
      {
        "type": "header",
        "content": "t:sections.main-collection.settings.header.filters_and_sorting.content"
      },
      {
        "type": "checkbox",
        "id": "enable_filters",
        "label": "t:sections.main-collection.settings.enable_filters.label",
        "default": true,
        "info": "t:sections.main-collection.settings.enable_filters.info"
      },
      {
        "type": "checkbox",
        "id": "enable_sorting",
        "label": "t:sections.main-collection.settings.enable_sorting.label",
        "default": true,
        "info": "t:sections.main-collection.settings.enable_sorting.info"
      },
      {
        "type": "header",
        "content": "t:sections.main-collection.settings.header.products_grid.content"
      },
      {
        "type": "range",
        "id": "products_per_page",
        "min": 8,
        "max": 24,
        "step": 4,
        "label": "t:sections.main-collection.settings.products_per_page.label",
        "default": 16
      }
    ]
  }
{% endschema %}
