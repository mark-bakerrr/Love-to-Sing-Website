{%- comment -%}
  Love to Sing - licence builder "Add songs & videos" results (screen 2).

  Never placed on a template: the licence builder fetches it via the Section
  Rendering API, either from storefront search or from a collection, e.g.
    /search?q=pohu&type=product&options[unavailable_products]=hide&section_id=lts-licence-picker-results
    /collections/kids-song-lyrics?section_id=lts-licence-picker-results&page=2
  and appends the rows from .lts-lb-results. [data-has-next] tells the JS whether
  a "Load more" page exists.
  In product context (/products/<handle>?section_id=lts-licence-picker-results,
  the builder's ?song= deep link) it returns that product's row plus its main
  video (custom.song_video_product), each only if pickable. Styling lives in sections/lts-licence-builder.liquid;
  the pickable rule lives in snippets/lts-picker-row.liquid.
{%- endcomment -%}
{%- assign has_next = false -%}
<ul class="lts-lb-results" role="list">
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {%- render 'lts-picker-row', product: item, source: 'search' -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}{%- assign has_next = true -%}{%- endif -%}
    {%- endpaginate -%}
  {%- elsif collection -%}
    {%- paginate collection.products by 24 -%}
      {%- for p in collection.products -%}
        {%- render 'lts-picker-row', product: p, source: 'browse' -%}
      {%- endfor -%}
      {%- if paginate.next -%}{%- assign has_next = true -%}{%- endif -%}
    {%- endpaginate -%}
  {%- elsif product -%}
    {%- render 'lts-picker-row', product: product, source: 'deeplink' -%}
    {%- assign main_video = product.metafields.custom.song_video_product.value -%}
    {%- if main_video -%}
      {%- render 'lts-picker-row', product: main_video, source: 'deeplink' -%}
    {%- endif -%}
  {%- endif -%}
</ul>
<div data-has-next="{{ has_next }}" hidden></div>

{% schema %}
{
  "name": "Licence picker results",
  "settings": []
}
{% endschema %}
