<style>
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .feature-columns-section {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .feature-columns-section.border-bottom {
    border-bottom: 1px solid var(--c-neutral-200);
  }

  .feature-header {
    text-align: center;
    margin-bottom: 6.4rem;
  }

  .feature-header__title {
    font-weight: 600;
    margin: 0 0 1.6rem 0;
  }

  .feature-header__subtitle {
    max-width: 70ch;
    margin: 0 auto;
    font-size: var(--fz-l);
  }

  .feature-header__subtitle p {
    margin: 0;
    padding: 0;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 3 }}, 1fr);
    gap: 5.6rem;
  }

  .feature-column__image-wrapper {
    overflow: hidden;
    border-radius: var(--radius-s);
    margin-bottom: 3.2rem;
  }

  .feature-column__image,
  .feature-column__image-wrapper .placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .feature-column a:hover .feature-column__image {
    transform: scale(1.05);
  }

  .feature-column__heading {
    margin: 0 0 0.5rem 0;
  }

  .feature-column__text {
  }

  .feature-column__text p {
    margin: 0;
    padding: 0;
  }

  @media (max-width: 989px) {
    .feature-grid {
      {% if section.blocks.size > 2 %}
        grid-template-columns: 1fr 1fr;
      {% endif %}
    }
  }

  @media (max-width: 749px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="feature-columns-section{% if section.settings.border_bottom %} border-bottom{% endif %}">
  <div class="container">
    <div class="feature-header">
      {%- if section.settings.title != blank -%}
        <h2 class="feature-header__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <div class="feature-header__subtitle rte">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="feature-grid">
        {%- for block in section.blocks -%}
          <div class="feature-column" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: "#" }}" class="feature-column__link">
              <div class="feature-column__image-wrapper">
                {%- if block.settings.image != blank -%}
                  <div class="feature-column__image media">
                    {%- render 'image', image: block.settings.image -%}
                  </div><!-- /.feature-column__image -->
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </a>

            {%- if block.settings.heading != blank -%}
              <h3 class="feature-column__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="feature-column__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature Columns",
  "tag": "section",
  "class": "section-feature-columns",
  "settings": [
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Add border bottom",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Unlock the Power of Features"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>This is a brief and engaging description of the features you are highlighting below.</p>"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature_column",
      "name": "Feature Column",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this text to share information about your feature. Describe a product, share announcements, or welcome customers to your store.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Columns",
      "blocks": [
        {
          "type": "feature_column",
          "settings": {
            "heading": "Peace of Mind"
          }
        },
        {
          "type": "feature_column",
          "settings": {
            "heading": "Give Back to Creators"
          }
        },
        {
          "type": "feature_column",
          "settings": {
            "heading": "Bring Programs to Life"
          }
        }
      ]
    }
  ]
}
{% endschema %}
