{%- liquid
  assign _section = section.settings
  echo 'component-collection-hero.css' | asset_url | stylesheet_tag

  assign breadcrumbs_menu = settings.breadcrumbs_map
-%}

<div
  class="collection-hero {% if section.index == 1 %} first-section{% endif %}"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  <div class="container">
    <div class="collection-hero__wrapper">
      <div class="collection-hero__breadcrumbs">
        <nav role="navigation" aria-label="{{- 'general.breadcrumbs.label' | t -}}">
          {%- render 'breadcrumbs-from-nav', breadcrumbs_menu: breadcrumbs_menu -%}
        </nav>
      </div><!-- /.collection-hero__breadcrumbs -->

      <h1 class="collection-hero__title ">
        <span class="visually-hidden">{{- 'collection.title' | t -}}: </span>
        {{- _section.heading | default: collection.title | escape -}}
      </h1><!-- /.collection-hero__title h2 -->

      {%- if collection.description != blank or _section.content != blank -%}
        <div class="collection-hero__entry">
          {{- _section.content | default: collection.description -}}
        </div><!-- /.collection-hero__entry -->
      {%- endif -%}
    </div><!-- /.collection-hero__wrapper -->
    <!-- /.grid -->
  </div><!-- /.container -->
</div><!-- /.collection-hero -->

{% schema %}
  {
    "name": "t:sections.collection-hero.name",
    "settings": [
      {
        "type": "color_background",
        "id": "background_color",
        "label": "Background color",
        "default": "#FDEFEF"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#000000"
      },
      {
        "type": "header",
        "content": "Custom content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Title"
      },
      {
        "type": "text",
        "id": "content",
        "label": "Content"
      }
    ]
  }
{% endschema %}
