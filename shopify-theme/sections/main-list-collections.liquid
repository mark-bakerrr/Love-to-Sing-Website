{%- liquid
  content_for "block", type: "spacing", id: "list-collections-spacing"

  echo 'list-collections.css' | asset_url | stylesheet_tag
-%}

<section class="list-collections">
  <div class="container">
    <div class="spacer">
      {%- render 'breadcrumbs' -%}
    </div><!-- /.spacer -->

    {%- paginate collections by 12 -%}
      <ul class="grid grid--3 list-unstyled" role="list">
        {%- for collection in collections -%}
          <li class="grid__item">
            {%- render 'card-collection', collection_ref: collection -%}
          </li><!-- /.grid__item -->
        {%- else -%}
          <li class="grid__item">
            <p>{{- 'list_collections.empty' | t -}}</p>
          </li><!-- /.grid__item -->
        {%- endfor -%}
      </ul><!-- /.grid list-unstyled -->

      {%- if paginate.pages > 1 -%}
        <div class="spacer">
          {%- render 'pagination', paginate: paginate, anchor: '' -%}
        </div><!-- /.spacer -->
      {%- endif -%}
    {%- endpaginate -%}
  </div><!-- /.container -->
</section><!-- /.list-collections -->

{% schema %}
  {
    "name": "List collections",
    "settings": []
  }
{% endschema %}
