{%- assign product_form_id = 'product-form-' | append: section.id -%}

{{- 'section-product.css' | asset_url | stylesheet_tag -}}

{%- if product.media.size > 1 -%}
  {{- 'swiper-bundle.min.css' | asset_url | stylesheet_tag -}}

  <script src="{{- 'swiper-bundle.min.js' | asset_url -}}" defer="defer"></script>
{%- endif -%}

{%- if product.media.size > 0 -%}
  <script src="{{- 'product-modal.js' | asset_url -}}" defer="defer"></script>
  {%- if product.media.size > 1 -%}
    <script src="{{- 'product-media.js' | asset_url -}}" defer="defer"></script>
  {%- endif -%}
{%- endif -%}
<script src="{{- 'main-product-selector.js' | asset_url -}}" defer="defer"></script>

{{- 'collapsible-tab.css' | asset_url | stylesheet_tag -}}
<script src="{{- 'collapsible-tab.js' | asset_url -}}" defer="defer"></script>

<section class="product" id="MainProduct-{{- section.id -}}" data-section="{{- section.id -}}">
  <div class="container container">
    <div class="grid grid--2">
      {%- if product.media.size > 0 -%}
        <div class="grid__item overflow-hidden">
          {%- liquid
            assign is_video = false
            assign video = blank
            assign thumbnail = blank

            if product.media.size == 2
              for media in product.media
                if media.media_type == "external_video"
                  assign video = media
                endif
                if media.media_type == "image"
                  assign thumbnail = media | image_url: width: 1200
                endif
              endfor
            endif

            if video != blank and thumbnail != blank
              assign is_video = true
            endif
          -%}

          {%- if is_video -%}
            {{- 'youtube-player.css' | asset_url | stylesheet_tag -}}
            <script src="{{- 'youtube-player.js' | asset_url -}}" defer></script>

            {% render 'youtube-player', video_id: video.external_id, thumbnail: thumbnail, class: 'youtube-player--large' %}
          {%- else -%}
            <product-media class="product__media">
              {%- if product.media.size > 1 -%}
                <div class="product__media-thumbs small-hide medium-hide">
                  <div class="swiper" data-thumbs>
                    <div class="swiper-wrapper">
                      {%- for media in product.media -%}
                        <div class="swiper-slide">
                          {%- render 'product-thumbnail', media: media, modal_id: section.id -%}
                        </div><!-- /.swiper-slide -->
                      {%- endfor -%}
                    </div><!-- /.swiper-wrapper -->
                  </div><!-- /.swiper -->

                  <button class="swiper-arrow thumb-arrow--prev">
                    {% render 'icon-product-media-prev' %}
                  </button><!-- /.swiper-arrow -->

                  <button class="swiper-arrow thumb-arrow--next">
                    {% render 'icon-product-media-next' %}
                  </button><!-- /.swiper-arrow -->
                </div><!-- /.product__media-thumbs -->

                <div class="product__media-slider">
                  <div class="swiper" data-slider>
                    <div class="swiper-wrapper">
                      {%- for media in product.media -%}
                        <div
                          class="swiper-slide"
                          data-media-id="{{- media.id -}}"
                          data-index="{{- forloop.index0 -}}"
                          {% if media.id == product.selected_variant.featured_media.id %}
                            data-selected
                          {% endif %}
                        >
                          {%- render 'product-media', media: media, modal_id: section.id -%}
                        </div><!-- /.swiper-slide -->
                      {%- endfor -%}
                    </div><!-- /.swiper-wrapper -->

                    <div class="swiper-arrows">
                      <button class="swiper-arrow swiper-arrow--prev">
                        {% render 'icon-product-media-prev' %}
                      </button><!-- /.swiper-arrow -->

                      <button class="swiper-arrow swiper-arrow--next">
                        {% render 'icon-product-media-next' %}
                      </button><!-- /.swiper-arrow -->

                    </div><!-- /.swiper-arrows -->

                    <div class="swiper-pagination large-up-hide"></div><!-- /.swiper-pagination -->
                  </div><!-- /.swiper -->
                </div><!-- /.product__media-slider swiper -->
              {%- else -%}
                {%- render 'product-media', media: product.featured_media, modal_id: section.id -%}
              {%- endif -%}
            </product-media><!-- /.product__media -->
          {%- endif -%}
        </div><!-- /.grid__item -->
      {%- endif -%}

      <div class="grid__item">
        <div class="product__content">
          <div class="product__selector" id="ProductSelector-{{- section.id -}}">
            <main-product-selector
              class="product-selector"
              data-url="{{- product.url | within: collection -}}"
              data-section-id="{{- section.id -}}"
              data-form-id="{{ product_form_id }}"
              data-price-id="price-{{- section.id -}}"
            >
              <p class="caption color-red hidden" data-error-wrapper></p><!-- /.caption color-red -->

              <script type="application/json" data-variants-json>
                {{- product.variants | json -}}
              </script>

              <script type="application/json" data-variants-prices>
                [
                  {%- for variant in product.variants -%}
                    {%- capture price_html -%}
                      {% render 'price', product_ref: product, variant: variant, use_variant: true %}
                    {%- endcapture -%}
                    {
                      "id": {{ variant.id | json }},
                      "price_html": {{ price_html | json }},
                      "price_single": {{ variant.price | money | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              </script>

              {%- form 'product', product, id: product_form_id, class: 'product__form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{- product.selected_or_first_available_variant.id -}}">

                <div class="product__blocks">
                  {%- for block in section.blocks -%}
                    {%- case block.type -%}
                      {%- when 'breadcrumbs' -%}
                        <div class="product__breadcrumbs product__block" {{ block.shopify_attributes }}>
                          {%- liquid
                            assign breadcrumbs_menu = settings.breadcrumbs_map
                            assign meta_collection = product.metafields.custom.breadcrumbs_collection.value
                            assign current_collection = meta_collection

                            unless current_collection
                              for collection_ref in product.collections
                                if collection_ref.handle != 'all' and collection_ref.handle != 'all-1'
                                  assign current_collection = collection_ref
                                  break
                                endif
                              endfor
                            endunless
                          -%}

                          <nav role="navigation" aria-label="{{- 'general.breadcrumbs.label' | t -}}">
                            {% render 'breadcrumbs-from-nav', breadcrumbs_menu: breadcrumbs_menu, current_collection: current_collection %}
                          </nav>
                        </div><!-- /.product__breadcrumbs -->
                      {%- when 'title' -%}
                        <h1 class="h3 product__title product__block-small" {{ block.shopify_attributes }}>
                          {{- product.title | escape -}}
                        </h1><!-- /.h3 product__title -->
                      {%- when 'price' -%}
                        <div class="product__price product__block-small h5" id="price-{{- section.id -}}" role="status" {{ block.shopify_attributes }}>
                          {%- render 'price', product_ref: product, use_variant: true -%}
                        </div><!-- /.product__price h6 -->
                      {%- when 'description' -%}
                        {%- if block.settings.text != blank -%}
                          <div class="product__description rte product__block-small" {{ block.shopify_attributes }}>
                            {{- block.settings.text -}}
                          </div><!-- /.product__description -->
                        {%- endif -%}
                      {%- when 'variant_selector' -%}
                        {% render 'variant-selector', block: block %}
                      {%- when 'buy_buttons' -%}
                        <div class="product__actions product__block" {{ block.shopify_attributes }}>
                          {%-
                            liquid
                            assign value = 'products.product.sold_out' | t
                            assign disabled = true
                            if product.selected_or_first_available_variant.available
                              assign value = 'products.product.add_to_cart' | t
                              assign disabled = false
                            endif
                            capture icon
                              render 'icon-cart'
                            endcapture
                            render 'button', type: 'submit', name: 'add', value: value, class: 'product-selector__submit', disabled: disabled, custom_icon: icon, icon_position: 'left'
                            assign value = nil
                            assign disabled = nil
                          -%}

                          {%- if additional_checkout_buttons -%}
                            {{ content_for_additional_checkout_buttons }}
                          {%- endif -%}
                        </div><!-- /.product__actions -->
                      {%- when 'quantity' -%}
                        <div class="product-selector__quantity product__block-small" {{ block.shopify_attributes }}>
                          {%- render 'quantity-input', product_ref: product, custom_label: block.settings.custom_label -%}
                        </div><!-- /.product-selector__quantity -->
                      {%- when 'divider' -%}
                        <div class="product__divider product__block" {{ block.shopify_attributes }}>
                          &nbsp;
                        </div><!-- /.product__divider -->
                      {%- when 'collapsible_tabs' -%}
                        {%- liquid
                          assign icon = block.settings.icon
                          assign title = block.settings.title
                          assign content = block.settings.content
                          assign add_space_above = block.settings.add_space_above
                          assign open_by_default = block.settings.open_by_default
                        -%}

                        {%- if title != blank and content != blank -%}
                          <div class="product__collapsible {%- if add_space_above %} product__block-large{%- endif -%}" {{ block.shopify_attributes }}>
                            {% render 'collapsible-tab', icon: icon, title: title, content: content, open_by_default: open_by_default %}
                          </div><!-- /.product__collapsible -->
                        {%- endif -%}
                      {%- when 'metadata' -%}
                        {%- liquid
                          assign meta = product.metafields.custom
                          assign duration = meta.duration
                          assign file_size = meta.file_size
                          assign ad_free = meta.ad_free.value
                        -%}

                        <div class="product__metadata product__block" {{ block.shopify_attributes }}>
                          <ul class="product__metadata-list">
                            <li>
                              {% render 'icon-resolution' %}

                              {{- 'video.resolution' | t -}}
                            </li>

                            {%- if duration != blank -%}
                              <li>
                                {% render 'icon-duration' %}

                                {{- duration | escape -}}
                              </li>
                            {%- endif -%}

                            {%- if file_size != blank -%}
                              <li>
                                {% render 'icon-size' %}

                                {{- file_size | escape -}}
                              </li>
                            {%- endif -%}

                            <li>
                              {% render 'icon-format' %}

                              {{- 'video.file_format' | t -}}
                            </li>

                            {%- if ad_free != blank -%}
                              <li class="product__metadata-item">
                                {% render 'icon-ad-free' %}

                                {{- 'video.ad_free' | t -}}
                              </li>
                            {%- endif -%}
                          </ul><!-- /.product__metadata-list -->
                        </div><!-- /.product__metadata -->
                      {%- when 'album_metadata' -%}
                        {%- liquid
                          assign artist_name = product.metafields.album.artist_name
                          assign track_count = product.metafields.album.track_count
                          assign release_date = product.metafields.album.release_date
                        -%}

                        {%- if artist_name != blank or track_count != blank or release_date != blank -%}
                          <div class="product__metadata product__block" {{ block.shopify_attributes }}>
                            <ul class="product__metadata-list">
                              {%- if artist_name != blank -%}
                                <li>
                                  {% render 'icon-artist-name' %}

                                  {{- artist_name | escape -}}
                                </li>
                              {%- endif -%}

                              {%- if track_count != blank -%}
                                <li>
                                  {% render 'icon-track-count' %}

                                  {%- if track_count == 1 -%}
                                    {{- 'album.track_count_single' | t -}}
                                  {%- else -%}
                                    {{- 'album.track_count_many' | t: count: track_count -}}
                                  {%- endif -%}
                                </li>
                              {%- endif -%}

                              {%- if release_date != blank -%}
                                <li>
                                  {% render 'icon-release-date' %}

                                  {{- release_date | split: '/' | last -}}
                                </li>
                              {%- endif -%}
                            </ul><!-- /.product__metadata-list -->
                          </div><!-- /.product__metadata -->
                        {%- endif -%}
                      {%- when 'tracklist' -%}
                        {% comment %}
                          <!-- Single App Styles -->
                        {% endcomment %}
                        {{ 'single-base.css' | asset_url | stylesheet_tag }}
                        {{ 'single-music.css' | asset_url | stylesheet_tag }}

                        {% comment %}
                          <!-- jQuery -->
                        {% endcomment %}
                        {{ '//ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.min.js' | script_tag }}

                        {% assign collection_key = product.metafields.album.collection_handle %}
                        {% assign products = collections[collection_key].products %}

                        {% capture productsExist -%}
                          {%- if products != '' and products.length != 0 %}true{% endif -%}
                        {%- endcapture %}

                        {% if product.metafields.album.track_count != 1 and productsExist == 'true' %}
                          <div
                            id="playlist"
                            class="single-tracklist product__block-large"
                          >
                            {%- assign track_index = 0 -%}
                            {% for track in products %}
                              {% if track.type == 'Digital Track' %}
                                {%- assign track_index = track_index | plus: 1 -%}
                                {% render 'single-music-track' track: track, index: track_index %}
                              {% endif %}
                            {% endfor %}
                          </div>
                        {% endif %}

                        <!-- Footer Player -->
                        {% assign now = 'now' | date: '%s' | plus: 0 %}

                        {% for track in products %}
                          {% capture trackReleaseDateString %}{{ track.metafields.track.release_date }}{% endcapture %}
                          {% assign trackDateParts = trackReleaseDateString | split: '/' %}
                          {% capture trackReleaseDateFormatted -%}
                            {{- trackDateParts[2] }}-{{ trackDateParts[0] }}-{{ trackDateParts[1] -}}
                          {%- endcapture %}
                          {% assign trackReleaseDate = trackReleaseDateFormatted | date: '%s' | plus: 0 %}
                          {%- if trackReleaseDate <= now %}
                            {%- if track.metafields.track.preview == 'true' %}
                              {% assign enablePlayer = 'true' %}
                            {% endif -%}
                          {% endif -%}
                        {% endfor %}

                        {% if enablePlayer == 'true' %}
                          {% render 'single-music-footer-player' %}
                        {% endif %}

                        {% render 'single-base-ajaxify' %}
                      {%- when '@app' -%}
                        <div class="product__app-block product__block-small" {{ block.shopify_attributes }}>
                          {%- render block -%}
                        </div><!-- /.product__app-block -->
                    {%- endcase -%}
                  {%- endfor -%}
                </div><!-- /.product__blocks -->
              {%- endform -%}
            </main-product-selector><!-- /.product-selector -->
          </div><!-- /.product__selector -->
        </div><!-- /.product__content -->
      </div><!-- /.grid__item -->
    </div><!-- /.grid -->
  </div><!-- /.container -->
</section><!-- /.product -->

{%- if product.media.size > 0 -%}
  <product-modal id="ProductModal-{{- section.id -}}" class="product-gallery">
    <div
      class="product-gallery__dialog"
      role="dialog"
      tabindex="-1"
      aria-label="{{- 'products.product.modal.label' | t -}}"
      aria-modal="true"
    >
      <button
        id="ModalClose-{{- section.id -}}"
        type="button"
        class="product-gallery__close"
        aria-label="{{- 'accessibility.close' | t -}}"
      >{% render 'icon-close' %}</button>

      <div
        class="product__gallery-content"
        role="document"
        aria-label="{{- 'products.product.modal.label' | t -}}"
        tabindex="0"
      >
        {%- for media in product.media -%}
          {% render 'product-media', media: media, is_gallery_media: true %}
        {%- endfor -%}
      </div><!-- /.product__gallery-content -->
    </div><!-- /.product-gallery__dialog -->
  </product-modal>
{%- endif -%}

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>



{% schema %}
  {
    "name": "t:sections.main-product.name",
    "settings": [],
    "blocks": [
      {
        "type": "breadcrumbs",
        "name": "Breadcrumbs",
        "limit": 1
      },
      {
        "type": "title",
        "name": "Title",
        "limit": 1
      },
      {
        "type": "price",
        "name": "Price",
        "limit": 1
      },
      {
        "type": "description",
        "name": "Description",
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text"
          }
        ],
        "limit": 1
      },
      {
        "type": "variant_selector",
        "name": "Variant Selector",
        "limit": 1
      },
      {
        "type": "buy_buttons",
        "name": "Buy Buttons",
        "limit": 1
      },
      {
        "type": "quantity",
        "name": "Quantity",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "custom_label",
            "label": "Custom label"
          }
        ]
      },
      {
        "type": "divider",
        "name": "Divider"
      },
      {
        "type": "collapsible_tabs",
        "name": "Collapsible Tabs",
        "settings": [
          {
            "type": "checkbox",
            "id": "add_space_above",
            "label": "Add space above",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "open_by_default",
            "label": "Open by default",
            "default": false
          },
          {
            "type": "textarea",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Collapsible tab",
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Content",
            "default": "<p>Collapsible tab content</p>"
          }
        ]
      },
      {
        "type": "metadata",
        "name": "Metadata",
        "limit": 1
      },
      {
        "type": "album_metadata",
        "name": "Album Metadata",
        "limit": 1
      },
      {
        "type": "tracklist",
        "name": "Tracklist",
        "limit": 1
      },
      {
        "type": "@app"
      }
    ]
  }
{% endschema %}
