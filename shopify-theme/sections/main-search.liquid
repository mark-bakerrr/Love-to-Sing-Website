{%- liquid
  content_for "block", type: "spacing", id: "main-collection"
-%}

{%- if search.performed -%}
  {%- liquid
    assign is_song_scope = false
    assign clean_terms = search.terms

    if search.terms contains 'tag:song'
      assign is_song_scope = true
      assign clean_terms = search.terms | remove: 'tag:song' | strip
    endif
  -%}

  {{- 'component-search-results.css' | asset_url | stylesheet_tag -}}
  <script src="{{- 'search-chips.js' | asset_url -}}" defer="defer"></script>
  <script src="{{- 'main-collection.js' | asset_url -}}" defer="defer"></script>

  <section class="section-search">
    <div class="container">
      {%- if is_song_scope -%}
        <header class="search-song-scope__header">
          <h1 class="h2">{{- 'search.song_scope_title' | t: terms: clean_terms -}}</h1>
        </header>

        {%- paginate search.results by 24 -%}
          {%- if search.results_count == 0 -%}
            <div class="search-empty center">
              <h2 class="h3 regular">
                {{- 'search.empty_with_terms' | t: terms: clean_terms -}}<br>
                {{- 'search.change_search_terms' | t -}}
              </h2>
            </div>
          {%- else -%}
            <div class="collection__grid list-unstyled grid grid--3 main-color-red" role="list">
              {%- for product_ref in search.results -%}
                {%- if product_ref.object_type == 'product' -%}
                  {%- render 'card-product-song', product_ref: product_ref, class: 'grid__item', append_text: 'Lyrics' -%}
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              {%- render 'pagination', paginate: paginate, anchor: '' -%}
            {%- endif -%}
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        {%- comment -%} Mode A: mixed results — chips + vertical list, filled in Rounds B/C/D {%- endcomment -%}
        {%- paginate search.results by 16 -%}
          <main-collection class="collection" data-section-id="{{ section.id }}">
            {%- liquid
              assign songs_has = false
              assign shop_has = false
              assign blog_has = false
              for r in search.results
                if r.object_type == 'product' and r.tags contains 'song'
                  assign songs_has = true
                elsif r.object_type == 'product'
                  assign shop_has = true
                elsif r.object_type == 'article'
                  assign blog_has = true
                endif
              endfor
            -%}

            {%- if search.results_count == 0 -%}
              <div class="search-empty center">
                <h2 class="h3 regular">
                  {{- 'search.empty_with_terms' | t: terms: clean_terms -}}<br>
                  {{- 'search.change_search_terms' | t -}}
                </h2>
              </div>
            {%- else -%}
              <nav class="search-chips" aria-label="Filter by type" data-search-chips>
                <button type="button" class="search-chip is-active" data-chip="all" aria-pressed="true">
                  {{- 'search.chip.all' | t -}}
                </button>
                <button type="button" class="search-chip{% unless songs_has %} is-disabled{% endunless %}" data-chip="song" aria-pressed="false"{% unless songs_has %} disabled{% endunless %}>
                  {{- 'search.chip.songs' | t -}}
                </button>
                <button type="button" class="search-chip{% unless shop_has %} is-disabled{% endunless %}" data-chip="shop" aria-pressed="false"{% unless shop_has %} disabled{% endunless %}>
                  {{- 'search.chip.shop' | t -}}
                </button>
                <button type="button" class="search-chip{% unless blog_has %} is-disabled{% endunless %}" data-chip="blog" aria-pressed="false"{% unless blog_has %} disabled{% endunless %}>
                  {{- 'search.chip.blog' | t -}}
                </button>
              </nav>

              <p class="search-chip-empty" data-search-chip-empty data-template="{{- 'search.empty_for_chip' | t: type: '%%TYPE%%', terms: '%%TERMS%%' | escape -}}" hidden></p>

              <ul class="search-results list-unstyled" data-search-results id="product-grid">
                {%- for result in search.results -%}
                  <li class="search-results__item">{%- render 'card-search-result', result: result -%}</li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 and paginate.next -%}
                <div class="search-results__load-more">
                  {%- liquid
                    assign button_label = 'blog.show_more' | t
                    assign next_url = paginate.next.url | default: ''
                    capture attr
                      echo 'main-collection="show-more"'
                      echo ' data-next="'
                      echo next_url
                      echo '"'
                      echo ' data-label="'
                      echo button_label
                      echo '"'
                    endcapture
                    render 'button', type: 'button', style: 'primary', value: button_label, attr: attr
                  -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          </main-collection>
        {%- endpaginate -%}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
  {
    "name": "t:sections.main-search.name"
  }
{% endschema %}
