{{- 'section-header.css' | asset_url | stylesheet_tag -}}
{{- 'megamenu.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'header-megamenu.js' | asset_url }}" defer="defer"></script>

{%- if settings.enable_predictive_search -%}
  <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">

  <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign _section = section.settings
  assign _blocks = section.blocks
  assign current_template = template.name | append: '.' | append: template.suffix
  assign menu_blocks = _blocks | where: "type", "mega_menu"
  assign solid_color_blocks = _blocks | where: "type", "solid_header"

  comment
    Find current template has solid color.
  endcomment
  assign is_solid = false

  for block in solid_color_blocks
    assign _block = block.settings
    assign template_list = _block.title | newline_to_br | split: '<br />'

    # Go through all templates
    for block_template in template_list
      assign _block_template = block_template | strip_newlines

      unless _block_template contains '.'
        assign _block_template = _block_template | append: '.'
      endunless

      if current_template == _block_template
        assign is_solid = true

        break
      endif
    endfor

    if is_solid
      break
    endif
  endfor

  comment
    Find if custom logo is set for current template.
  endcomment
  assign custom_logo = ''
  assign logo_blocks = _blocks | where: "type", "custom_template_logo"

  for block in logo_blocks
    assign _block = block.settings
    assign template_list = _block.title | newline_to_br | split: '<br />'

    # Go through all templates
    for block_template in template_list
      assign _block_template = block_template | strip_newlines

      unless _block_template contains '.'
        assign _block_template = _block_template | append: '.'
      endunless

      if current_template == _block_template
        assign custom_logo = _block.logo

        break
      endif
    endfor

    if custom_logo != ''
      break
    endif
  endfor

  comment
    Find if custom color scheme is set for current template.
  endcomment
  assign custom_color_scheme = ''
  assign color_scheme = section.settings.main_colors
  assign color_scheme_blocks = _blocks | where: "type", "custom_color_scheme"

  for block in color_scheme_blocks
    assign _block = block.settings
    assign template_list = _block.title | newline_to_br | split: '<br />'

    # Go through all templates
    for block_template in template_list
      assign _block_template = block_template | strip_newlines

      unless _block_template contains '.'
        assign _block_template = _block_template | append: '.'
      endunless

      if current_template == _block_template
        assign custom_color_scheme = _block.color_scheme

        break
      endif
    endfor

    if custom_color_scheme != ''
      break
    endif
  endfor

  if custom_color_scheme != ''
    assign color_scheme = custom_color_scheme
  endif

  assign class = ''
  if product and product.metafields.custom.main_color != blank
    assign class = class | append: 'main-color-' | append: product.metafields.custom.main_color | downcase
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    position: fixed;
    width: 100%;
    top: 0;
    z-index: calc(var(--z-modals) - 1 );
  }
{%- endstyle -%}

<header
  class="header color-{{ color_scheme }}{% if is_solid %} header--solid {{ class }}{% endif %}{% if section.settings.floating_header %} header--floating{% endif %}"
  style="--logo-width: {{ section.settings.logo_width | default: 108 }}px;--logo-width-mobile: {{ section.settings.logo_width_mobile | default: 76 }}px;"
>
  <div class="container container--fullwidth">
    <div class="header__inner">
      {%- if linklists[section.settings.menu].links.size > 0 -%}
        {%- render 'navigation-mobile', menu: linklists[section.settings.menu_mobile] -%}

        {%- render 'navigation-desktop', menu: linklists[section.settings.menu], megamenu_blocks: menu_blocks -%}
      {%- endif -%}

      <div class="header__logo-placeholder"> </div><!-- /.header__logo-placeholder -->

      <div class="header__logo">
        <a
          href="{{- routes.root_url -}}"
          class="inline-unstyled-link"
        >
          {%- capture default_logo -%}
            {%- if section.settings.logo_svg_code != blank -%}
              {{- section.settings.logo_svg_code -}}
            {%- elsif section.settings.logo != blank -%}
              {%- assign logo_image_size_2x = section.settings.logo.width | times: 2 | at_most: 5760 -%}

              <img
                srcset="{{ section.settings.logo | image_url: width: section.settings.logo.width }} 1x, {{ section.settings.logo | image_url: width: logo_image_size_2x }} 2x"
                src="{{- section.settings.logo | image_url: width: section.settings.logo.width -}}"
                loading="lazy"
                width="{{- section.settings.logo.width -}}"
                height="{{- section.settings.logo.height -}}"
                alt="{{- section.settings.logo.alt | default: shop.name | escape -}}"
              >
            {%- endif -%}

            <span
              class="{% if section.settings.logo == blank and section.settings.logo_svg_code == blank %}h4{% else %}visually-hidden{% endif %}"
            >{{- shop.name | escape -}}</span>
          {%- endcapture -%}

          {%- if custom_logo != blank -%}
            {%- assign logo_image_size_2x = custom_logo.width | times: 2 | at_most: 5760 -%}

            <img
              srcset="{{ custom_logo | image_url: width: custom_logo.width }} 1x, {{ custom_logo | image_url: width: logo_image_size_2x }} 2x"
              src="{{- custom_logo | image_url: width: custom_logo.width -}}"
              loading="lazy"
              width="{{- custom_logo.width -}}"
              height="{{- custom_logo.height -}}"
              alt="{{- custom_logo.alt | default: shop.name | escape -}}"
            >

            <span class="visually-hidden">{{- shop.name | escape -}}</span>
          {%- else -%}
            {{- default_logo -}}
          {%- endif -%}
        </a>
      </div><!-- /.header__logo -->

      <nav class="header__utils">
        <ul class="header__utils-items list-unstyled">
          <li class="header__utils-item">
            {%- capture search_link_html -%}
              <a
                href="{{- routes.search_url -}}"
                class="header__utils-link full-unstyled-link focus-inset"
                title="{{- 'accessibility.search' | t -}}"
                data-header="mobile-search-open"
              >
                {%- render 'icon', icon: 'search' -%}
              </a>
            {%- endcapture -%}

            {%- if settings.enable_predictive_search -%}
              <noscript>
                {{- search_link_html -}}
              </noscript>

              <span class="large-up-hide">
                {{- search_link_html }}
              </span>

              <predictive-search class="no-js-hidden medium-hide small-hide">
                <details class="disclosure-has-popup header__search-wrapper motion-reduce">
                  <summary class="header__utils-link">
                    {%- render 'icon', icon: 'search' -%}
                  </summary>

                  <div class="header__search motion-reduce">
                    {%-
                      liquid
                      capture search_input_attr
                        echo 'role="combobox" '
                        echo 'aria-expanded="false" '
                        echo 'aria-owns="predictive-search-results-list" '
                        echo 'aria-controls="predictive-search-results-list" '
                        echo 'aria-haspopup="listbox" '
                        echo 'aria-autocomplete="list" '
                        echo 'autocorrect="off" '
                        echo 'autocomplete="off" '
                        echo 'autocapitalize="off" '
                        echo 'spellcheck="false"'
                      endcapture

                      render 'form-search', namespace: 'Header', input_attr: search_input_attr, class: 'header__search-form'
                    -%}

                    <predictive-search-results class="header__search-results"></predictive-search-results>
                  </div>
                </details>
              </predictive-search>
            {%- else -%}
              {{- search_link_html -}}
            {%- endif -%}
          </li><!-- /.header__utils-item -->

          <li class="header__utils-item header__utils-item--cart">
            <a href="{{- routes.cart_url -}}" class="header__utils-link full-unstyled-link focus-inset" title="{{- 'accessibility.cart' | t -}}" id="cart-counter" data-cart-link>
              {%- render 'cart-counter' -%}
            </a>
          </li><!-- /.header__utils-item -->

          {%- if shop.customer_accounts_enabled -%}
            <li class="header__utils-item small-hide medium-hide">
              <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__utils-link full-unstyled-link focus-inset" title="{%- if customer -%}{{ 'accessibility.account' | t }}{%- else -%}{{ 'accessibility.sign_in' | t }}{%- endif -%}">
                {%- render 'icon', icon: 'user' -%}
              </a>
            </li><!-- /.header__utils-item -->
          {%- endif -%}
        </ul><!-- /.header__utils-items list-unstyled -->
      </nav><!-- /.header__utils -->
    </div><!-- /.header__inner -->
  </div><!-- /.container -->
</header><!-- /.header -->

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo != blank %}
      "logo": {{ section.settings.logo | image_url: width: section.settings.logo.width | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_linkedin_link | json }},
      {{ settings.social_youtube_link | json }},
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
  {
    "name": "t:sections.header.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:sections.header.settings.logo.label"
      },
      {
        "type": "html",
        "id": "logo_svg_code",
        "label": "t:sections.header.settings.logo_svg_code.label",
        "info": "t:sections.header.settings.logo_svg_code.info"
      },
      {
        "type": "number",
        "id": "logo_width",
        "label": "Logo width (px)",
        "default": 108
      },
      {
        "type": "number",
        "id": "logo_width_mobile",
        "label": "Logo width Mobile (px)",
        "default": 76
      },
      {
        "type": "link_list",
        "id": "menu_mobile",
        "default": "main-menu",
        "label": "Mobile menu"
      },
      {
        "type": "link_list",
        "id": "menu",
        "default": "main-menu",
        "label": "Desktop menu"
      },
      {
        "type": "color_scheme",
        "id": "main_colors",
        "default": "scheme_1",
        "label": "Main colors"
      },
      {
        "type": "checkbox",
        "id": "floating_header",
        "label": "Floating header",
        "default": true
      }
    ],
    "blocks": [
      {
        "name": "Custom template Logo",
        "type": "custom_template_logo",
        "settings": [
          {
            "type": "textarea",
            "id": "title",
            "label": "Template name",
            "info": "Enter a list of templates(each on a new line) with type and name in the following format: '[type].[name]', eg. 'product.christmas', 'collection.special-offers'. Default templates have no name, so use just the type, for example 'product' or 'collection'.",
          },
          {
            "type": "image_picker",
            "id": "logo",
            "label": "Logo"
          },
        ]
      },
      {
        "name": "Custom color scheme",
        "type": "custom_color_scheme",
        "settings": [
          {
            "type": "textarea",
            "id": "title",
            "label": "Template name",
            "info": "Enter a list of templates(each on a new line) with type and name in the following format: '[type].[name]', eg. 'product.christmas', 'collection.special-offers'. Default templates have no name, so use just the type, for example 'product' or 'collection'.",
          },
          {
            "type": "color_scheme",
            "id": "color_scheme",
            "default": "scheme_1",
            "label": "Color scheme"
          }
        ]
      },
      {
        "name": "Mega menu",
        "type": "mega_menu",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Main menu name"
          },
          {
            "type": "metaobject",
            "id": "mega_menu",
            "label": "Mega menu",
            "metaobject_type": "mega_menu_item"
          }
        ]
      },
      {
        "name": "Menu item",
        "type": "menu_item",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Menu link text (must match a Navigation item)"
          },
          {
            "type": "select",
            "id": "menu_type",
            "label": "Menu type",
            "default": "simple",
            "options": [
              { "value": "simple", "label": "Simple dropdown" },
              { "value": "songs", "label": "Songs (music finder)" },
              { "value": "shop", "label": "Shop (ecommerce)" },
              { "value": "discover", "label": "Discover (page listing)" },
              { "value": "countdown", "label": "Countdown (multiple countdowns)" }
            ]
          },
          {
            "type": "header",
            "content": "Songs",
            "visible_if": "{{ block.settings.menu_type == 'songs' }}"
          },
          {
            "type": "collection_list",
            "id": "songs_categories",
            "label": "Category collections",
            "limit": 8,
            "visible_if": "{{ block.settings.menu_type == 'songs' }}"
          },
          {
            "type": "color_scheme",
            "id": "songs_scheme",
            "label": "Accent colour scheme",
            "visible_if": "{{ block.settings.menu_type == 'songs' }}"
          },
          {
            "type": "header",
            "content": "Shop",
            "visible_if": "{{ block.settings.menu_type == 'shop' }}"
          },
          {
            "type": "link_list",
            "id": "shop_menu",
            "label": "Shop menu (columns from nested links)",
            "visible_if": "{{ block.settings.menu_type == 'shop' }}"
          },
