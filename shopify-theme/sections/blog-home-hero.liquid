{{- 'section-blog-category.css' | asset_url | stylesheet_tag -}}
{{- 'card-featured-article.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign _section = section.settings
  assign blog_ref = blog

  comment
    Background: section setting > default
  endcomment
  assign bg_color = _section.background | default: '#790200'
  assign bg_image = _section.background_image
  assign img_opacity = _section.image_opacity | default: 10 | divided_by: 100.0

  comment
    Build array of all blogs by handle from section setting
  endcomment
  assign blog_handles_setting = _section.blog_handles | default: 'kids-activities,christmas,song-stories,playlists,teaching-resources,music-and-learning,christmas-memes,kids-music'
  assign all_blog_handles = blog_handles_setting | remove: ' ' | split: ','

  comment
    Featured article: section setting > most recent from any blog
  endcomment
  assign featured = _section.featured_article
  if featured == blank
    for handle in all_blog_handles
      assign b = blogs[handle]
      if b == blank
        continue
      endif
      for art in b.articles
        if art.template_suffix == 'pillar' or art.tags contains 'pillar'
          continue
        endif
        assign featured = art
        break
      endfor
      if featured != blank
        break
      endif
    endfor
  endif
-%}

{%- render 'blog-color-override', override_color: bg_color -%}

{%- capture hero_styles -%}
  --featured-color: {{ bg_color }};
  background: {{ bg_color }};
{%- endcapture -%}

<section
  class="blog-category-hero"
  style="{{ hero_styles | strip }}"
>
  {%- if bg_image != blank -%}
    <div class="blog-category-hero__bg-media" style="opacity: {{ img_opacity }};">
      <img
        srcset="{%- render 'srcset', image: bg_image -%}"
        sizes="100vw"
        src="{{ bg_image | image_url: width: 1920 }}"
        loading="eager"
        alt=""
        width="{{ bg_image.width }}"
        height="{{ bg_image.height }}"
      >
    </div>
  {%- endif -%}

  <nav class="blog-breadcrumbs container" aria-label="{{- 'general.breadcrumbs.label' | t -}}" style="position: relative; z-index: 2; color: #fff;">
    <ol class="blog-breadcrumbs__list list-unstyled list-flex" role="list">
      <li>
        <a href="{{- routes.root_url -}}" class="inline-unstyled-link link-hover-fade">
          {{- 'general.breadcrumbs.home' | t -}}
        </a>
      </li>
      <li>
        {%- render 'icon', icon: 'chevron-right' -%}
      </li>
      <li>
        <span>{{- blog_ref.title -}}</span>
      </li>
    </ol>
  </nav>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumbs.home' | t | json }},
        "item": "{{ shop.url }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog_ref.title | json }},
        "item": "{{ shop.url }}{{ blog_ref.url }}"
      }
    ]
  }
  </script>

  <div class="container" style="position: relative; z-index: 2;">
    <div class="blog-category-hero__grid">
      <!-- Featured Article Card -->
      <div class="blog-category-hero__featured">
        {%- liquid
          assign featured_tag = featured.tags | first
          if featured_tag != blank
            assign featured_tag = featured_tag | remove: 'Category_' | remove: 'category_' | replace: '_', ' ' | replace: '-', ' ' | upcase
          endif
        -%}
        {%- render 'card-featured-article',
          article_ref: featured,
          custom_tag: featured_tag
        -%}
      </div>

      <!-- Latest Articles List -->
      <div class="blog-category-hero__latest">
        <h3 class="blog-category-hero__latest-title caption uppercase">
          Latest Activities
        </h3>
        {%- assign latest_shown = 0 -%}
        {%- assign latest_shown_ids = '' -%}
        {%- if featured != blank -%}
          {%- assign latest_shown_ids = featured.id | append: ',' -%}
        {%- endif -%}

        {%- comment -%} Get latest articles from all blogs {%- endcomment -%}
        {%- for handle in all_blog_handles -%}
          {%- assign b = blogs[handle] -%}
          {%- if b == blank -%}{%- continue -%}{%- endif -%}
          {%- if latest_shown >= _section.latest_count -%}{%- break -%}{%- endif -%}
          {%- for article_ref in b.articles -%}
            {%- if latest_shown >= _section.latest_count -%}{%- break -%}{%- endif -%}
            {%- if article_ref.template_suffix == 'pillar' or article_ref.tags contains 'pillar' -%}{%- continue -%}{%- endif -%}
            {%- assign id_check = article_ref.id | append: ',' -%}
            {%- if latest_shown_ids contains id_check -%}{%- continue -%}{%- endif -%}

            {%- if latest_shown > 0 -%}
              <div class="blog-category-hero__latest-separator"></div>
            {%- endif -%}
            <a href="{{ article_ref.url }}" class="blog-category-hero__latest-item">
              {%- assign latest_shown = latest_shown | plus: 1 -%}
              {%- assign latest_shown_ids = latest_shown_ids | append: id_check -%}
              <span class="blog-category-hero__latest-number">{{ latest_shown }}</span>
              <div class="blog-category-hero__latest-content">
                <span class="blog-category-hero__latest-name">{{ article_ref.title }}</span>
                <span class="blog-category-hero__latest-meta caption">
                  {%- assign article_tag = article_ref.tags | first -%}
                  {%- if article_tag != blank -%}
                    {{ article_tag | remove: 'Category_' | remove: 'category_' | replace: '_', ' ' | replace: '-', ' ' | upcase }} · {{ article_ref.metafields.custom.reading_time }}
                  {%- else -%}
                    {{ article_ref.metafields.custom.reading_time }}
                  {%- endif -%}
                </span>
              </div>
            </a>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog Home Hero",
  "settings": [
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured article",
      "info": "Choose the featured article. Falls back to the newest article from any blog."
    },
    {
      "type": "range",
      "id": "latest_count",
      "min": 3,
      "max": 8,
      "default": 5,
      "label": "Latest articles count"
    },
    {
      "type": "textarea",
      "id": "blog_handles",
      "label": "Blog handles",
      "default": "kids-activities,christmas,song-stories,playlists,teaching-resources,music-and-learning,christmas-memes,kids-music",
      "info": "Comma-separated list of blog handles to pull articles from"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background color / gradient",
      "default": "#790200"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 10,
      "unit": "%",
      "label": "Background image opacity"
    }
  ]
}
{% endschema %}
