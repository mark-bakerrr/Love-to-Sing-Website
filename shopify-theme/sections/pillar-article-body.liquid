{{- 'section-blog-category.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign _section = section.settings
  assign blog_ref = blog
  assign tag_color = blog_ref.metafields.custom.tag_color | default: '#790200'
  assign topics = blog_ref.metafields.custom.topics.value

  comment
    Get topic: first try article metafield, then fallback to tag matching
    Note: metafield may return a list, so get first item
  endcomment
  assign topic = article.metafields.custom.blog_topic.value | first
  assign pillar_tag = blank
  assign pillar_title = blank
  assign topic_popular = blank

  comment
    Fallback: match article tags against blog topics
  endcomment
  if topic == blank and topics != blank
    for article_tag in article.tags
      for t in topics
        if t.tag == article_tag
          assign topic = t
          break
        endif
      endfor
      if topic != blank
        break
      endif
    endfor
  endif

  if topic != blank
    assign pillar_tag = topic.tag
    assign pillar_title = topic.label
    if topic.color != blank
      assign tag_color = topic.color
    endif
    assign topic_popular = topic.popular_articles.value
  endif

  comment
    Fallback: clean up title if still blank
  endcomment
  if pillar_title == blank and pillar_tag != blank
    assign pillar_title = pillar_tag | replace: '_', ' ' | replace: '-', ' '
  endif
-%}

<section class="pillar-article-body" style="--tag-color: {{ tag_color }};">
  <div class="container">
    <div class="pillar-article-body__grid">

      {%- comment -%} ======== Main Content — All Articles ======== {%- endcomment -%}
      <div class="pillar-article-body__main">
        <div class="pillar-article-body__header">
          <div class="shelf__header-left">
            <span class="shelf__accent"></span>
            <h2 class="pillar-article-body__title h3">All {{ pillar_title | capitalize }} Articles</h2>
          </div>
        </div>

        {%- if pillar_tag != blank -%}
          <div class="pillar-article-body__articles grid grid--3">
            {%- assign shown_count = 0 -%}
            {%- for article_ref in blog_ref.articles -%}
              {%- if article_ref.id == article.id -%}{%- continue -%}{%- endif -%}
              {%- unless article_ref.tags contains pillar_tag -%}{%- continue -%}{%- endunless -%}
              {%- render 'card-article', article_ref: article_ref -%}
              {%- assign shown_count = shown_count | plus: 1 -%}
            {%- endfor -%}
          </div>

          {%- if shown_count == 0 -%}
            <p class="center">No articles found for tag "{{ pillar_tag }}".</p>
          {%- endif -%}
        {%- else -%}
          <p class="center">No topic tag configured. Set the "Topic tag" in section settings.</p>
        {%- endif -%}
      </div>

      {%- comment -%} ======== Sidebar ======== {%- endcomment -%}
      <aside class="pillar-article-body__sidebar" style="--tag-color: {{ tag_color }};">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'pillar_popular_activities' -%}
              {%- assign articles_limit = block.settings.articles_count | default: 5 -%}
              {%- assign popular = topic_popular -%}
              {%- if popular == blank -%}
                {%- assign popular = blog_ref.metafields.custom.popular_articles.value -%}
              {%- endif -%}
              <div class="sidebar-popular" {{ block.shopify_attributes }}>
                <h3 class="sidebar-popular__title h5">Popular Activities</h3>
                {%- if popular != blank -%}
                  {%- assign display_index = 0 -%}
                  {%- for article_ref in popular -%}
                    {%- if display_index >= articles_limit -%}{%- break -%}{%- endif -%}
                    {%- if article_ref.id == article.id -%}{%- continue -%}{%- endif -%}
                    {%- assign display_index = display_index | plus: 1 -%}
                    {%- unless display_index == 1 -%}
                      <div class="sidebar-popular__separator"></div>
                    {%- endunless -%}
                    <a href="{{ article_ref.url }}" class="sidebar-popular__item">
                      <span class="sidebar-popular__number">{{ display_index }}</span>
                      <div class="sidebar-popular__content">
                        <span class="sidebar-popular__name">{{ article_ref.title }}</span>
                        {%- if article_ref.metafields.custom.reading_time != blank -%}
                          <span class="sidebar-popular__meta caption">{{ article_ref.metafields.custom.reading_time }}</span>
                        {%- endif -%}
                      </div>
                    </a>
                  {%- endfor -%}
                {%- else -%}
                  {%- assign display_index = 0 -%}
                  {%- for article_ref in blog_ref.articles -%}
                    {%- if display_index >= articles_limit -%}{%- break -%}{%- endif -%}
                    {%- if article_ref.id == article.id -%}{%- continue -%}{%- endif -%}
                    {%- assign display_index = display_index | plus: 1 -%}
                    {%- unless display_index == 1 -%}
                      <div class="sidebar-popular__separator"></div>
                    {%- endunless -%}
                    <a href="{{ article_ref.url }}" class="sidebar-popular__item">
                      <span class="sidebar-popular__number">{{ display_index }}</span>
                      <div class="sidebar-popular__content">
                        <span class="sidebar-popular__name">{{ article_ref.title }}</span>
                        {%- if article_ref.metafields.custom.reading_time != blank -%}
                          <span class="sidebar-popular__meta caption">{{ article_ref.metafields.custom.reading_time }}</span>
                        {%- endif -%}
                      </div>
                    </a>
                  {%- endfor -%}
                {%- endif -%}
              </div>

            {%- when 'song_finder' -%}
              {%- assign finder_bg = tag_color | default: '#781D1B' -%}
              <div class="sidebar-song-finder" style="--finder-bg: {{ finder_bg }};" {{ block.shopify_attributes }}>
                <div class="sidebar-song-finder__header">
                  <img
                    src="https://cdn.shopify.com/s/files/1/0053/3505/6418/files/hearts-background.png?v=1759397015"
                    alt=""
                    class="sidebar-song-finder__header-overlay"
                    loading="lazy"
                  >
                  <h3 class="sidebar-song-finder__title">Song Finder</h3>
                </div>
                <div class="sidebar-song-finder__body">
                  <p class="sidebar-song-finder__desc">
                    Find the perfect song for any activity, age group, or occasion.
                  </p>
                  <predictive-search
                    class="sidebar-song-finder__search-wrap no-js-hidden"
                    data-results-limit="5"
                    data-custom-query="&resources[type]=product&resources[limit]=5&filter.p.tag=song"
                    data-section-id="predictive-search-song-finder"
                  >
                    <span class="sidebar-song-finder__search-icon" aria-hidden="true">{%- render 'icon', icon: 'search' -%}</span>
                    {%- liquid
                      capture search_input_attr
                        echo 'role="combobox" '
                        echo 'aria-label="Search songs" '
                        echo 'aria-expanded="false" '
                        echo 'aria-owns="predictive-search-results-list" '
                        echo 'aria-controls="predictive-search-results-list" '
                        echo 'aria-haspopup="listbox" '
                        echo 'aria-autocomplete="list" '
                        echo 'autocorrect="off" '
                        echo 'autocomplete="off" '
                        echo 'autocapitalize="off" '
                        echo 'spellcheck="false"'
                      endcapture

                      render 'form-search', namespace: 'song-finder', input_attr: search_input_attr, class: 'sidebar-song-finder__search', type: 'product', tag: 'song', placeholder: 'Search songs...', hide_button: true
                    -%}

                    <predictive-search-results class="sidebar-song-finder__results"></predictive-search-results>
                  </predictive-search>

                  <div class="sidebar-song-finder__chips">
                    {%- for collection in block.settings.collections -%}
                      <a href="{{ collection.url }}" class="sidebar-song-finder__chip">{{ collection.title }}</a>
                    {%- endfor -%}
                  </div>

                  <a href="/collections/all-songs" class="sidebar-song-finder__cta">
                    Browse all songs →
                  </a>
                </div>
              </div>

            {%- when 'other_topics' -%}
              {%- if topics != blank -%}
                <div class="sidebar-topics" {{ block.shopify_attributes }}>
                  <h3 class="sidebar-topics__title h5">{{ block.settings.title | default: 'Other Topics' }}</h3>
                  <div class="sidebar-topics__list">
                    {%- assign sidebar_topic_count = 0 -%}
                    {%- for topic in topics -%}
                      {%- if topic.tag == pillar_tag or topic.tag contains pillar_tag or pillar_tag contains topic.tag -%}
                        {%- continue -%}
                      {%- endif -%}
                      {%- if sidebar_topic_count >= 8 -%}{%- break -%}{%- endif -%}
                      {%- assign topic_tag = topic.tag | default: topic.title | handle -%}
                      {%- assign topic_title = topic.title | default: topic.tag | remove: 'Category_' | remove: 'category_' | replace: '_', ' ' | replace: '-', ' ' -%}
                      <a
                        href="{%- if topic.pillar_article.value != blank -%}{{ topic.pillar_article.value.url }}{%- else -%}{{ blog_ref.url }}/tagged/{{ topic_tag }}{%- endif -%}"
                        class="sidebar-topics__chip"
                      >
                        <span class="sidebar-topics__chip-icon">{%- render 'icon', icon: 'music-note-single' -%}</span>
                        <span class="sidebar-topics__chip-label">{{ topic_title }}</span>
                      </a>
                      {%- assign sidebar_topic_count = sidebar_topic_count | plus: 1 -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

            {%- when 'sidebar_ad' -%}
              {%- if block.settings.ad_code != blank -%}
                <div class="sidebar-ad" {{ block.shopify_attributes }}>
                  {{ block.settings.ad_code }}
                </div>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </aside>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sub-Category Articles",
  "settings": [],
  "blocks": [
    {
      "type": "pillar_popular_activities",
      "name": "Popular (Pillar)",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "articles_count",
          "min": 3,
          "max": 8,
          "step": 1,
          "default": 5,
          "label": "Number of articles"
        }
      ]
    },
    {
      "type": "song_finder",
      "name": "Song Finder",
      "limit": 1,
      "settings": [
        {
          "type": "collection_list",
          "id": "collections",
          "label": "Song collections",
          "info": "Select collections to show as chips. Collection titles will be used as labels."
        }
      ]
    },
    {
      "type": "other_topics",
      "name": "Other Topics",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Other Topics"
        }
      ]
    },
    {
      "type": "sidebar_ad",
      "name": "Sidebar Ad",
      "settings": [
        {
          "type": "textarea",
          "id": "ad_code",
          "label": "Ad code (HTML)"
        }
      ]
    }
  ]
}
{% endschema %}
