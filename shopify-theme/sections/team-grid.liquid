{%- comment -%}
  Team grid — for the About page. Renders team metaobject members as cards
  (photo, name, role, "View profile" link). One block per member, referenced by
  handle (dynamic metaobject key access doesn't resolve on this theme, so match
  against metaobjects.team.values). Card has no background.
{%- endcomment -%}

<div class="team-grid" style="--cols:{{ section.settings.columns }}">
  <div class="team-grid__in">
    {%- if section.settings.heading != blank -%}
      <h2 class="team-grid__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="team-grid__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign member = blank -%}
        {%- for m in metaobjects.team.values -%}
          {%- if m.system.handle == block.settings.handle -%}{%- assign member = m -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {%- if member != blank -%}
          {%- assign url = '/pages/team/' | append: member.system.handle -%}
          <li class="team-card" {{ block.shopify_attributes }}>
            <a class="team-card__media" href="{{ url }}" aria-label="{{ member.name.value | escape }}">
              {%- if member.photo.value != blank -%}
                <img src="{{ member.photo.value | image_url: width: 640 }}" alt="{{ member.name.value | escape }}" width="480" height="600" loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'team-card__ph' }}
              {%- endif -%}
            </a>
            <h3 class="team-card__name">{{ member.name.value | escape }}</h3>
            {%- if member.role.value != blank -%}<p class="team-card__role">{{ member.role.value | escape }}</p>{%- endif -%}
            <a class="team-card__link" href="{{ url }}">View profile</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .team-grid{padding:clamp(4rem,8vw,8rem) 0}
  .team-grid *{box-sizing:border-box}
  .team-grid__in{max-width:120rem;margin:0 auto;padding:0 clamp(1.6rem,4vw,4rem)}
  .team-grid__title{text-align:center;font-family:'Nunito',system-ui,sans-serif;font-weight:900;color:#1a1a1a;
    font-size:clamp(2.6rem,4vw,3.6rem);line-height:1.05;letter-spacing:-.01em;margin:0 0 clamp(3rem,5vw,5rem);text-wrap:balance}
  .team-grid__list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--cols,3),minmax(0,1fr));gap:clamp(2.4rem,4vw,4.8rem)}

  .team-card{display:flex;flex-direction:column;align-items:center;text-align:center;font-family:'Nunito',system-ui,sans-serif}
  .team-card__media{display:block;width:100%;aspect-ratio:4/5;border-radius:16px;overflow:hidden;box-shadow:0 18px 40px rgba(0,0,0,.14)}
  .team-card__media img,.team-card__media svg{width:100%;height:100%;object-fit:cover;display:block}
  .team-card__media img{transition:transform .8s cubic-bezier(.22,1,.36,1)}
  .team-card__media:hover img{transform:scale(1.04)}
  .team-card__name{font-weight:900;color:#1a1a1a;font-size:clamp(1.9rem,2.2vw,2.3rem);letter-spacing:-.01em;line-height:1.1;
    margin:clamp(1.6rem,2.5vw,2rem) 0 .3rem}
  .team-card__role{color:#C42637;font-weight:800;font-size:clamp(1.4rem,1.6vw,1.6rem);margin:0 0 1.2rem}
  .team-card__link{display:inline-flex;align-items:center;gap:.45em;color:#1a1a1a;font-weight:800;font-size:1.5rem;
    text-decoration:none;transition:color .2s ease}
  .team-card__link::after{content:"\2192";transition:transform .3s cubic-bezier(.22,1,.36,1)}
  .team-card__link:hover{color:#C42637}
  .team-card__link:hover::after{transform:translateX(4px)}

  @media(max-width:749px){ .team-grid__list{grid-template-columns:1fr;max-width:34rem;margin-inline:auto} }
  @media(min-width:750px) and (max-width:989px){ .team-grid__list{grid-template-columns:repeat(2,minmax(0,1fr))} }

  @media (prefers-reduced-motion: reduce){
    .team-card__media img,.team-card__link::after{transition:none}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Team",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the team" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        { "type": "text", "id": "handle", "label": "Team member handle", "info": "The handle of the team metaobject entry, e.g. linda-adamson." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Team",
      "blocks": [
        { "type": "member", "settings": { "handle": "linda-adamson" } },
        { "type": "member", "settings": { "handle": "tessa-baker" } },
        { "type": "member", "settings": { "handle": "mark-baker" } }
      ]
    }
  ]
}
{% endschema %}
