{%- liquid
  assign _section = section.settings

  content_for "block", type: "spacing", id: "contact-spacing"

  echo 'section-contact.css' | asset_url | stylesheet_tag
-%}
<section class="section-contact">
  <div class="container">
    <div class="section-contact__inner">
      <div class="section-contact__content">
        {%- if _section.heading != blank or  _section.subheading != blank  -%}
          <div class="section-contact__header">
            {%- if _section.heading -%}
              <h2 class="section-contact__title">{{- _section.heading -}}</h2><!-- /.h3 center -->
            {%- endif -%}

            {%- if _section.subheading != blank -%}
              <div class="section-contact__subheading">
                {{- _section.subheading -}}
              </div><!-- /.section-contact__subheading -->
            {%- endif -%}
          </div><!-- /.section-contact__header -->
        {%- endif -%}

        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <h3 class="h4" tabindex="-1" autofocus>{{- 'contact.form.success' | t -}}</h3><!-- /.h4 -->
          {%- elsif form.errors -%}
            <div class="color-red">
              {{- form.errors | default_errors -}}
            </div><!-- /.color-red -->
          {%- endif -%}

          <div class="form-row">
            {%-
              liquid
              assign label = 'contact.form.name' | t
              assign placeholder = 'contact.form.name' | t
              capture attr
                echo 'autocomplete="name"'
              endcapture
              if form.name
                assign value = form.name
              elsif customer
                assign value = customer.name
              else
                assign value = ''
              endif
              render 'text-input', id: 'ContactForm-name', label: label, name: 'contact[Name]', placeholder: placeholder, attr: attr, value: value, required: true
            -%}

          </div><!-- /.form-row -->

          <div class="form-row">
            {%-
              liquid
              assign label = 'contact.form.email' | t | append: ' <span class="color-red" aria-hidden="true">*</span>'
              assign placeholder = 'contact.form.email' | t
              capture attr
                echo 'autocomplete="email"'
                echo 'spellcheck="false"'
                echo 'autocapitalize="off"'
                echo 'aria-required="true"'
              endcapture
              if form.email
                assign value = form.email
              elsif customer
                assign value = customer.email
              else
                assign value = ''
              endif
              if form.errors contains 'email'
                assign error = form.errors.translated_fields['email'] | capitalize | append: ' ' | append: form.errors.messages['email']
                assign has_error = true
              endif
              render 'text-input', id: 'ContactForm-email', type: 'email', label: label, name: 'contact[email]', placeholder: placeholder, attr: attr, value: value, has_error: has_error, message: error, required: true
            -%}
          </div><!-- /.form-row -->

          <div class="form-row">
            {%-
              liquid
              assign label = 'contact.form.message' | t
              assign placeholder = 'contact.form.message' | t
              assign name = 'contact[' | append: label | append: ']'
              render 'textarea-input', id: 'ContactForm-body', label: label, name: name, placeholder: placeholder, body: form.body, required: true
            -%}
          </div><!-- /.form-row -->

          <div class="form-row">
            {%- assign label = 'contact.form.accept_terms_html' | t: link: section.settings.terms_link -%}

            <div class="checkbox">
              <input
                type="checkbox"
                name="accept_terms-ContactFormImage"
                id="accept_terms-ContactFormImage"
                required
              >

              <label for="accept_terms-ContactFormImage">
                {{- label -}}
              </label>
            </div><!-- /.checkbox -->
          </div><!-- /.form-row -->

          <div class="form-row form-row--actions">
            {%- assign value = 'contact.form.submit' | t -%}
            {%- render 'button', type: 'submit', value: value -%}
            {%- assign value = nil -%}
          </div><!-- /.form-row -->
        {%- endform -%}
      </div><!-- /.section-contact__content -->

      {%- if _section.image != blank -%}
        <div class="section-contact__media">
          <div class="media">
            {%- render 'image', image: _section.image -%}
          </div><!-- /.media -->
        </div><!-- /.section-contact__media -->
      {%- endif -%}
    </div><!-- /.section-contact__inner -->
  </div><!-- /.container -->
</section><!-- /.container--narrow -->

{% schema %}
  {
    "name": "Contact form",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "textarea",
        "id": "subheading",
        "label": "Subheading"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
    ],
    "presets": [
      {
        "name": "Contact form",
        "settings": {
        }
      }
    ]
  }
{% endschema %}
