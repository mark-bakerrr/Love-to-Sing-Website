{%- comment -%}
  Team member bio page (rendered for a `team` metaobject's web page).
  The photo_wall people tags link here.
{%- endcomment -%}

<div class="team-bio">
  {%- if metaobject.photo.value != blank -%}
    <img class="team-bio__photo"
      src="{{ metaobject.photo.value | image_url: width: 640 }}"
      alt="{{ metaobject.name.value | escape }}" width="220" height="220" loading="lazy">
  {%- endif -%}

  <h1 class="team-bio__name">{{ metaobject.name.value | escape }}</h1>

  {%- if metaobject.role.value != blank -%}
    <p class="team-bio__role">{{ metaobject.role.value | escape }}</p>
  {%- endif -%}

  {%- if metaobject.bio.value != blank -%}
    <div class="team-bio__text">{{ metaobject.bio.value | newline_to_br }}</div>
  {%- endif -%}

  <p class="team-bio__back">
    <a href="{{ routes.root_url }}pages/photo-wall">&larr; Back to the Photo Wall</a>
  </p>
</div>

{% stylesheet %}
  .team-bio{max-width:820px;margin:0 auto;padding:64px 24px;text-align:center;
    font-family:'Nunito', system-ui, sans-serif;}
  .team-bio__photo{width:200px;height:200px;object-fit:cover;border-radius:18px;
    box-shadow:0 14px 34px rgba(0,0,0,.18);}
  .team-bio__name{font-size:clamp(32px,5vw,44px);font-weight:900;margin:24px 0 4px;line-height:1.05;}
  .team-bio__role{font-size:16px;font-weight:800;color:#C42637;letter-spacing:.02em;margin:0 0 22px;}
  .team-bio__text{font-size:17px;line-height:1.65;color:#3a3a3a;max-width:640px;margin:0 auto;text-align:left;}
  .team-bio__back{margin-top:36px;}
  .team-bio__back a{color:#C42637;font-weight:800;text-decoration:none;}
  .team-bio__back a:hover{text-decoration:underline;}
{% endstylesheet %}

{% schema %}
{
  "name": "Team bio",
  "settings": []
}
{% endschema %}
