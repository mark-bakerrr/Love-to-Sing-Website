      "name": "t:sections.image-and-text.name",
      "settings": {
        "background": "#ffffff",
        "flip_content": true,
        "image": "shopify://shop_images/mark-baker-linda-adamson-tessa-baker-love-to-sing-family-team-christmas_jpg.jpg",
        "push_content_up": false,
        "content_color": "#000000",
        "eyebrow": "Created with Love",
        "eyebrow_color": "#b91f1c",
        "title": "The Heart of Love to Sing",
        "content": "<p>Family has always been at the heart of Love to Sing. Linda writes and creates music; Tessa, who has been part of Love to Sing since childhood as a singer and performer, now leads Creative Production; and Mark brings creativity together with business, technical, website and production expertise<strong>. </strong>Their different skills complement one another, while a wider team of talented musicians, singers, arrangers, artists and creative professionals helps bring each project to life. Today, Love to Sing has five YouTube channels, with Christmas Songs & Carols - Love to Sing becoming one of the biggest Christmas music channels in the world.<br/><br/></p>",
        "button_text": "",
        "button_url": ""
      }
    },
    "image_and_text_BhjKDW": {
      "type": "image-and-text",
