            "position": "Love to Sing Fan"
          },
          "blocks": {}
        },
        "review_zQFYCz": {
          "type": "review",
          "settings": {
            "stars": 5,
            "content": "I started singing your songs with my daughter fifteen  years ago and have been singing them in classrooms around Asia ever since. The  Sit Down song has saved my sanity on many occasions! Great to find them available on the internet now when I need a refresher.",
            "author": "Sue",
            "position": "Kindergarten Teacher"
          },
          "blocks": {}
        },
        "review_4WVywe": {
          "type": "review",
          "settings": {
            "stars": 5,
            "content": "I am a New Zealand citizen and New Zealand Early childhood teacher. I used to listen to your CD's when I was in New Zealand they are awesome. Now I am working in the USA at a Montessori school and I have already introduced a few songs from Love to Sing CD's to our kids. They really enjoy!",
            "author": "Saradha",
            "position": "Teacher"
          },
          "blocks": {}
        },
        "review_gLFwiQ": {
