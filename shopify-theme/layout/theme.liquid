<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    {% render 'lts-canonical' %}
    {%- if request.page_type == 'search' or product.type == 'Licence' or product.type == 'Membership' or template.suffix == 'licence' or template.suffix == 'single-licences' or page.handle == 'licence-terms' -%}
      <meta name="robots" content="noindex,follow">
    {%- endif -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {%- if request.page_type == 'search' and search.terms != blank -%}
        {%- assign _clean_terms = search.terms | remove: 'tag:song' | strip -%}
        {%- if search.terms contains 'tag:song' -%}
          {{- 'search.song_scope_title' | t: terms: _clean_terms | strip_html -}}
        {%- else -%}
          {{- 'search.results_for' | t: terms: _clean_terms | strip_html -}}
        {%- endif -%}
      {%- else -%}
        {{ page_title }}
      {%- endif -%}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

    {%- comment -%}
      Loaded BEFORE content_for_header (where app embeds inject) and WITHOUT defer
      so its fetch/XHR patch installs before the Shop Drawer app captures window.fetch.
      Keeps the standard cart drawer + header count in sync with external cart adds.
    {%- endcomment -%}
    <script src="{{ 'cart-sync.js' | asset_url }}"></script>

    {{ content_for_header }}

    {%- render 'settings' -%}

    {{ 'reset.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');

      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    {%- comment -%}
      Vendors:
    {%- endcomment -%}

    <script src="{{- 'bodyScrollLock.min.js' | asset_url -}}" defer="defer"></script>

    {%- if settings.image_animations -%}
      <script src="{{- 'lazysizes.min.js' | asset_url -}}" defer="defer"></script>
    {%- endif -%}

    {%- if request.design_mode -%}
      <script src="{{- 'theme-scripts.js' | asset_url -}}" defer></script>
    {%- endif -%}
  </head>

  <body class="template{% if template.suffix %} template--{{- template.suffix -}}{% endif %}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{- 'accessibility.skip_to_text' | t -}}
    </a>

    {%-
      liquid
      unless template == 'cart'
        render 'cart-drawer'
      endunless
      sections 'header-group'
      sections 'popups-group'
    -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{- 'accessibility.refresh_page' | t -}}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_url: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_clear_url: '{{ routes.cart_clear_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };

      window.cartStrings = {
        error: `{{ 'cart.cart_error' | t }}`,
        quantityError: `{{ 'cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      }
      window.variantStrings = {
        unavailable: '{{ 'products.product.unavailable' | t }}',
        addToCart: '{{ 'products.product.add_to_cart' | t }}',
        soldOut: '{{ 'products.product.sold_out' | t }}',
      }
    </script>
  {% render 'lts-blog-blocks' %}
  {% render 'countdown-widget' %}
  </body>
</html>
