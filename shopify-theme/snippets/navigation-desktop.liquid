{%- comment -%}
  Navigation for desktop viewports.
  Accepts:
  - menu: Menu object
  - megamenu_blocks: Array of megamenu blocks
{%- endcomment -%}

<nav class="header__nav small-hide medium-hide">
  <ul class="header__nav-items list-unstyled">
    {%- for link in menu.links -%}
      {%- liquid
        assign megamenu_items = ''
        assign megamenu_block = megamenu_blocks | map: 'settings' | where: 'title', link.title | first
        assign megamenu_entries = metaobjects.mega_menu_item[megamenu_block.mega_menu].menu_categories.value
        assign logos_list = ''
      -%}

      {%- if megamenu_entries != blank -%}
        {%- capture megamenu_items -%}
          <ul
            class="megamenu__list list-unstyled"
            megamenu="main-menu-list"
          >
            {%- for item in megamenu_entries -%}
              {%- liquid
                assign item_title = item.title
                assign item_link = item.url
                assign item_collection_list = item.collection
                assign item_collection_count = item_collection_list.value.count
                assign item_color_scheme_index = item.color_scheme | plus: 0
                assign item_logo_url = item.logo_image
                assign add_search = item.add_search
                assign button_label_1 = item.button_1_label
                assign button_link_1 = item.button_1_link
                assign button_label_2 = item.button_2_label
                assign button_link_2 = item.button_2_link
                assign button_2_menu = item.button_2_menu | default: 1 | plus: 0
                assign button_label_3 = item.button_3_label
                assign button_link_3 = item.button_3_link
                assign button_3_menu = item.button_3_menu | default: 1 | plus: 0

                assign has_button_1 = false
                assign has_button_2 = false
                assign has_button_3 = false

                # Default to hardcoded gray color scheme if no scheme found
                assign item_color_scheme_id = 'gray'

                for color_scheme in settings.color_schemes
                  if forloop.index == item_color_scheme_index
                    assign item_color_scheme_id = color_scheme.id
                  endif
                endfor

                assign item_tag = 'span'
                if item_link != blank
                  assign item_tag = 'a'
                endif

                if item_logo_url != blank
                  assign item_logo_url = item_logo_url | image_url: width: 300

                  assign logos_list = logos_list | append: forloop.index |append: '||' | append: item_logo_url | append: '***'
                endif

                if button_label_1 != blank and button_link_1 != blank
                  assign has_button_1 = true
                endif

                if button_label_2 != blank and button_link_2 != blank
                  assign has_button_2 = true
                endif

                if button_label_3 != blank and button_link_3 != blank
                  assign has_button_3 = true
                endif

                if item_title == blank
                  continue
                endif
              -%}

              <li
                class="megamenu__item{% if forloop.first %} is-active{% endif %}"
                data-color-scheme="color-{{ item_color_scheme_id }}"
                data-item-index="{{ forloop.index }}"
                megamenu="item"
              >
                <{{ item_tag }}
                  class="megamenu__link full-unstyled-link focus-inset"
                  {%- if item_link != blank -%}
                    {% if item.link == link.url %} aria-current="page"{% endif %}
                    href="{{ item_link }}"
                  {%- endif %}
                >
                  <span>
                    {{ item.title }}
                  </span>

                  {%- if item_collection_count > 0 -%}
                    <i>
                      {%- render 'icon', icon: 'chevron-right' -%}
                    </i>
                  {%- endif -%}
                </{{ item_tag }}>

                {%- assign _collection = item_collection_list.value | first -%}
                {%- render 'megamenu-products',
                  item: item,
                  _collection: _collection,
                  has_button_1: has_button_1,
                  button_label_1: button_label_1,
                  button_link_1: button_link_1,
                  has_button_2: has_button_2,
                  button_2_menu: button_2_menu,
                  button_label_2: button_label_2,
                  button_link_2: button_link_2,
                  has_button_3: has_button_3,
                  button_3_menu: button_3_menu,
                  button_label_3: button_label_3,
                  button_link_3: button_link_3,
                  add_search: add_search,
                  item_collection_list: item_collection_list,
                  item_collection_count: item_collection_count
                -%}
              </li><!-- /.megamenu__item -->
            {%- endfor -%}
          </ul>

          {%- if logos_list != ''  -%}
            {%- assign logos_list_array = logos_list | split: '***' | compact -%}

            <div
              class="megamenu__logo"
              megamenu="logo-container"
            >
              {%- for logo_item in logos_list_array -%}
                {%- liquid
                  assign logo_parts = logo_item | split: '||'
                  assign logo_index = logo_parts[0] | plus: 0
                  assign logo_src = logo_parts[1]
                -%}

                <div
                  class="media media--transparent media--1-1 {% unless logo_index == 1 %} hidden{% endunless %}"
                  data-logo-index="{{ logo_index }}"
                  megamenu="logo-item"
                >
                  {%- render 'image', src: logo_src, width: 300, height: 300 -%}
                </div><!-- /.media -->
              {%- endfor -%}
            </div><!-- /.megamenu__logo -->
          {%- endif -%}
        {%- endcapture -%}
      {%- endif -%}

      <li
        class="header__nav-item"
        megamenu="container"
      >
        <a
          href="{{- link.url -}}"
          class="header__nav-link full-unstyled-link focus-inset{% if link.child_active %} is-current{% endif %}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          <span>
            {{- link.title | escape -}}
          </span>

          {%- if link.links.size > 0 or megamenu_items != blank -%}
            <i>
              {%- render 'icon', icon: 'chevron-down' -%}
            </i>
          {%- endif -%}
        </a>

        {%- if megamenu_items != blank -%}
          <div class="header__megamenu">
            <header-megamenu class="megamenu">
              <div
                class="megamenu__inner"
                megamenu="main-wrapper"
              >
                {{ megamenu_items }}
              </div><!-- /.megamenu__inner -->
            </header-megamenu><!-- /.megamenu -->
          </div><!-- /.header__megamenu -->

        {%- elsif link.links.size > 0 -%}
          <div class="header__nav-dropdown" tabindex="-1">
            <ul class="header__nav-links list-unstyled">
              {%- for child_link in link.links -%}
                <li class="header__nav-links-item">
                  <a href="{{- child_link.url -}}" class="header__nav-dropdown-link full-unstyled-link focus-inset{% if child_link.current %} is-current{% endif %}" aria-label="{{- child_link.title | escape -}}"{% if child_link.current %} aria-current="page"{% endif %}>
                    <span>{{- child_link.title | escape -}}</span>

                    {%- if child_link.links.size > 0 -%}
                      <i>
                        {%- render 'icon', icon: 'chevron-right' -%}
                      </i>
                    {%- endif -%}
                  </a>

                  {%- if child_link.links.size > 0 -%}
                    <ul class="header__nav-sublinks list-unstyled">
                      {%- for grand_child_link in child_link.links -%}
                        <li class="header__nav-sublinks-item">
                          <a href="{{- grand_child_link.url -}}" class="header__nav-dropdown-link full-unstyled-link focus-inset{% if grand_child_link.current %} is-current{% endif %}"{% if grand_child_link.current %} aria-current="page"{% endif %}>{{- grand_child_link.title | escape -}}</a>
                        </li><!-- /.header__nav-sublinks-item -->
                      {%- endfor -%}
                    </ul><!-- /.header__nav-sublinks list-unstyled -->
                  {%- endif -%}
                </li><!-- /.header__nav-links-item -->
              {%- endfor -%}
            </ul><!-- /.header__nav-links list-unstyled -->
          </div><!-- /.header__nav-dropdown -->
        {%- endif -%}
      </li><!-- /.header__nav-item -->
    {%- endfor -%}
  </ul><!-- /.header__nav-items list-unstyled -->
</nav><!-- /.header__nav -->
