<youtube-player class="youtube-player {{ class }}" video-id="{{- video_id -}}">
  <img
    src="{{- thumbnail -}}"
    alt="{{- product.title | escape -}}"
    width="auto"
    height="auto"
    loading="eager"
    class="youtube-player__thumbnail"
  />

  <img
    src="{{- 'youtube.png' | asset_img_url -}}"
    alt="Play video"
    width="auto"
    height="auto"
    loading="eager"
    class="youtube-player__icon"
  />

  <iframe
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</youtube-player>
