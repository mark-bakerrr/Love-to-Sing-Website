{% comment %}
  Accepts:
  - is_open {Boolean}
  - heading {String}
  - answer {Richtext}
  - modifier {String} - Extra class modifier
  - block {Section Block} - overwrites the heading and answer
{% endcomment %}

{%- liquid
  if block
    assign heading = block.settings.heading
    assign answer = block.settings.answer
  endif
-%}

<details class="faq-item {%- if modifier %} faq-item--{{ modifier }}{%- endif -%}" {% if is_open %}open{% endif %} {% if block %}{{ block.shopify_attributes }}{% endif %}>
  <summary class="faq-question">
    <span class="faq-question-content">
      <i class="faq-question-icon">
        {%- render 'icon', icon: 'question-mark' -%}
      </i>

      {%- if heading != blank -%}
        <span>{{ heading }}</span>
      {%- endif -%}
    </span>

    <i class="faq-chevron-icon">
      {%- render 'icon', icon: 'chevron-down' -%}
    </i>
  </summary>

  <div class="faq-answer rte">
    {{ answer }}
  </div>
</details>
