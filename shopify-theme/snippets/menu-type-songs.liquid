{%- comment -%}
  Songs (music finder) menu type.
  Builds an interactive category rail (left) + icon-left song rows (right) that reuses the
  existing `header-megamenu` JS (assets/header-megamenu.js) with NO new script.

  Reuse map (mirrors the legacy metaobject path in navigation-desktop.liquid):
    - Each category collection becomes a `megamenu="item"` in `megamenu="main-menu-list"`,
      with data-item-index + data-color-scheme, .is-active on the first. Hovering a category
      fires updateActiveItem() -> swaps .is-active, toggles the matching logo-item by
      data-logo-index, applies the item colour scheme, and recomputes --megamenu-height.
    - Each item holds its OWN `megamenu="products-container"` (single-collection layout), so
      updateMenuHeight() measures the active category's products via the
      `.item.is-active > [megamenu="products-container"]` selector and the products swap on hover.
    - The active category's logo lives in `megamenu="logo-container"` as `megamenu="logo-item"`
      elements toggled by data-logo-index (same mechanism the JS already drives).

  Accepts: block_settings, link
    - block_settings.songs_categories : collection_list (each collection = one category)
    - block_settings.songs_scheme     : color_scheme (accent), referenced by id (color-{{ id }})
{%- endcomment -%}

{%- liquid
  assign categories = block_settings.songs_categories.value | default: block_settings.songs_categories
  assign accent_scheme = block_settings.songs_scheme
-%}

<div class="header__megamenu">
  <header-megamenu class="megamenu megamenu--songs{% if accent_scheme != blank %} color-{{ accent_scheme }}{% endif %}">
    <div
      class="megamenu__inner megamenu__inner--songs"
      megamenu="main-wrapper"
    >
      {%- comment -%} Category logo (swaps with the active category tab, sits above "Categories"). {%- endcomment -%}
      {%- if categories.size > 0 -%}
        <div
          class="megamenu__logo megamenu__logo--songs"
          megamenu="logo-container"
        >
          {%- for category in categories -%}
            <div
              class="megamenu__songs-logo media media--transparent{% unless forloop.first %} hidden{% endunless %}"
              data-logo-index="{{ forloop.index }}"
              megamenu="logo-item"
            >
              {%- if category.image != blank -%}
                {%- assign logo_src = category.image | image_url: width: 300 -%}
                {%- render 'image', src: logo_src, width: 300, height: 300, alt: category.title -%}
              {%- else -%}
                <span class="megamenu__songs-logo-mark">
                  {%- render 'icon', icon: 'music-note-single' -%}
                </span>
              {%- endif -%}

              <span class="megamenu__songs-logo-text">
                <b>{{ category.title | escape }}</b>
                <small>
                  {{- category.products_count }} {% if category.products_count == 1 %}song{% else %}songs{% endif -%}
                </small>
              </span>
            </div><!-- /.megamenu__songs-logo -->
          {%- endfor -%}
        </div><!-- /.megamenu__logo -->
      {%- endif -%}

      <p class="megamenu__title megamenu__title--songs">Categories</p>

      <ul
        class="megamenu__list megamenu__list--songs list-unstyled"
        megamenu="main-menu-list"
      >
        {%- for category in categories -%}
          <li
            class="megamenu__item{% if forloop.first %} is-active{% endif %}"
            data-color-scheme="color-{{ accent_scheme }}"
            data-item-index="{{ forloop.index }}"
            megamenu="item"
          >
            <a
              href="{{ category.url }}"
              class="megamenu__link full-unstyled-link focus-inset"
            >
              <span>{{ category.title | escape }}</span>

              <span class="megamenu__link-meta">
                <small>{{ category.products_count }}</small>
                <i>{%- render 'icon', icon: 'chevron-right' -%}</i>
              </span>
            </a>

            {%- comment -%} Right-hand products for THIS category (icon-left song rows). {%- endcomment -%}
            {%- liquid
              assign products_limit = 18
              assign search_placeholder = 'search.placeholder_songs' | t
              assign view_all_label = category.title | prepend: 'View all '
            -%}

            <div
              class="megamenu__products megamenu__products--songs"
              megamenu="products-container"
            >
              <ul class="megamenu__products-list megamenu__songs-list list-unstyled">
                {%- for product in category.products limit: products_limit -%}
                  <li class="megamenu__product megamenu__songs-item">
                    {%- render 'card-product-song', product_ref: product -%}
                  </li><!-- /.megamenu__product -->
                {%- endfor -%}
              </ul><!-- /.megamenu__products-list -->

              <div class="megamenu__products-actions megamenu__songs-actions">
                {%- render 'button',
                  type: 'link',
                  style: 'secondary',
                  icon_position: 'right',
                  value: view_all_label,
                  href: category.url
                -%}

                {%- assign namespace = category.title | handleize | prepend: 'megamenu-songs-' -%}
                <div class="megamenu__products-search form-search">
                  {%- liquid
                    capture search_input_attr
                      echo 'role="combobox" '
                      echo 'aria-autocomplete="list" '
                      echo 'autocorrect="off" '
                      echo 'autocomplete="off" '
                      echo 'autocapitalize="off" '
                      echo 'spellcheck="false"'
                    endcapture

                    render 'form-search', namespace: namespace, input_attr: search_input_attr, class: 'megamenu__search-form', placeholder: search_placeholder, type: 'product', tag: 'song'
                  -%}
                </div><!-- /.megamenu__products-search -->
              </div><!-- /.megamenu__products-actions -->
            </div><!-- /.megamenu__products -->
          </li><!-- /.megamenu__item -->
        {%- endfor -%}
      </ul><!-- /.megamenu__list -->
    </div><!-- /.megamenu__inner -->
  </header-megamenu><!-- /.megamenu -->
</div><!-- /.header__megamenu -->
