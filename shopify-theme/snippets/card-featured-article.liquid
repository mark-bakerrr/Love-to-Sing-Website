{%- comment -%}
  Accepts:
  - article_ref {Object}: featured Article
  - custom_tag {HTML}: custom HTML for tag
{%- endcomment -%}

{%- if article_ref != blank -%}
  {%- assign read_time = article_ref.metafields.custom.reading_time -%}

  <div class="card-featured-article">
    <div class="card-featured-article__media">
      <div class="media media--16-9 media--transparent">
        {%- liquid
          if article_ref.image != blank
            render 'image', image: article_ref.image
          else
            echo 'image' | placeholder_svg_tag
          endif
        -%}
      </div><!-- /.media media--16-9 -->
    </div><!-- /.card-featured-article__media -->

    <div class="card-featured-article__content">
      <div class="card-featured-article__details">
        {%- if custom_tag != blank -%}
          {{ custom_tag }}
        {%- endif -%}

        {%- if read_time != blank -%}
          <span class="card-featured-article__read-time">
            {{- read_time -}}
          </span><!-- /.card-featured-article__read-time -->
        {%- endif -%}
      </div><!-- /.card-featured-article__details -->

      <h2 class="card-featured-article__title">
        <a href="{{ article_ref.url }}" class="full-unstyled-link link-hover-fade">
          {{- article_ref.title -}}
        </a>
      </h2><!-- /.card-featured-article__title -->

      {%- if article_ref.excerpt != blank -%}
        <div class="card-featured-article__entry">
          {{- article_ref.excerpt -}}
        </div><!-- /.card-featured-article__entry -->
      {%- endif -%}

      <div class="card-featured-article__actions">
        {%- assign button_label = 'blog.read_more' | t -%}
        {%- render 'button',
          type: 'link',
          style: 'text',
          icon_position: 'right',
          value: button_label,
          href: article_ref.url
        -%}
      </div><!-- /.card-featured-article__actions -->
    </div><!-- /.card-featured-article__content -->
  </div><!-- /.card-featured-article -->
{%- endif -%}
