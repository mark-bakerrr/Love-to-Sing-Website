{%- comment -%}
  Accepts:
  - article_ref {Object}: featured Article
  - custom_tag {String}: category label (e.g. "DIY INSTRUMENTS")
{%- endcomment -%}

{%- if article_ref != blank -%}
  {%- assign read_time = article_ref.metafields.custom.reading_time -%}

  <div class="card-featured-article">
    <div class="card-featured-article__media media media--featured media--transparent">
      {%- if article_ref.image != blank -%}
        <img
          srcset="{%- render 'srcset', image: article_ref.image -%}"
          sizes="auto"
          src="{{ article_ref.image | image_url: width: 800 }}"
          loading="eager"
          alt="{{ article_ref.image.alt | escape }}"
          width="{{ article_ref.image.width }}"
          height="{{ article_ref.image.height }}"
        >
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="card-featured-article__content">
      <div class="card-featured-article__details">
        {%- if custom_tag != blank -%}
          <span class="card-featured-article__tag">
            {{- custom_tag -}}
          </span>
        {%- endif -%}

        {%- if read_time != blank -%}
          <span class="card-featured-article__read-time">
            {{- read_time -}}
          </span>
        {%- endif -%}
      </div>

      <h2 class="card-featured-article__title">
        <a href="{{ article_ref.url }}" class="full-unstyled-link link-hover-fade">
          {{- article_ref.title -}}
        </a>
      </h2>

      {%- if article_ref.excerpt != blank -%}
        <div class="card-featured-article__entry">
          {{- article_ref.excerpt -}}
        </div>
      {%- endif -%}

      <div class="card-featured-article__actions">
        <a href="{{ article_ref.url }}" class="card-featured-article__read-link">
          {{- 'blog.read_more' | t -}}
        </a>
      </div>
    </div>
  </div>
{%- endif -%}
