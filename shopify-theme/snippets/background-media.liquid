{%- comment -%}
  Render background media

  Accepts:
  - class {String} - the main class
  - image {Image object} - desktop image.
  - mobile_image {Image object} - mobile image.
  - media_opacity {String} - Opacity of the background media
{%- endcomment -%}

{%- if image != blank -%}
  <div
    class="{{ class }}__background"
    style="opacity: {{ media_opacity | divided_by: 100.0 }};"
  >
    <div class="media media--16-9 {{ class }}__media media--transparent">
      {%- liquid
        assign mobile_image = mobile_image | default: image
        render 'image', image: image, class: 'small-hide'
        render 'image', image: mobile_image, class: 'medium-hide large-up-hide'
      -%}
    </div><!-- /.media -->
  </div><!-- /.hero__background -->
{%- endif -%}
