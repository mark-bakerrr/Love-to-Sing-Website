{%- comment -%}
  Override header, footer, and newsletter colors to match blog/topic color.
  Usage: render 'blog-color-override', override_color: bg_color
  Falls back to theme defaults when override_color is blank.
{%- endcomment -%}

{%- if override_color != blank -%}
  <style>
    .header:before {
      background: {{ override_color }} !important;
    }
    .header {
      --color-header-text: #fff !important;
    }
    .footer {
      --color-footer-background: {{ override_color }} !important;
      --color-footer-text: #fff !important;
    }
    .newsletter {
      --background-bottom: {{ override_color }} !important;
      --text-color: #fff !important;
    }
    .newsletter__wrapper {
      background: radial-gradient({{ override_color }}, color-mix(in srgb, {{ override_color }} 80%, black) 100%) !important;
    }
  </style>
{%- endif -%}
