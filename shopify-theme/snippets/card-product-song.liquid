{%- comment -%}
  Renders a Song product card
  Accepts:
  - product_ref {Object}: Product object
  - class {String}: Additional classes for styling
  - append_text {String}: Append text to
{%- endcomment -%}

{%-
  liquid
  assign product_ref = product_ref | default: false
  assign image = product_ref.featured_image | default: false
  assign class = class
  if product_ref.metafields.custom.main_color != blank
    assign class = class | append: 'main-color-' | append: product_ref.metafields.custom.main_color | downcase
  endif
-%}

{%- if product_ref -%}
  <div
    class="card-product-song {{ class }}"
    {% if product_ref.metafields.custom.main_color != blank %}
      main-color-{{ product_ref.metafields.custom.main_color }}
    {% endif %}
  >
    <a href="{{- product_ref.url -}}" class="card-product-song__link">
      <span class="visually-hidden">{{- product_ref.title | escape -}}</span><!-- /.visually-hidden -->
    </a>

    <div class="card-product-song__media media media--1-1">
      {%-
        liquid
        if product_ref.tags contains 'song'
          render 'icon', icon: 'music-note-single'

        elsif image
          assign image_src = image | image_url: width: 180

          render 'image', image: image, src: image_src, srcset: '', width: 60, height: 60
        else
          render 'icon', icon: 'music-note'
        endif
      -%}
    </div>

    <h6 class="card-product-song__title">
      {{- product_ref.title | append: ' ' | append: append_text -}}
    </h6>
  </div><!-- /.card-product-song -->
{%- endif -%}
