{%- comment -%}

  Use:
  {%- render 'card-review',
    stars: _block.stars,
    content: _block.content,
    image: _block.image,
    author: _block.author,
    position: _block.position
  -%}
{%- endcomment -%}

<div class="card-review">
  <div class="card-review__stars">
    <ul class="list-unstyled">
      {%- for i in (1..5) -%}
        <li class="card-review__star">
          {%- liquid
            if i <= stars
              render 'icon', icon: 'star-fill'
            else
              render 'icon', icon: 'star'
            endif
          -%}
        </li>
      {%- endfor -%}
    </ul>
  </div><!-- /.card-review__stars -->

  {%- if content != blank -%}
    <div class="card-review__content">
      {{ content }}
    </div><!-- /.card-review__content -->
  {%- endif -%}

  <div class="card-review__author">
    {%- if image != blank -%}
      <div class="card-review__image">
        <div class="media">
          {%- render 'image', image: image -%}
        </div><!-- /.media -->
      </div><!-- /.card-review__image -->
    {%- endif -%}

    {%- if author != blank or position != blank -%}
      <div class="card-review__meta">
        {%- if author != blank -%}
          <p>{{ author }}</p>
        {%- endif -%}

        {%- if position != blank -%}
          <span>
            {{ position }}
          </span>
        {%- endif -%}
      </div><!-- /.card-review__meta -->
    {%- endif -%}
  </div><!-- /.card-review__author -->
</div><!-- /.card-review -->
