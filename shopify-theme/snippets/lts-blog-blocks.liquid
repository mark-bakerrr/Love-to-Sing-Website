{% if template.name == 'article' %}
  <link rel="stylesheet" href="{{ 'lts-block-styles.css' | asset_url }}">

  <script>
    (function(){
      var SEL=".article-template__content,.article__content,.article-template__body,[data-article-content],.rte";
      function swap(){
        var root=document.querySelector(SEL);
        if(!root)return;
        var w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
        var re=/\[lts:([a-zA-Z0-9_-]+)\]/g;
        var hits=[];
        while(w.nextNode()){var n=w.currentNode;var m;re.lastIndex=0;
          while((m=re.exec(n.textContent))!==null)hits.push({n:n,f:m[0],id:m[1]});}
        hits.reverse().forEach(function(h){
          var ph=document.createElement("div");
          ph.className="lts-inline-block lts-placeholder";
          ph.setAttribute("data-block-id",h.id);
          var parts=h.n.textContent.split(h.f);
          var before=document.createTextNode(parts[0]);
          var after=document.createTextNode(parts.slice(1).join(h.f));
          h.n.parentNode.insertBefore(before,h.n);
          h.n.parentNode.insertBefore(ph,h.n);
          h.n.parentNode.insertBefore(after,h.n);
          h.n.parentNode.removeChild(h.n);
        });
      }
      swap();
    })();
  </script>

  <script
    src="{{ 'lts-block-renderer.js' | asset_url }}"
    data-supabase-url="{{ shop.metafields.custom.supabase_url.value | default: '' }}"
    data-supabase-key="{{ shop.metafields.custom.supabase_anon_key.value | default: '' }}"
    data-article-id="{{ article.id }}"
    data-header-block="{{ article.metafields.custom.header_block_id.value | default: '' }}"
    data-footer-block="{{ article.metafields.custom.footer_block_id.value | default: '' }}"
    data-sidebar-block="{{ article.metafields.custom.sidebar_block_id.value | default: '' }}"
    defer>
  </script>
{% endif %}
