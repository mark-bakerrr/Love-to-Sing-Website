{%- comment -%}
  Song credits (Design B — micro-label rows), role-per-field model.
  Each role is a product metafield custom.credit_* holding a list of
  `contributor` metaobjects (name + optional link). To add a new role:
  create the custom.credit_<role> product metafield (list of contributors)
  and add one more `render 'song-credit-role'` line below with its phrase.
  Performer is always "Love to Sing"; copyright falls back to the default.
  Accepts: product (defaults to the current product).
{%- endcomment -%}
{%- liquid
  assign _product = product | default: product
  assign copyright_line = _product.metafields.custom.copyright_line
  if copyright_line == blank
    assign copyright_line = '© Love to Sing Limited'
  endif
-%}

<div class="song-credits" id="SongCredits">
  <h3 class="song-about__aside-title">Credits</h3>

  <div class="song-credits__list">
    {%- render 'song-credit-role', people: _product.metafields.custom.credit_writers.value, phrase: 'Written by' -%}
    {%- render 'song-credit-role', people: _product.metafields.custom.credit_composers.value, phrase: 'Composed by' -%}
    {%- render 'song-credit-role', people: _product.metafields.custom.credit_arrangers.value, phrase: 'Arranged by' -%}
    {%- render 'song-credit-role', people: _product.metafields.custom.credit_producers.value, phrase: 'Produced by' -%}

    {%- comment -%} Performer is always Love to Sing {%- endcomment -%}
    <div class="song-credits__row">
      <span class="song-credits__role">Performed by</span>
      <span class="song-credits__who">Love to Sing</span>
    </div>
  </div>

  <p class="song-credits__copyright">{{ copyright_line | escape }}</p>
</div>
