{%- comment -%}
  Renders cart summary

  Accepts:
  - show_cart_link {Boolean} Show the view cart link

  Usage:
  {%- render 'cart-summary' -%}
{%- endcomment -%}

<div class="cart-summary" id="cart-summary">
  <div class="cart-summary__total">
    <strong>{{- 'cart.subtotal' | t -}}: {{ cart.total_price | money_with_currency }}</strong>
  </div><!-- /.cart-summary__total -->

  {%- if cart.cart_level_discount_applications.size > 0 -%}
    <ul class="list-unstyled caption" role="list" aria-label="{{- 'customer.order.discount' | t -}}">
      {%- for discount in cart.cart_level_discount_applications -%}
        <li>
          {{ discount.title }}
          (-{{ discount.total_allocated_amount | money }})
        </li>
      {%- endfor -%}
    </ul><!-- /.list-unstyled caption -->
  {%- endif -%}

  <p>
    <small class="caption color-subdued">
      {{- 'cart.shiping_tax' | t -}}
    </small>
  </p>

  <div class="cart-summary__actions">
    {%-
      liquid
      assign value = 'cart.checkout' | t
      render 'button', type: 'submit', name: 'checkout', value: value, class: 'cart-summary__button'
      if show_cart_link
        assign value = 'cart.view_cart' | t
        render 'button', type: 'link', value: value, class: 'cart-summary__button', style: 'outlined', href: routes.cart_url
      endif
      assign value = nil
    -%}
  </div><!-- /.cart-summary__actions -->
</div><!-- /.cart-summary -->
