{%- comment -%}
  Accepts:
  - namespace {String} - A unique id for the form fields.
  - class? {String} - Selector class
  - button_value {String} - submit button value
  - button_style {String} - submit button style
  Usage:
  {% render 'newsletter-form' %}

{%- endcomment -%}

{%-
  liquid
  assign class = 'contact-form ' | append: class
  assign namespace = namespace | default: ''
  assign form_id = 'contact-form-' | append: namespace
  assign button_value = button_value
  assign value = 'newsletter-form.submit' | t
  assign button_style = button_style
  assign button_icon = button_icon
  assign icon_position = icon_position
-%}

<script src="{{- 'save-email.js' | asset_url -}}" defer></script>

<save-email style="display: contents;">
  {%- form 'customer', class: class, id: form_id -%}
    <input type="hidden" name="contact[tags]" value="newsletter">

    <div class="form-row">
      {%-
        liquid
        assign label = 'newsletter-form.email.label' | t
        assign placeholder = 'newsletter-form.email.placeholder' | t
        capture attr
          echo 'aria-required="true" '
          echo 'autocapitalize="off" '
          echo 'autocomplete="email" '
          if form.errors
            echo 'autofocus '
          endif
        endcapture
        if form.errors
          assign message = form.errors.translated_fields['email'] | capitalize | append: ' ' | append: form.errors.messages['email']
          assign has_error = true
        elsif form.posted_successfully?
          assign message = 'newsletter-form.success' | t
        endif
        assign id = 'NewsletterForm--' | append: section.id
        render 'text-input', id: id, label: label, hide_label: true, type: 'email', name: 'contact[email]', placeholder: placeholder, attr: attr, message: message, has_error: has_error, required: true, value: form.email
      -%}
    </div><!-- /.form-row -->

    <div class="form-row">
      {%-
        liquid
        assign id = 'Subscribe-' | append: section.id
        render 'button', type: 'submit', name: 'commit', id: id, custom_value: button_value, value: value, style: button_style, custom_icon: button_icon, icon_position: icon_position
        assign id = nil
      -%}
    </div><!-- /.form-row -->
  {%- endform -%}
</save-email>
