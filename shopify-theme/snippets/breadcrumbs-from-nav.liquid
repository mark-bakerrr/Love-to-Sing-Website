
{%- if breadcrumbs_menu != blank -%}
  {%- liquid
    assign current_collection = current_collection | default: collection
    assign contains_collection = false
    assign has_current = false
    assign item_current = blank
    assign childlink_current = blank

    for item in breadcrumbs_menu.links
      if item.child_current
        assign contains_collection = true
      endif
    endfor
  -%}

  {%- if current_collection != blank and product != blank -%}
    {%- for item in breadcrumbs_menu.links -%}
      {%- for childlink in item.links -%}
        {%- if childlink.url == current_collection.url -%}
          {%- assign item_current = item -%}
          {%- assign childlink_current = childlink -%}
          {%- assign contains_collection = true -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}

  <ul class="breadcrumbs-from-nav list-unstyled list-flex" role="list">
    <li>
      <a href="{{- routes.root_url -}}" class="inline-unstyled-link link-hover-fade">
        {{- 'general.breadcrumbs.home' | t -}}
      </a>
    </li>

    <li>
      <i>
        {%- render 'icon', icon: 'chevron-right' -%}
      </i>
    </li>

    {%- if contains_collection -%}
      {% # First level %}
      {%- for breadcrumb_item in breadcrumbs_menu.links -%}
        {%- if breadcrumb_item.child_current or breadcrumb_item == item_current -%}
          <li>
            <a href="{{- breadcrumb_item.url -}}" class="inline-unstyled-link link-hover-fade">
              {{- breadcrumb_item.title -}}
            </a>
          </li>

          {%- if breadcrumb_item.child_current or breadcrumb_sublink.current or breadcrumb_item == item_current -%}
            <li>
              <i>
                {%- render 'icon', icon: 'chevron-right' -%}
              </i>
            </li>

            {% # Second level %}
            {%- for breadcrumb_sublink in breadcrumb_item.links -%}
              {%- if breadcrumb_sublink.child_current or breadcrumb_sublink.current or childlink_current.url == breadcrumb_sublink.url -%}
                {% liquid
                  if has_current
                    break
                  endif

                  assign has_current = true
                %}

                <li>
                  <a href="{{- breadcrumb_sublink.url -}}" class="inline-unstyled-link link-hover-fade">
                    {{- breadcrumb_sublink.title -}}
                  </a>
                </li>

                {%- if breadcrumb_sublink.child_current -%}
                  <li>
                    <i>
                      {%- render 'icon', icon: 'chevron-right' -%}
                    </i>
                  </li>

                  {% # Third level %}
                  {%- for breadcrumb_subsublink in breadcrumb_sublink.links -%}
                    {%- if breadcrumb_subsublink.active -%}
                      <li>
                        <span>
                          {{- breadcrumb_subsublink.title -}}
                        </span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if product -%}
                    <li>
                      <span>
                        {{- product.title -}}
                      </span>
                    </li>
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {% if current_collection != blank %}
        <li>
          {%- if product != blank -%}
            <a href="{{- current_collection.url -}}" class="inline-unstyled-link link-hover-fade">
              {{- current_collection.title -}}
            </a>
          {%- else -%}
            <span>
              {{- current_collection.title -}}
            </span>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endif -%}
  </ul>
{%- endif -%}
