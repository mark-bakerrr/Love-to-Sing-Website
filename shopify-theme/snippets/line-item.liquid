{% comment %}
    Renders line item
    Accepts:
    - line_item {Object} Liquid line_item object
    - compact {Boolean} Should the line item be in compact mode - e.g. in the cart-drawer
    Usage:
    {%- render 'line-item', line_item: cart.items[0] -%}
{% endcomment %}

{%-
  liquid
  assign line_item_index = line_item.index | plus: 1
  assign compact = compact | default: false
-%}

<tr class="cart-item" id="CartItem-{{- line_item_index -}}">
  {%- liquid
    assign is_song = false
    if line_item.product.tags contains 'song'
      assign is_song = true
    endif
    assign use_icon = false
    if is_song or line_item.image == blank
      assign use_icon = true
    endif
  -%}
  <td class="cart-item__media{% if use_icon %} cart-item__media--icon{% endif %}">
    <a href="{{- line_item.url -}}" class="cart-item__link">
      <span class="visually-hidden">{{- line_item.title | escape -}}</span>

      {%- if is_song -%}
        {%- comment -%} Songs show the site-wide music-note tile, not the artwork. {%- endcomment -%}
        <div class="cart-item__icon-tile">
          {%- render 'icon', icon: 'music-note-single' -%}
        </div><!-- /.cart-item__icon-tile -->
      {%- elsif line_item.image -%}
        {%- assign media_aspect = '1-1' -%}
        {%- if line_item.product.tags contains 'videos' -%}
          {%- assign media_aspect = '16-9' -%}
        {%- elsif line_item.product.tags contains 'ebook' -%}
          {%- assign media_aspect = 'portrait' -%}
        {%- endif -%}
        <div class="media media--{{ media_aspect }}">
          {%-
            liquid
            assign image_src = line_item.image | image_url: width: 400
            render 'image', image: line_item.image, src: image_src, srcset: '', width: 200, height: 240
          -%}
        </div><!-- /.media -->
      {%- else -%}
        {%- comment -%} Imageless items (licences, memberships): keep the row aligned with a music tile. {%- endcomment -%}
        <div class="cart-item__icon-tile">
          {%- render 'icon', icon: 'music-note' -%}
        </div><!-- /.cart-item__icon-tile -->
      {%- endif -%}
    </a>
  </td><!-- /.cart-item__media -->

  <td class="cart-item__details">
    <h3 class="cart-item__title caption">
      <a href="{{- line_item.url -}}" class="full-unstyled-link">
        {{- line_item.product.title | escape -}}
      </a>
    </h3><!-- /.cart-item__title caption -->

    <div class="cart-item__details-row caption{% unless compact %} large-up-hide{% endunless %}">
      {%- if line_item.original_line_price != line_item.final_line_price -%}
        <div class="cart-item__discounted-prices">
          <span class="visually-hidden">
            {{- 'products.product.price.regular_price' | t -}}
          </span>

          <del>
            {{- line_item.original_line_price | money -}}
          </del>

          <span class="visually-hidden">
            {{- 'products.product.price.sale_price' | t -}}
          </span>

          <strong class="color-red">
            {{- line_item.final_line_price | money -}}
          </strong>
        </div>
      {%- else -%}
        <strong>
          {{- line_item.original_line_price | money -}}
        </strong>
      {%- endif -%}

      {%- if line_item.variant.available and line_item.unit_price_measurement -%}
        <div>
          <span class="visually-hidden">
            {{- 'products.product.price.unit_price' | t -}}
          </span>

          {{- line_item.variant.unit_price | money -}}

          <span aria-hidden="true">/</span>

          {%- if line_item.variant.unit_price_measurement.reference_value != 1 -%}
            {{- line_item.variant.unit_price_measurement.reference_value -}}
          {%- endif -%}

          {{ line_item.variant.unit_price_measurement.reference_unit }}
        </div>
      {%- endif -%}
    </div><!-- /.cart-item__details-row -->

    {%- if line_item.product.has_only_default_variant == false or
      line_item.properties.size != 0 or
      line_item.selling_plan_allocation != nil
    -%}
      <dl>
        {%- if line_item.product.has_only_default_variant == false -%}
          {%- for option in line_item.options_with_values -%}
            <div>
              <dt class="caption">{{- option.name -}}: </dt>

              <dd class="caption bold">
                {{- option.value -}}
                {%- comment -%}
                  Size-band options read as "Band 8" alone — add the attendance/roll range
                  so buyers can sanity-check their band. Ranges mirror license-config.ts
                  SIZE_BANDS; the org type (church/school/community) comes from the hidden
                  _lts_org_type property the licence builder stores (church is the default).
                {%- endcomment -%}
                {%- liquid
                  assign opt_dc = option.name | downcase
                  assign band_range = ''
                  assign band_noun = ''
                  if opt_dc contains 'band'
                    assign band_num = option.value | downcase | remove: 'band' | strip | plus: 0
                    if band_num >= 1 and band_num <= 9
                      assign org_t = line_item.properties['_lts_org_type'] | default: '' | downcase
                      if org_t == 'school'
                        assign band_ranges = '1–30|31–75|76–150|151–250|251–400|401–750|751–1,200|1,201–1,800|1,800+' | split: '|'
                        assign band_noun = 'students'
                      elsif org_t == 'church'
                        assign band_ranges = '1–24|25–49|50–99|100–149|150–199|200–499|500–999|1,000–1,499|1,500+' | split: '|'
                        assign band_noun = 'weekly attendance'
                      else
                        assign band_ranges = '1–24|25–49|50–99|100–149|150–199|200–499|500–999|1,000–1,499|1,500+' | split: '|'
                        if org_t == 'community'
                          assign band_noun = 'attendees'
                        endif
                      endif
                      assign band_index = band_num | minus: 1
                      assign band_range = band_ranges[band_index]
                    endif
                  endif
                -%}
                {%- if band_range != blank -%}
                  <span class="cart-item__band-range">&nbsp;({{ band_range }}{% if band_noun != blank %} {{ band_noun }}{% endif %})</span>
                {%- endif -%}
              </dd>
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- for property in line_item.properties -%}
          {%- assign property_first_char = property.first | slice: 0 -%}
          {%- comment -%} 'Size' carries the attendee range for checkout; the cart already shows it on the Size-band option, so hide it here to avoid duplication. {%- endcomment -%}
          {%- if property.last != blank and property_first_char != '_' and property.first != 'Size' -%}
            {%- liquid
              capture properties_first_placeholders
                echo 'recipient.form.email_property' | t
                echo 'recipient.form.name_property' | t
                echo 'recipient.form.message_property' | t
                echo 'recipient.form.send_on_property' | t
              endcapture

              if properties_first_placeholders contains property.first
                capture prop_classes
                  echo 'class="block"'
                endcapture
              endif
            -%}
            <div {{ prop_classes }}>
              <dt class="caption">{{ property.first }}: </dt>

              <dd class="caption bold">
                {%- if property.last contains '/uploads/' -%}
                  <a href="{{- property.last -}}" class="link" target="_blank">
                    {{- property.last | split: '/' | last -}}
                  </a>
                {%- else -%}
                  {{- property.last -}}
                {%- endif -%}
              </dd>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if line_item.selling_plan_allocation != nil -%}
          <p class="caption">{{- line_item.selling_plan_allocation.selling_plan.name -}}</p>
        {%- endif -%}
      </dl>
    {%- endif -%}

    {%- if line_item.discounts -%}
      <ul class="cart-item__discounts list-unstyled caption caption--small" role="list" aria-label="{{- 'customer.order.discount' | t -}}">
        {%- for discount in line_item.discounts -%}
          <li>
            {%- render 'icon-discount' -%}

            <span>{{- discount.title | escape -}}</span>
          </li>
        {%- endfor -%}
      </ul><!-- /.cart-item__discounts list-unstyled caption caption--small -->
    {%- endif -%}

    <div class="cart-item__details-content{% unless compact %} large-up-hide{% endunless %}">
      <div class="cart-item__details-actions">
        <div class="cart-item__quantity-wrapper">
          {%- render 'quantity-input',
            product_ref: line_item.product,
            value: line_item.quantity,
            name: 'updates[]',
            min: 0,
            index: line_item_index,
            hide_label: true,
            compact: compact,
            context: 'mobile'
          -%}
        </div><!-- /.cart-item__quantity-wrapper -->

        <cart-remove-button
          id="Remove-{{- line_item_index -}}"
          data-index="{{- line_item_index -}}"
        >
          <a
            href="{{- line_item.url_to_remove -}}"
            class="link"
          >
            {{- 'cart.remove' | t -}}
          </a>
        </cart-remove-button>

        <p class="cart-item__error caption color-red" role="alert" data-line-item-error data-line="{{- line_item_index -}}"></p><!-- /.cart-item__error -->
      </div><!-- /.cart-item__details-actions -->
    </div><!-- /.cart-item__details-content -->
  </td><!-- /.cart-item__details -->

  {%- unless compact -%}
    <td class="cart-item__price medium-hide small-hide caption" data-heading="{{- 'cart.price' | t -}}">
      {%- if line_item.original_price != line_item.final_price -%}
        <div class="cart-item__discounted-prices">
          <span class="visually-hidden">
            {{- 'products.product.price.regular_price' | t -}}
          </span>

          <del>
            {{- line_item.original_price | money -}}
          </del>

          <span class="visually-hidden">
            {{- 'products.product.price.sale_price' | t -}}
          </span>

          <strong class="color-red">
            {{- line_item.final_price | money -}}
          </strong>
        </div>
      {%- else -%}
        <strong>
          {{ line_item.original_price | money }}
        </strong>
      {%- endif -%}
    </td><!-- /.cart-item__price -->

    <td class="cart-item__quantity medium-hide small-hide" data-heading="{{- 'cart.quantity' | t -}}">
      <div class="cart-item__quantity-wrapper">
        {%- render 'quantity-input',
          product_ref: line_item.product,
          value: line_item.quantity,
          min: 0,
          index: line_item_index,
          hide_label: true,
          context: 'desktop'
        -%}
      </div><!-- /.cart-item__quantity-wrapper -->

      <cart-remove-button
        id="Remove-{{- line_item_index -}}"
        data-index="{{- line_item_index -}}"
      >
        <a
          href="{{- line_item.url_to_remove -}}"
          class="link"
        >
          {{- 'cart.remove' | t -}}
        </a>
      </cart-remove-button>

      <p class="cart-item__error caption color-red" role="alert" data-line-item-error data-line="{{- line_item_index -}}"></p><!-- /.cart-item__error -->
    </td><!-- /.cart-item__quantity -->

    <td class="cart-item__total medium-hide small-hide caption" data-heading="{{- 'cart.total' | t -}}">
      {%- if line_item.original_line_price != line_item.final_line_price -%}
        <div class="cart-item__discounted-prices">
          <span class="visually-hidden">
            {{- 'products.product.price.regular_price' | t -}}
          </span>

          <del>
            {{- line_item.original_line_price | money -}}
          </del>

          <span class="visually-hidden">
            {{- 'products.product.price.sale_price' | t -}}
          </span>

          <strong class="color-red">
            {{- line_item.final_line_price | money -}}
          </strong>
        </div>
      {%- else -%}
        <strong>
          {{- line_item.original_line_price | money -}}
        </strong>
      {%- endif -%}

      {%- if line_item.variant.available and line_item.unit_price_measurement -%}
        <div>
          <span class="visually-hidden">
            {{- 'products.product.price.unit_price' | t -}}
          </span>

          {{- line_item.variant.unit_price | money -}}

          <span aria-hidden="true">/</span>

          {%- if line_item.variant.unit_price_measurement.reference_value != 1 -%}
            {{- line_item.variant.unit_price_measurement.reference_value -}}
          {%- endif -%}

          {{ line_item.variant.unit_price_measurement.reference_unit }}
        </div>
      {%- endif -%}
    </td><!-- /.cart-item__total -->
  {%- endunless -%}
</tr><!-- /.cart-item -->
