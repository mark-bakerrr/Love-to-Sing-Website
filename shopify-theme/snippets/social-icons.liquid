{%- capture socials_list -%}
social_facebook_link|Facebook,
social_instagram_link|Instagram,
social_twitter_link|Twitter-x,
social_linkedin_link|Linkedin,
social_youtube_link|Youtube,
{%- endcapture -%}
{%- assign socials_list = socials_list | strip_newlines | split: ',' -%}

<ul class="socials list-unstyled {{ classes }}">
  {%- for social_link in socials_list -%}
    {%- liquid
      assign social_link_array = social_link | split: '|'

      assign link = settings[social_link_array.first]
      assign social_name = social_link_array.last
      assign social_ico_name =  social_name | handle
      capture icon
        render 'icon', icon: social_ico_name
      endcapture
    -%}

    {% if link != blank %}
      <li>
        <a
          href="{{ link | escape }}"
          target="_blank"
          title="{{ social_name }}"
        >
          {%- liquid
            if icon != blank
              echo icon
            else
              echo social_name
            endif
          -%}
        </a>
      </li>
    {% endif %}
  {%- endfor -%}
</ul>
