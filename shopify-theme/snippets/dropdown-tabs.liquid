{% comment %}
  Charts.
  Create a tabs with dropdown select.

  Accepts blocks object with settings:
  - collection: {Collection}
  - heading: {String} - The chart heading.
  - filter_label: {String} - Label that will play the role of tab title
  - button_label: {String}
  - button_url: {String}
{% endcomment %}



{%- if blocks.size > 0 -%}
  <dropdown-tabs class="dropdown-tabs">
    {%- assign filter_labels = blocks | map: 'settings' | map: 'filter_label'  -%}

    {%- capture options_html -%}
      {%- for label in filter_labels -%}
        <option value="{{ forloop.index }}">
          {{ label }}
        </option>
      {%- endfor -%}
    {%- endcapture -%}

    {%- capture dropdown -%}
      <div class="dropdown-tabs__actions">
        {%- assign select_label = 'accessibility.select_tab' | t  -%}
        {%- capture select_attr -%}
          dropdown-tabs="action"
        {%- endcapture -%}

        {%- render 'select-input',
          label: select_label,
          name: 'dropdown-tab',
          options: options_html,
          attr: select_attr
        -%}
      </div><!-- /.dropdown-tabs__actions -->
    {%- endcapture -%}

    {%- for block in blocks -%}
      {%- liquid
        assign _block = block.settings
        assign collection = _block.collection
        assign heading = _block.heading
        assign filter_label = _block.filter_label
        assign button_label = _block.button_label
        assign button_url = _block.button_url
      -%}

      {%- if collection != blank and filter_label != blank -%}
        <div
          class="dropdown-tabs__tab{% if forloop.first %} is-active{%- endif -%}"
          dropdown-tabs="tab"
          data-index="{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          <div class="dropdown-tabs__header">
            {%- if heading != blank -%}
              <h2 class="dropdown-tabs__title">
                {{ heading }}
              </h2><!-- /.dropdown-tabs__title -->
            {%- endif -%}

            {{ dropdown }}
          </div><!-- /.dropdown-tabs__header -->

          <div class="dropdown-tabs__content">
            <ul class="list-unstyled dropdown-tabs__list">
              {%- for product_ref in collection.products limit: 10 -%}
                {%- liquid
                  assign media = product_ref.featured_image
                  assign title_index = forloop.index | append: '. '
                  assign title = product_ref.title | prepend: title_index
                  assign tag = product_ref.metafields.custom.chart_tag
                  assign category = product_ref.metafields.custom.chart_category
                  assign views = product_ref.metafields.custom.chart_views
                  assign youtube_channel = product_ref.metafields.details.youtube_channel.value
                -%}

                {%- capture views -%}
                  {%- if views != blank -%}
                    <p class="card-charts__views">
                      <i>
                        {%- render 'icon', icon: 'eye' -%}
                      </i>

                      <span>
                        {{ views }}
                      </span>
                    </p>
                  {%- endif -%}
                {%- endcapture -%}

                <li>
                  <div class="card-chart">
                    <a
                      href="{{ product_ref.url }}"
                      class="card-chart__link"
                      title="{{ title }}"
                    >
                      <span class="visually-hidden">
                        {{ title }}
                      </span><!-- /.visually-hidden -->
                    </a><!-- /.card-chart__link -->

                    <div class="card-chart__media">
                      <div class="media media--16-9">
                        {%- liquid
                          if media != blank
                            render 'image', image: media
                          else
                            echo 'product-image' | placeholder_svg_tag
                          endif
                        -%}
                      </div><!-- /.media -->
                    </div><!-- /.card-chart__media -->

                    <div class="card-chart__content">
                      <div class="card-chart__head">
                        <h6 class="card-chart__title">
                          {{- title -}}
                        </h6><!-- /.card-chart__title -->

                        {%- if tag != blank or views != blank -%}
                          <div class="card-chart__header-details">
                            {%- if tag != blank -%}
                              <span class="tag tag--product tag--sm">
                                {{ tag }}
                              </span><!-- /.tag -->
                            {%- endif -%}

                            {%- if views != blank -%}
                              <div class="medium-hide large-up-hide">
                                {{ views }}
                              </div><!-- /.large-up-hide -->
                            {%- endif -%}
                          </div><!-- /.card-chart__tag -->
                        {%- endif -%}
                      </div><!-- /.card-chart__head -->

                      <div class="card-chart__details">
                        {%- if category != blank -%}
                          <p>{{ category }}</p>
                        {%- endif -%}

                        {%- if youtube_channel != blank -%}
                          <p>{{ youtube_channel.name }}</p>
                        {%- endif -%}

                        {%- if views != blank -%}
                          <div class="small-hide">
                            {{ views }}
                          </div><!-- /.small-hide -->
                        {%- endif -%}
                      </div><!-- /.card-chart__details -->
                    </div><!-- /.card-chart__content -->
                  </div><!-- /.card-chart -->
                </li>
              {%- endfor -%}
            </ul>

            {%- if button_label != blank and button_url != blank -%}
              <div class="dropdown-tabs__link">
                {%- render 'button',
                  type: 'link',
                  style: 'secondary,sm',
                  value: button_label,
                  href: button_url
                -%}
              </div><!-- /.dropdown-tabs__link -->
            {%- endif -%}
          </div><!-- /.dropdown-tabs__content -->
        </div><!-- /.dropdown-tabs__tab -->
      {%- endif -%}
    {%- endfor -%}
  </dropdown-tabs><!-- /.dropdown-tabs -->
{%- endif -%}
