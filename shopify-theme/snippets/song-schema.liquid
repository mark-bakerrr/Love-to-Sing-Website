{%- comment -%}
  Emits MusicRecording + VideoObject JSON-LD for song product templates.
  Rendered from sections/main-song.liquid only — non-song product templates
  (merch, license, album, video_download) keep main-product.liquid's Product schema.

  Optional metafields are emitted only when present:
    - custom.album_product       → MusicAlbum reference
    - custom.duration            → ISO 8601 duration (parsed from "XX mins YY sec(s)")
    - custom.song_release_date   → datePublished
    - custom.isrc_number         → isrcCode
    - shopify['music-genre']     → genre (list metaobject_reference, .label)
    - custom.youtube_main_video  → VideoObject + back-reference from MusicRecording
    - custom.video_views         → VideoObject.interactionStatistic
{%- endcomment -%}
{%- liquid
  assign yt_url = product.metafields.custom.youtube_main_video.value
  assign album = product.metafields.custom.album_product.value
  assign release_date_raw = product.metafields.custom.song_release_date.value
  assign release_date = ''
  if release_date_raw != blank
    assign release_date = release_date_raw | date: '%Y-%m-%d'
  endif
  assign isrc = product.metafields.custom.isrc_number.value
  assign duration_text = product.metafields.custom.duration.value
  assign video_views = product.metafields.custom.video_views.value
  assign genre_list = product.metafields.shopify['music-genre'].value

  assign duration_iso = ''
  if duration_text != blank
    assign duration_parts = duration_text | split: ' '
    assign duration_mins = duration_parts[0] | plus: 0
    assign duration_secs = duration_parts[2] | plus: 0
    if duration_mins > 0 or duration_secs > 0
      assign duration_iso = 'PT' | append: duration_mins | append: 'M' | append: duration_secs | append: 'S'
    endif
  endif

  assign yt_id = ''
  if yt_url contains 'watch?v='
    assign yt_id = yt_url | split: 'watch?v=' | last | split: '&' | first
  elsif yt_url contains 'youtu.be/'
    assign yt_id = yt_url | split: 'youtu.be/' | last | split: '?' | first
  endif

  assign upload_date = ''
  if release_date_raw != blank
    assign upload_date = release_date_raw | date: '%Y-%m-%dT00:00:00Z'
  elsif product.published_at != blank
    assign upload_date = product.published_at | date: '%Y-%m-%dT%H:%M:%S%:z'
  endif

  assign song_url = request.origin | append: product.url
  assign image_src = product.featured_image | image_url: width: 1200 | prepend: 'https:'
  assign video_description = product.description | strip_html | strip
  if video_description == blank
    assign video_description = product.title | append: ' — music video by Love to Sing.'
  endif

  assign artist_id = shop.url | append: '#love-to-sing'
  assign song_id = song_url | append: '#song'
  assign video_id_uri = song_url | append: '#video'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MusicGroup",
      "@id": {{ artist_id | json }},
      "name": "Love to Sing",
      "url": {{ shop.url | json }}
    },
    {
      "@type": "MusicRecording",
      "@id": {{ song_id | json }},
      "name": {{ product.title | json }},
      "url": {{ song_url | json }},
      "image": {{ image_src | json }},
      "byArtist": { "@id": {{ artist_id | json }} }
      {%- if album -%}
        ,"inAlbum": {
          "@type": "MusicAlbum",
          "name": {{ album.title | json }},
          "url": {{ request.origin | append: album.url | json }},
          "byArtist": { "@id": {{ artist_id | json }} }
        }
      {%- endif -%}
      {%- if duration_iso != '' -%}
        ,"duration": {{ duration_iso | json }}
      {%- endif -%}
      {%- if release_date != '' -%}
        ,"datePublished": {{ release_date | json }}
      {%- endif -%}
      {%- if isrc != blank -%}
        ,"isrcCode": {{ isrc | json }}
      {%- endif -%}
      {%- if genre_list.size > 0 -%}
        ,"genre": [
          {%- for g in genre_list -%}
            {%- if g.label != blank -%}
              {{ g.label | json }}{%- unless forloop.last -%},{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      {%- endif -%}
      {%- if yt_id != '' -%}
        ,"video": { "@id": {{ video_id_uri | json }} }
      {%- endif -%}
    }
    {%- if yt_id != '' -%}
      ,{
        "@type": "VideoObject",
        "@id": {{ video_id_uri | json }},
        "name": {{ product.title | json }},
        "description": {{ video_description | json }},
        "thumbnailUrl": {{ image_src | json }},
        {%- if upload_date != '' -%}
          "uploadDate": {{ upload_date | json }},
        {%- endif -%}
        "contentUrl": {{ yt_url | json }},
        "embedUrl": {{ yt_id | prepend: 'https://www.youtube.com/embed/' | json }}
        {%- if video_views != blank -%}
          ,"interactionStatistic": {
            "@type": "InteractionCounter",
            "interactionType": { "@type": "WatchAction" },
            "userInteractionCount": {{ video_views | json }}
          }
        {%- endif -%}
      }
    {%- endif -%}
  ]
}
</script>
