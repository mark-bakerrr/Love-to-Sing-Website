{%- comment -%}
  Renders a predictive search item
  Accepts:
   resource_item {Object}: Search item object - Product/Page/Article
   image {Object}: Image object
   show_image {Bool}: Show image, if no image is given a fallback will be shown, unless this is false
   is_product {Bool}: Is the reource a product, used to render product price
   heading_class {String}: Heading classes. Default is .h6
   class {String}: Addtional classes for styling
  Requires:
   section-header.css
{%- endcomment -%}

{%-
  liquid
  assign resource_item = resource_item | default: false
  assign image = image | default: false
  assign heading_class = heading_class | default: 'h6'
  assign class = class
  if resource_item.metafields.custom.main_color != blank
    assign class = class | append: 'main-color-' | append: resource_item.metafields.custom.main_color | downcase
  endif
-%}

{%- if resource_item -%}
  <div
    class="predictive-search__item {{ class }}"
    {% if resource_item.metafields.custom.main_color != blank %}main-color-{{ resource_item.metafields.custom.main_color }}{% endif %}
  >
    <a href="{{- resource_item.url -}}" class="predictive-search__item-link">
      <span class="visually-hidden">{{- resource_item.title | escape -}}</span><!-- /.visually-hidden -->
    </a>

    {%- if image or show_image -%}
      {%- if show_image -%}
        <div href="{{- resource_item.url -}}" class="media media--1-1">
          {%-
            liquid
            if is_product and resource_item.tags contains 'song'
              render 'icon', icon: 'music-note-single'

            elsif image
              assign image_src = image | image_url: width: 180

              render 'image', image: image, src: image_src, srcset: '', width: 60, height: 60
            else
              render 'icon', icon: 'music-note'
            endif
          -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    <h6 class="{{- heading_class -}}">
      {{- resource_item.title | highlight: predictive_search.terms  -}}
    </h6>

    {%- unless resource_item.tags contains 'song' -%}
      {%- assign search_tag = resource_item.metafields.custom.search_preview_tag -%}

      {%- if search_tag != blank -%}
        <div class="predictive-search__item-tag">
          <span class="tag">{{ search_tag }}</span><!-- /.tag -->
        </div><!-- /.predictive-search__item-tag -->
      {%- endif -%}
    {%- endunless -%}
  </div><!-- /.predictive-search__item -->
{%- endif -%}
