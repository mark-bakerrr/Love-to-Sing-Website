{% comment %}
  Renders share links (Facebook, Twitter, Pinterest, Email)

  Accepts:
  object: {Object} - Article, Product, Collection
{% endcomment %}

{%-
  liquid
  assign share_url = shop.url | append: request.path
  assign share_url_encoded = share_url | url_encode
  assign share_title = object.title | default: product.title | default: page.title | default: collection.title
  assign share_title_encoded = share_title | url_encode
  assign share_image = object.image | image_url: width: 800 | url_encode
  assign mailto_title_prefix = 'See our page: '
  capture mailto_body
    echo share_title | append: '--' | append: share_url
    echo object.content | default: object.description | truncatewords: 20 | strip_html
  endcapture
-%}

<div class="share-icons">
	<ul class="list-unstyled list-flex list-flex--center">
    <li class="share__item">
      <a href="mailto:?subject={{ mailto_title_prefix | append: share_title_encoded }}&amp;body={{ mailto_body | url_encode }}" target="_blank" title="{{- 'share.email_title' | t -}}" aria-label="{{- 'share.email_title' | t -}}" class="full-unstyled-link">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g clip-path="url(#clip0_4149_21429)">
          <path d="M2 5.5L2 3.9934C2 3.44476 2.45531 3 2.9918 3L21.0082 3C21.556 3 22 3.44495 22 3.9934L22 20.0066C22 20.5552 21.5447 21 21.0082 21L2.9918 21C2.44405 21 2 20.5551 2 20.0066V19L20 19L20 7.3L12 14.5L2 5.5ZM0 10H5L5 12H0L0 10ZM0 15L8 15L8 17H0L0 15Z" fill="currentColor"/>
          </g>
          <defs>
          <clipPath id="clip0_4149_21429">
          <rect width="24" height="24" fill="white"/>
          </clipPath>
          </defs>
        </svg>
      </a>
    </li>

    <li class="share__item">
      <a
        href="https://api.whatsapp.com/send?text={{ share_title_encoded }}%20{{ share_url_encoded }}"
        target="_blank"
        rel="noopener noreferrer"
        title="{{- 'share.whatsapp_title' | t -}}"
        aria-label="{{- 'share.whatsapp_title' | t -}}"
        class="full-unstyled-link">
