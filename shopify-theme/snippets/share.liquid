    <li class="share__item">
      <a href="https://twitter.com/intent/tweet/?text={{ share_title_encoded }}&amp;url={{ share_url_encoded }}" target="_blank" title="{{- 'share.twitter_title' | t -}}" aria-label="{{- 'share.twitter_title' | t -}}" class="full-unstyled-link">
