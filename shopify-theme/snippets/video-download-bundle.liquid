{%- doc -%}
  "Bundle and save" offers on a video download page: this video plus each
  sellable sibling video, and this video plus the song MP3 (only when the song
  is downloads_ready in Studio). Each offer is a button that adds every line
  with the `_lts_bundle` / `_lts_bundle_n` properties the Cart Transform and
  bundle Discount Function already understand (same contract as the shop
  drawer's "Add bundle" button). The click handler lives in
  main-video-download.liquid.

  Prices: the saving comes from lts.bundle_discount (written by Studio from the
  song's ACTIVE bundle). Without it the offers still show, at the plain sum,
  and the heading drops the percentage.

  @param {object} product - The video download product being viewed
  @param {object} [siblings] - lts.sibling_videos products
  @param {object} [song] - The linked song product (lts.song)

  @example
  {% render 'video-download-bundle', product: product, siblings: siblings, song: song %}
{%- enddoc -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign pct = product.metafields.lts.bundle_discount.value.percentage | default: 0
  assign group = song.handle | default: product.handle
  assign kind = product.metafields.lts.video_kind.value | default: 'vocal'

  # Rows are captured first so the panel is skipped entirely when none qualify.
  assign offer_count = 0
  capture offers
    for s in siblings
      assign s_variant = s.selected_or_first_available_variant
      unless s.available and s_variant
        continue
      endunless
      unless s.metafields.lts.downloads_ready.value == true or s.metafields.global.edp_0 == '1'
        continue
      endunless

      assign s_kind = s.metafields.lts.video_kind.value | default: 'vocal'
      assign first_key = 'video_download.kind_' | append: kind
      assign second_key = 'video_download.kind_' | append: s_kind
      assign first_label = first_key | t
      assign second_label = second_key | t
      if s_kind == kind
        assign second_label = s.title
      endif

      assign total = variant.price | plus: s_variant.price
      assign saving = total | times: pct | divided_by: 100
      assign discounted = total | minus: saving
      assign variants_csv = variant.id | append: ',' | append: s_variant.id
      assign offer_count = offer_count | plus: 1
      render 'video-download-bundle-offer', label: 'video_download.bundle_both', first: first_label, second: second_label, total: total, discounted: discounted, pct: pct, variants_csv: variants_csv, group: group, count: 2
    endfor

    if song and song.available
      if song.metafields.lts.downloads_ready.value == true
        assign song_variant = song.selected_or_first_available_variant
        if song_variant
          assign total = variant.price | plus: song_variant.price
          assign saving = total | times: pct | divided_by: 100
          assign discounted = total | minus: saving
          assign variants_csv = variant.id | append: ',' | append: song_variant.id
          assign offer_count = offer_count | plus: 1
          render 'video-download-bundle-offer', label: 'video_download.bundle_song', total: total, discounted: discounted, pct: pct, variants_csv: variants_csv, group: group, count: 2
        endif
      endif
    endif
  endcapture
-%}
{%- if offer_count > 0 -%}
  <div class="video-dl__bundle" role="group" aria-labelledby="VideoDlBundle-{{ product.id }}">
    <h2 class="video-dl__bundle-title" id="VideoDlBundle-{{ product.id }}">
      {%- if pct > 0 -%}
        {{- 'video_download.bundle_heading_pct' | t: percentage: pct -}}
      {%- else -%}
        {{- 'video_download.bundle_heading' | t -}}
      {%- endif -%}
    </h2>
    {{ offers }}
  </div>
{%- endif -%}
