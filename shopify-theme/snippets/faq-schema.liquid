{%- comment -%}
  Emits schema.org FAQPage JSON-LD for a faq_group's entries (SEO rich results).
  Usage: {% render 'faq-schema', faq_group: faq_group %}
{%- endcomment -%}
{%- assign faq_entries = faq_group.entries.value -%}
{%- if faq_entries -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for entry in faq_entries -%}
          {
            "@type": "Question",
            "name": {{ entry.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ entry.answer | metafield_tag | strip_html | strip_newlines | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
